// selfhost/parser.flash.zag — self-test for the Flash-written surface parser.
//
// Parses a known surface program with the stage-1 lexer+parser
// (slex.flash.zag + sparse.flash.zag) and checks the resulting statements.

@import("sparse.flash")

// ── self-check ───────────────────────────────────────────────────────────────

fn sp_check(cond: i32, label: []u8) i32 {
    if (cond == 1) { return 0; }
    _zag_print("FAIL selfhost parser: ");
    _zag_println(label);
    return 1;
}

fn main() i32 {
    let sample: []u8 = "program demo\ntrit a = +1\ntrit b = T\nlet trit_add(a, b) = sum\nwave carrier = default\np32 energy = 1.5\nsat_i16 sample = 32000\nraw {\n    fire_shield(0, 0, 0, 2.5);\n    set_laser_mw(0, 0, 3.0);\n}\n";
    let prog: SpProgram = sp_parse_program(sample);

    _zag_print("program=");
    _zag_println(prog.name);
    _zag_print("stmts=");
    _zag_println(_zag_i64_to_str(len[SpStmt](prog.stmts) as i64));

    let bad: i32 = 0;
    bad = bad + sp_check(prog.err == 0, "parse errors");
    bad = bad + sp_check(@strEq(prog.name, "demo"), "program name");
    bad = bad + sp_check(len[SpStmt](prog.stmts) == 7, "statement count");

    let s0: SpStmt = get[SpStmt](prog.stmts, 0);
    bad = bad + sp_check(s0.kind == spk_trit_bind(), "s0 kind");
    bad = bad + sp_check(@strEq(s0.name, "a"), "s0 name");
    bad = bad + sp_check(s0.trit_lit == 1, "s0 trit value");

    let s1: SpStmt = get[SpStmt](prog.stmts, 1);
    bad = bad + sp_check(s1.trit_lit == -1, "s1 trit value (T)");

    let s2: SpStmt = get[SpStmt](prog.stmts, 2);
    bad = bad + sp_check(s2.kind == spk_trit_op(), "s2 kind");
    bad = bad + sp_check(@strEq(s2.op_name, "trit_add"), "s2 op name");
    bad = bad + sp_check(@strEq(s2.op_a, "a"), "s2 op a");
    bad = bad + sp_check(@strEq(s2.op_b, "b"), "s2 op b");
    bad = bad + sp_check(@strEq(s2.op_dst, "sum"), "s2 op dst");

    let s3: SpStmt = get[SpStmt](prog.stmts, 3);
    bad = bad + sp_check(s3.kind == spk_wave_bind(), "s3 kind");
    bad = bad + sp_check(@strEq(s3.name, "carrier"), "s3 name");

    let s4: SpStmt = get[SpStmt](prog.stmts, 4);
    bad = bad + sp_check(s4.kind == spk_p32_bind(), "s4 kind");
    bad = bad + sp_check(@strEq(s4.num_text, "1.5"), "s4 literal");

    let s5: SpStmt = get[SpStmt](prog.stmts, 5);
    bad = bad + sp_check(s5.kind == spk_sat_bind(), "s5 kind");
    bad = bad + sp_check(@strEq(s5.num_text, "32000"), "s5 literal");

    let s6: SpStmt = get[SpStmt](prog.stmts, 6);
    bad = bad + sp_check(s6.kind == spk_raw_block(), "s6 kind");
    bad = bad + sp_check(s6.raw_calls == 2, "s6 raw call count");

    if (bad > 0) {
        _zag_println("selfhost_parser: FAILED");
        return 1;
    }
    _zag_println("selfhost_parser: ok");
    return 0;
}
