// selfhost/std/list.flash — generic growable array ArrayList[T].
//
// Flash stdlib port of zag/zag-poc/std/list.zag. No imports: the shim runtime
// provides _zag_malloc, _zag_realloc, and _zag_free. Selfhost sources
// @import("std/list.flash"); flashc splices it like other *.flash imports so
// ArrayList[T] is emitted into the shim body (no list.zag in the shim header).
//
//   let xs: ArrayList[i32] = make[i32](4);
//   push[i32](&xs, 10);
//   let n: i32 = get[i32](xs, 0);
//   free[i32](&xs);

struct ArrayList[T] {
    data: *T,
    len:  i32,
    cap:  i32,
}

fn make[T](cap: i32) ArrayList[T] {
    let c: i32 = cap;
    if (c < 1) { c = 1; }
    let raw: *i8 = _zag_malloc(c * @sizeOf[T]());
    return ArrayList[T]{ .data = raw as *T, .len = 0, .cap = c };
}

fn push[T](xs: *ArrayList[T], val: T) void {
    if (xs.*.len >= xs.*.cap) {
        let nc: i32 = xs.*.cap * 2;
        if (nc < 4) { nc = 4; }
        xs.*.data = _zag_realloc(xs.*.data as *i8, nc * @sizeOf[T]()) as *T;
        xs.*.cap = nc;
    }
    xs.*.data[xs.*.len] = val;
    xs.*.len = xs.*.len + 1;
}

fn get[T](xs: ArrayList[T], i: i32) T {
    return xs.data[i];
}

fn set[T](xs: *ArrayList[T], i: i32, val: T) void {
    xs.*.data[i] = val;
}

fn pop[T](xs: *ArrayList[T]) T {
    let last: i32 = xs.*.len - 1;
    let v: T = xs.*.data[last];
    xs.*.len = last;
    return v;
}

fn len[T](xs: ArrayList[T]) i32 {
    return xs.len;
}

fn cap[T](xs: ArrayList[T]) i32 {
    return xs.cap;
}

fn is_empty[T](xs: ArrayList[T]) bool {
    return xs.len == 0;
}

fn free[T](xs: *ArrayList[T]) void {
    _zag_free(xs.*.data as *i8);
    xs.*.data = null as *T;
    xs.*.len = 0;
    xs.*.cap = 0;
}