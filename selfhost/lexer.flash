// selfhost/lexer.flash.zag — Flash surface lexer written in Flash.
//
// First self-hosted compiler component: this file is full-language Flash,
// compiled by the stage-0 flashc (written in Zag) via flash_emit_zag. It
// tokenizes an embedded Flash surface program and self-checks the counts,
// proving Flash can express compiler-shaped code (enums, structs, ArrayList,
// switch, string scanning) on the road to a stage-1 flashc written in Flash.

@import("std/list.flash")

enum SKind {
    Word, Num, Punct,
}

struct STok {
    kind: i32,
    lo:   i32,
    hi:   i32,
}

fn skind_code(k: SKind) i32 {
    return switch (k) {
        .Word => 1,
        .Num => 2,
        .Punct => 3,
    };
}

fn s_is_space(c: i32) i32 {
    if (c == 32 || c == 9 || c == 13 || c == 10) { return 1; }
    return 0;
}

fn s_is_digit(c: i32) i32 {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

fn s_is_alpha(c: i32) i32 {
    if (c >= 97 && c <= 122) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c == 95) { return 1; }
    return 0;
}

fn s_is_alnum(c: i32) i32 {
    if (s_is_alpha(c) == 1 || s_is_digit(c) == 1) { return 1; }
    return 0;
}

fn slex(src: []u8) ArrayList[STok] {
    let toks: ArrayList[STok] = make[STok](32);
    let n: i32 = src.len;
    let i: i32 = 0;
    while (i < n) {
        let c: i32 = src[i] as i32;
        if (s_is_space(c) == 1) {
            i = i + 1;
        } else if (s_is_alpha(c) == 1) {
            let start: i32 = i;
            i = i + 1;
            while (i < n && s_is_alnum(src[i] as i32) == 1) { i = i + 1; }
            push[STok](&toks, STok{ .kind = skind_code(SKind.Word), .lo = start, .hi = i });
        } else if (s_is_digit(c) == 1
            || ((c == 43 || c == 45) && i + 1 < n && s_is_digit(src[i + 1] as i32) == 1)) {
            let start: i32 = i;
            i = i + 1;
            while (i < n && s_is_digit(src[i] as i32) == 1) { i = i + 1; }
            push[STok](&toks, STok{ .kind = skind_code(SKind.Num), .lo = start, .hi = i });
        } else {
            push[STok](&toks, STok{ .kind = skind_code(SKind.Punct), .lo = i, .hi = i + 1 });
            i = i + 1;
        }
    }
    return toks;
}

fn count_kind(toks: ArrayList[STok], kind: i32) i32 {
    let count: i32 = 0;
    let i: i32 = 0;
    while (i < len[STok](toks)) {
        if (get[STok](toks, i).kind == kind) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn print_count(label: []u8, v: i32) void {
    _zag_print(label);
    _zag_print("=");
    _zag_println(_zag_i64_to_str(v as i64));
}

fn main() i32 {
    let sample: []u8 = "program demo trit a = +1 trit b = T let trit_add(a, b) = sum";
    let toks: ArrayList[STok] = slex(sample);

    let words: i32 = count_kind(toks, skind_code(SKind.Word));
    let nums: i32 = count_kind(toks, skind_code(SKind.Num));
    let puncts: i32 = count_kind(toks, skind_code(SKind.Punct));

    print_count("words", words);
    print_count("nums", nums);
    print_count("puncts", puncts);
    print_count("total", len[STok](toks));

    if (words != 12) { _zag_println("FAIL selfhost lexer: word count"); return 1; }
    if (nums != 1)   { _zag_println("FAIL selfhost lexer: num count"); return 1; }
    if (puncts != 6) { _zag_println("FAIL selfhost lexer: punct count"); return 1; }

    let first: STok = get[STok](toks, 0);
    let first_text: []u8 = sample[first.lo..first.hi];
    if (@strEq(first_text, "program") == 0) {
        _zag_println("FAIL selfhost lexer: first token");
        return 1;
    }

    _zag_println("selfhost_lexer: ok");
    return 0;
}
