            i = (i + 1);
        } else if (((c == 43) || (c == 45))) {
            if ((((i + 1) < n) && (sf_digit(sf_ch(src, (i + 1))) == 1))) {
                let start: i32 = i;
                i = (i + 1);
                while (((i < n) && (sf_digit(sf_ch(src, i)) == 1))) {
                    i = (i + 1);
                }
                push[SfToken](&out, sf_mk(sfk_int(), src[start..i], line));
            } else if ((c == 43)) {
                push[SfToken](&out, sf_mk(sfk_int(), "+1", line));
                i = (i + 1);
            } else {
                push[SfToken](&out, sf_mk(sfk_ident(), "T", line));
                i = (i + 1);
            }
        } else if ((sf_digit(c) == 1)) {
            let start: i32 = i;
            let is_float: i32 = 0;
            i = (i + 1);
            while (((i < n) && (sf_digit(sf_ch(src, i)) == 1))) {
                i = (i + 1);
            }
            if (((i < n) && (sf_ch(src, i) == 46))) {
                is_float = 1;
                i = (i + 1);
                while (((i < n) && (sf_digit(sf_ch(src, i)) == 1))) {
                    i = (i + 1);
                }
            }
            if ((is_float == 1)) {
                push[SfToken](&out, sf_mk(sfk_float(), src[start..i], line));
            } else {
                push[SfToken](&out, sf_mk(sfk_int(), src[start..i], line));
            }
        } else if ((sf_alpha(c) == 1)) {
            let start: i32 = i;
            i = (i + 1);
            while (((i < n) && (sf_alnum(sf_ch(src, i)) == 1))) {
