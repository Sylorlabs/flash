    st.num_text = lit.text;
    return st;
}

fn sp_parse_raw_call(p: *SParser) SpRawCall {
    let name_tok: SfToken = sp_expect(p, sfk_ident());
    if ((sp_raw_call_known(name_tok.text) == 0)) {
        _zag_print("flashc1 parse error: unknown raw call ");
        _zag_println(name_tok.text);
        p.*.err = 1;
    }
    let _lp: SfToken = sp_expect(p, sfk_lp());
    let args: ArrayList[f32] = make[f32](6);
    let need: i32 = sp_raw_arg_count(name_tok.text);
    let ai: i32 = 0;
    while ((ai < need)) {
        let at: SfToken = sp_advance(p);
        push[f32](&args, sp_parse_float(at));
        if (((ai + 1) < need)) {
            let _c: SfToken = sp_expect(p, sfk_comma());
        }
        ai = (ai + 1);
    }
    let _rp: SfToken = sp_expect(p, sfk_rp());
    sp_skip_semi(p);
    return SpRawCall{ .name = name_tok.text, .args = args };
}

fn sp_parse_raw_block(p: *SParser) SpStmt {
    let hdr: SfToken = sp_peek(p);
    let _lb: SfToken = sp_expect(p, sfk_lbrace());
    let st: SpStmt = sp_mk_stmt(spk_raw_block(), hdr.line);
    while (((sp_peek(p).kind != sfk_rbrace()) && (sp_peek(p).kind != sfk_eof()))) {
        let rc: SpRawCall = sp_parse_raw_call(p);
        push[SpRawCall](&st.raws, rc);
        st.raw_calls = (st.raw_calls + 1);
    }
    let _rb: SfToken = sp_expect(p, sfk_rbrace());
    return st;
}

fn sp_is_mat3_op(name: []u8) i32 {
    if ((name.len < 5)) {
        return 0;
    }
    if ((((((name[0] == 109) && (name[1] == 97)) && (name[2] == 116)) && (name[3] == 51)) && (name[4] == 95))) {
        return 1;
    }
    return 0;
}

fn sp_parse_mat3_op(p: *SParser) SpStmt {
    let op: SfToken = sp_expect(p, sfk_ident());
    let _lp: SfToken = sp_expect(p, sfk_lp());
    let st: SpStmt = sp_mk_stmt(spk_mat3_op(), op.line);
    st.op_name = op.text;
    if (((@strEq(op.text, "mat3_identity") == 1) || (@strEq(op.text, "mat3_rotation_xy_90") == 1))) {
        st.op_argc = 0;
    } else if ((@strEq(op.text, "mat3_mul") == 1)) {
        let a: SfToken = sp_expect(p, sfk_ident());
        st.op_a = a.text;
        let _c1: SfToken = sp_expect(p, sfk_comma());
        let b: SfToken = sp_expect(p, sfk_ident());
        st.op_b = b.text;
        st.op_argc = 2;
    } else if ((@strEq(op.text, "mat3_apply") == 1)) {
        let a: SfToken = sp_expect(p, sfk_ident());
        st.op_a = a.text;
        let _c1: SfToken = sp_expect(p, sfk_comma());
        let b: SfToken = sp_expect(p, sfk_ident());
        st.op_b = b.text;
        let _c2: SfToken = sp_expect(p, sfk_comma());
        let c: SfToken = sp_expect(p, sfk_ident());
        st.op_c = c.text;
        let _c3: SfToken = sp_expect(p, sfk_comma());
        let d: SfToken = sp_expect(p, sfk_ident());
        st.op_d = d.text;
        st.op_argc = 4;
    } else {
        _zag_print("flashc1 parse error: unknown optical op ");
        _zag_println(op.text);
        p.*.err = 1;
    }
    let _rp: SfToken = sp_expect(p, sfk_rp());
    let _e: SfToken = sp_expect(p, sfk_eq());
    let dst: SfToken = sp_expect(p, sfk_ident());
    sp_skip_semi(p);
    st.op_dst = dst.text;
    return st;
}

fn sp_parse_trit_op(p: *SParser) SpStmt {
    if ((sp_is_mat3_op(sp_peek(p).text) == 1)) {
        return sp_parse_mat3_op(p);
    }
    let op: SfToken = sp_expect(p, sfk_ident());
    let _lp: SfToken = sp_expect(p, sfk_lp());
    let a: SfToken = sp_expect(p, sfk_ident());
    let _c: SfToken = sp_expect(p, sfk_comma());
    let b: SfToken = sp_expect(p, sfk_ident());
    let _rp: SfToken = sp_expect(p, sfk_rp());
    let _e: SfToken = sp_expect(p, sfk_eq());
    let dst: SfToken = sp_expect(p, sfk_ident());
    sp_skip_semi(p);
    let st: SpStmt = sp_mk_stmt(spk_trit_op(), op.line);
    st.op_name = op.text;
    st.op_a = a.text;
    st.op_b = b.text;
    st.op_argc = 2;
    st.op_dst = dst.text;
    return st;
}

fn sp_parse_stmt(p: *SParser) SpStmt {
    let t: SfToken = sp_peek(p);
    if ((t.kind == sfk_kw_trit())) {
        let _k: SfToken = sp_advance(p);
        return sp_parse_trit_bind(p);
    }
    if ((t.kind == sfk_kw_wave())) {
        let _k: SfToken = sp_advance(p);
        return sp_parse_wave_bind(p);
    }
    if ((t.kind == sfk_kw_p32())) {
        let _k: SfToken = sp_advance(p);
        return sp_parse_p32_bind(p);
    }
    if ((t.kind == sfk_kw_sat_i16())) {
        let _k: SfToken = sp_advance(p);
        return sp_parse_sat_bind(p);
    }
    if ((t.kind == sfk_kw_raw())) {
        let _k: SfToken = sp_advance(p);
        return sp_parse_raw_block(p);
    }
    if ((t.kind == sfk_kw_optical())) {
        let _k: SfToken = sp_advance(p);
        return sp_parse_mat3_op(p);
    }
    if (((t.kind == sfk_kw_let()) || (t.kind == sfk_ident()))) {
        if ((t.kind == sfk_kw_let())) {
            let _k: SfToken = sp_advance(p);
        }
        return sp_parse_trit_op(p);
    }
    _zag_print("flashc1 parse error: unexpected statement at line ");
    _zag_println(_zag_i64_to_str((t.line) as i64));
    p.*.err = 1;
    let _bad: SfToken = sp_advance(p);
    return sp_mk_stmt(spk_trit_bind(), t.line);
}

fn sp_parse_program(src: []u8) SpProgram {
    let toks: ArrayList[SfToken] = slex_surface(src);
    let p: SParser = SParser{ .toks = toks, .pos = 0, .err = 0 };
    let prog: SpProgram = SpProgram{ .name = "flash_program", .stmts = make[SpStmt](16), .err = 0 };
    if ((sp_peek(&p).kind == sfk_kw_program())) {
        let _k: SfToken = sp_advance(&p);
        let nm: SfToken = sp_advance(&p);
        if (((nm.kind == sfk_ident()) || (nm.kind == sfk_str()))) {
            prog.name = nm.text;
        }
        sp_skip_semi(&p);
    }
    while ((sp_peek(&p).kind != sfk_eof())) {
        if ((sp_peek(&p).kind == sfk_err())) {
            let bad: SfToken = sp_advance(&p);
            _zag_print("flashc1 parse error: invalid character at line ");
            _zag_println(_zag_i64_to_str((bad.line) as i64));
            p.err = 1;
        } else {
            let st: SpStmt = sp_parse_stmt(&p);
            push[SpStmt](&prog.stmts, st);
        }
    }
    prog.err = p.err;
    return prog;
}

fn spv_err(line: i32, msg: []u8) void {
    _zag_print("flashc1 surface error (line ");
    _zag_print(_zag_i64_to_str((line) as i64));
    _zag_print("): ");
    _zag_println(msg);
}

fn spv_has(names: *ArrayList[[]u8], name: []u8) i32 {
    let i: i32 = 0;
    while ((i < len[[]u8](names.*))) {
        if ((@strEq(get[[]u8](names.*, i), name) == 1)) {
            return 1;
        }
        i = (i + 1);
    }
    return 0;
}

fn sp_validate(prog: *SpProgram) i32 {
    let names: ArrayList[[]u8] = make[[]u8](16);
    let trit_names: ArrayList[[]u8] = make[[]u8](16);
    let errs: i32 = 0;
    let i: i32 = 0;
    while ((i < len[SpStmt](prog.*.stmts))) {
        let st: SpStmt = get[SpStmt](prog.*.stmts, i);
        if ((st.kind == spk_trit_bind())) {
            if ((((st.trit_lit != -1) && (st.trit_lit != 0)) && (st.trit_lit != 1))) {
                spv_err(st.line, "invalid trit literal in surface binding");
                errs = (errs + 1);
            }
            if ((spv_has(&names, st.name) == 1)) {
                spv_err(st.line, "duplicate surface binding name");
                errs = (errs + 1);
            } else {
                push[[]u8](&names, st.name);
                push[[]u8](&trit_names, st.name);
            }
        } else if ((((st.kind == spk_wave_bind()) || (st.kind == spk_p32_bind())) || (st.kind == spk_sat_bind()))) {
            if (((st.kind == spk_sat_bind()) && ((st.trit_lit < -32768) || (st.trit_lit > 32767)))) {
                spv_err(st.line, "sat_i16 surface binding out of range");
                errs = (errs + 1);
            }
            if ((spv_has(&names, st.name) == 1)) {
                spv_err(st.line, "duplicate surface binding name");
                errs = (errs + 1);
            } else {
                push[[]u8](&names, st.name);
            }
        } else if ((st.kind == spk_trit_op())) {
            if (((spv_has(&names, st.op_a) == 0) || (spv_has(&names, st.op_b) == 0))) {
                spv_err(st.line, "unknown identifier in surface trit op");
                errs = (errs + 1);
            } else if (((spv_has(&trit_names, st.op_a) == 0) || (spv_has(&trit_names, st.op_b) == 0))) {
                spv_err(st.line, "expected trit binding in surface trit op");
                errs = (errs + 1);
            }
            if ((spv_has(&names, st.op_dst) == 1)) {
                spv_err(st.line, "duplicate surface binding name");
                errs = (errs + 1);
            } else {
                push[[]u8](&names, st.op_dst);
                push[[]u8](&trit_names, st.op_dst);
            }
        } else if ((st.kind == spk_mat3_op())) {
            if ((spv_has(&names, st.op_dst) == 1)) {
                spv_err(st.line, "duplicate surface binding name");
                errs = (errs + 1);
            } else {
                push[[]u8](&names, st.op_dst);
            }
        }
        i = (i + 1);
    }
    return errs;
}

fn CHAMBER_SIZE_MM() i32 {
    return 30;
}

fn NANO_VOXELS_EDGE() i32 {
    return 8;
}

fn TRIT_NEG() i32 {
    return -1;
}

fn TRIT_ZERO() i32 {
    return 0;
}

fn TRIT_POS() i32 {
    return 1;
}

enum RotationState {
    R0, R90, R180, R270,
}

enum LaserAxis {
    Vertical, HorizontalX, HorizontalY,
}

enum GridTrit {
    Neg, Zero, Pos,
}

struct ChamberCoord {
    x: i32,
    y: i32,
    z: i32,
}

struct VoxelLocal {
    x: i32,
    y: i32,
    z: i32,
}

struct VoxelGlobal {
    chamber: ChamberCoord,
    local: VoxelLocal,
}

struct ChamberDims {
    width: i32,
    height: i32,
    depth: i32,
}

struct ChamberCell {
    coord: ChamberCoord,
    rotation: RotationState,
    occupied: i32,
}

struct LatticeGrid {
    cells: *ChamberCell,
    dims: ChamberDims,
    count: i32,
}

fn grid_trit_from_i32(v: i32) GridTrit {
    if ((v < 0)) {
        return GridTrit.Neg;
    }
    if ((v > 0)) {
        return GridTrit.Pos;
    }
    return GridTrit.Zero;
}

fn grid_trit_to_i32(t: GridTrit) i32 {
    if ((t == GridTrit.Neg)) {
        return TRIT_NEG();
    }
    if ((t == GridTrit.Pos)) {
        return TRIT_POS();
    }
    return TRIT_ZERO();
}

fn grid_trit_valid(v: i32) bool {
    return (((v == TRIT_NEG()) || (v == TRIT_ZERO())) || (v == TRIT_POS()));
}

fn rotation_to_deg(r: RotationState) i32 {
    if ((r == RotationState.R90)) {
        return 90;
    }
    if ((r == RotationState.R180)) {
        return 180;
    }
    if ((r == RotationState.R270)) {
        return 270;
    }
    return 0;
}

fn rotation_from_deg(deg: i32) RotationState {
    if ((deg == 90)) {
        return RotationState.R90;
    }
    if ((deg == 180)) {
        return RotationState.R180;
    }
    if ((deg == 270)) {
        return RotationState.R270;
    }
    return RotationState.R0;
}

fn rotation_next(r: RotationState) RotationState {
    if ((r == RotationState.R0)) {
        return RotationState.R90;
    }
    if ((r == RotationState.R90)) {
        return RotationState.R180;
    }
    if ((r == RotationState.R180)) {
        return RotationState.R270;
    }
    return RotationState.R0;
}

fn chamber_coord(x: i32, y: i32, z: i32) ChamberCoord {
    return ChamberCoord{ .x = x, .y = y, .z = z };
}

fn voxel_local(x: i32, y: i32, z: i32) VoxelLocal {
    return VoxelLocal{ .x = x, .y = y, .z = z };
}

fn chamber_in_bounds(dims: ChamberDims, c: ChamberCoord) bool {
    return ((((((c.x >= 0) && (c.x < dims.width)) && (c.y >= 0)) && (c.y < dims.height)) && (c.z >= 0)) && (c.z < dims.depth));
}

fn voxel_in_bounds(v: VoxelLocal) bool {
    let e: i32 = NANO_VOXELS_EDGE();
    return ((((((v.x >= 0) && (v.x < e)) && (v.y >= 0)) && (v.y < e)) && (v.z >= 0)) && (v.z < e));
}

fn chamber_linear_index(dims: ChamberDims, c: ChamberCoord) i32 {
    return ((((c.z * dims.width) * dims.height) + (c.y * dims.width)) + c.x);
}

fn chamber_from_linear(dims: ChamberDims, idx: i32) ChamberCoord {
    let plane: i32 = (dims.width * dims.height);
    let z: i32 = (idx / plane);
    let rem: i32 = (idx - (z * plane));
    let y: i32 = (rem / dims.width);
    let x: i32 = (rem - (y * dims.width));
    return ChamberCoord{ .x = x, .y = y, .z = z };
}

fn lattice_new(width: i32, height: i32, depth: i32) LatticeGrid {
    let w: i32 = width;
    let h: i32 = height;
    let d: i32 = depth;
    if ((w < 1)) {
        w = 1;
    }
    if ((h < 1)) {
        h = 1;
    }
    if ((d < 1)) {
        d = 1;
    }
    let count: i32 = ((w * h) * d);
    let raw: *i8 = _zag_malloc((count * @sizeOf[ChamberCell]()));
    let cells: *ChamberCell = (raw) as *ChamberCell;
    let i: i32 = 0;
    while ((i < count)) {
        let c: ChamberCoord = chamber_from_linear(ChamberDims{ .width = w, .height = h, .depth = d }, i);
        cells[i] = ChamberCell{ .coord = c, .rotation = RotationState.R0, .occupied = 0 };
        i = (i + 1);
    }
    return LatticeGrid{ .cells = cells, .dims = ChamberDims{ .width = w, .height = h, .depth = d }, .count = count };
}

fn lattice_free(g: *LatticeGrid) void {
    _zag_free((g.*.cells) as *i8);
    g.*.cells = (null) as *ChamberCell;
    g.*.count = 0;
}

fn lattice_get(g: LatticeGrid, c: ChamberCoord) ?ChamberCell {
    if (!(chamber_in_bounds(g.dims, c))) {
        return null;
    }
    let idx: i32 = chamber_linear_index(g.dims, c);
    return g.cells[idx];
}

fn lattice_get_mut(g: *LatticeGrid, c: ChamberCoord) ?*ChamberCell {
    if (!(chamber_in_bounds(g.*.dims, c))) {
        return null;
    }
    let idx: i32 = chamber_linear_index(g.*.dims, c);
    return &g.*.cells[idx];
}

fn set_chamber_rotation(g: *LatticeGrid, c: ChamberCoord, rot: RotationState) i32 {
    if (lattice_get_mut(g, c)) |cell| {
        cell.*.rotation = rot;
        return 1;
    }
    return 0;
}

fn set_chamber_occupied(g: *LatticeGrid, c: ChamberCoord, occupied: i32) i32 {
    if (lattice_get_mut(g, c)) |cell| {
        cell.*.occupied = occupied;
        return 1;
    }
    return 0;
}

fn voxel_global_linear(g: LatticeGrid, v: VoxelGlobal) i32 {
    let edge: i32 = NANO_VOXELS_EDGE();
    let cidx: i32 = chamber_linear_index(g.dims, v.chamber);
    let local: i32 = ((((v.local.z * edge) * edge) + (v.local.y * edge)) + v.local.x);
    return ((((cidx * edge) * edge) * edge) + local);
}

fn voxel_global_from_linear(g: LatticeGrid, linear: i32) VoxelGlobal {
    let edge: i32 = NANO_VOXELS_EDGE();
    let voxels_per_chamber: i32 = ((edge * edge) * edge);
    let cidx: i32 = (linear / voxels_per_chamber);
    let rem: i32 = (linear - (cidx * voxels_per_chamber));
    let lz: i32 = (rem / (edge * edge));
    let rem2: i32 = (rem - ((lz * edge) * edge));
    let ly: i32 = (rem2 / edge);
    let lx: i32 = (rem2 - (ly * edge));
    return VoxelGlobal{ .chamber = chamber_from_linear(g.dims, cidx), .local = voxel_local(lx, ly, lz) };
}

fn voxel_mm_offset(g: LatticeGrid, v: VoxelGlobal) ChamberCoord {
    let chamber_mm: i32 = CHAMBER_SIZE_MM();
    let edge: i32 = NANO_VOXELS_EDGE();
    let voxel_mm: i32 = (chamber_mm / edge);
    return ChamberCoord{ .x = ((v.chamber.x * chamber_mm) + (v.local.x * voxel_mm)), .y = ((v.chamber.y * chamber_mm) + (v.local.y * voxel_mm)), .z = ((v.chamber.z * chamber_mm) + (v.local.z * voxel_mm)) };
}

fn lattice_voxel_capacity(g: LatticeGrid) i32 {
    let edge: i32 = NANO_VOXELS_EDGE();
    return (((g.count * edge) * edge) * edge);
}

struct OrientationMarkers {
    wall_pos_x: i32,
    wall_pos_y: i32,
    floor: i32,
    ceiling: i32,
}

fn marker_signature(m: OrientationMarkers) i32 {
    let s: i32 = 0;
    if ((m.wall_pos_x > 0)) {
        s = (s + 1);
    }
    if ((m.wall_pos_y > 0)) {
        s = (s + 2);
    }
    if ((m.floor > 0)) {
        s = (s + 4);
    }
    if ((m.ceiling > 0)) {
        s = (s + 8);
    }
    return s;
}

fn expected_signature(rot: RotationState) i32 {
    if ((rot == RotationState.R90)) {
        return 6;
    }
    if ((rot == RotationState.R180)) {
        return 10;
    }
    if ((rot == RotationState.R270)) {
        return 9;
    }
    return 5;
}

fn detect_rotation_from_markers(m: OrientationMarkers) RotationState {
    let sig: i32 = marker_signature(m);
    if ((sig == expected_signature(RotationState.R90))) {
        return RotationState.R90;
    }
    if ((sig == expected_signature(RotationState.R180))) {
        return RotationState.R180;
    }
    if ((sig == expected_signature(RotationState.R270))) {
        return RotationState.R270;
    }
    return RotationState.R0;
}

fn rotation_mismatch(m: OrientationMarkers, expected: RotationState) i32 {
    let observed: RotationState = detect_rotation_from_markers(m);
    if ((observed == expected)) {
        return 0;
    }
    return 1;
}

fn remap_voxel_local(v: VoxelLocal, rot: RotationState) VoxelLocal {
    let e: i32 = NANO_VOXELS_EDGE();
    let max_i: i32 = (e - 1);
    if ((rot == RotationState.R90)) {
        return voxel_local(v.y, (max_i - v.x), v.z);
    }
    if ((rot == RotationState.R180)) {
        return voxel_local((max_i - v.x), (max_i - v.y), v.z);
    }
    if ((rot == RotationState.R270)) {
        return voxel_local((max_i - v.y), v.x, v.z);
    }
    return v;
}

fn inverse_remap_voxel_local(v: VoxelLocal, rot: RotationState) VoxelLocal {
    return remap_voxel_local(v, invert_rotation(rot));
}

fn invert_rotation(rot: RotationState) RotationState {
    if ((rot == RotationState.R90)) {
        return RotationState.R270;
    }
    if ((rot == RotationState.R270)) {
        return RotationState.R90;
    }
    if ((rot == RotationState.R180)) {
        return RotationState.R180;
    }
    return RotationState.R0;
}

fn remap_laser_axis(axis: LaserAxis, rot: RotationState) LaserAxis {
    if ((axis == LaserAxis.Vertical)) {
        return LaserAxis.Vertical;
    }
    if (((rot == RotationState.R0) || (rot == RotationState.R180))) {
        return axis;
    }
    if ((axis == LaserAxis.HorizontalX)) {
        return LaserAxis.HorizontalY;
    }
    if ((axis == LaserAxis.HorizontalY)) {
        return LaserAxis.HorizontalX;
    }
    return axis;
}

fn remap_path_coord(coord: i32, axis: LaserAxis, rot: RotationState) i32 {
    let e: i32 = NANO_VOXELS_EDGE();
    let max_i: i32 = (e - 1);
    if ((axis == LaserAxis.Vertical)) {
        return coord;
    }
    if (((rot == RotationState.R90) || (rot == RotationState.R180))) {
        return (max_i - coord);
    }
    return coord;
}

fn remap_voxel_global(v: VoxelGlobal, rot: RotationState) VoxelGlobal {
    return VoxelGlobal{ .chamber = v.chamber, .local = remap_voxel_local(v.local, rot) };
}

fn compose_rotation(a: RotationState, b: RotationState) RotationState {
    let deg_a: i32 = rotation_to_deg(a);
    let deg_b: i32 = rotation_to_deg(b);
    let sum: i32 = ((deg_a + deg_b) % 360);
    return rotation_from_deg(sum);
}

struct StripeLane {
    chamber: ChamberCoord,
    lane_id: i32,
}

struct PhysicalAddress {
    chamber: ChamberCoord,
    voxel: VoxelLocal,
    lane: i32,
    rot: RotationState,
}

struct StripePool {
    lanes: *StripeLane,
    lane_count: i32,
    stripe_width: i32,
    total_bytes: i32,
    grid_dims: ChamberDims,
}

fn pool_new(g: *LatticeGrid, stripe_width: i32) StripePool {
    let w: i32 = stripe_width;
    if ((w < 1)) {
        w = 1;
    }
    let occupied: ArrayList[ChamberCoord] = make[ChamberCoord](g.*.count);
    let i: i32 = 0;
    while ((i < g.*.count)) {
        if ((g.*.cells[i].occupied == 1)) {
            push[ChamberCoord](&occupied, g.*.cells[i].coord);
        }
        i = (i + 1);
    }
    let lane_count: i32 = (occupied.len * w);
    let lanes: *StripeLane = (null) as *StripeLane;
    if ((lane_count > 0)) {
        let raw: *i8 = _zag_malloc((lane_count * @sizeOf[StripeLane]()));
        lanes = (raw) as *StripeLane;
        let li: i32 = 0;
        let ci: i32 = 0;
        while ((ci < occupied.len)) {
            let c: ChamberCoord = get[ChamberCoord](occupied, ci);
            let lane: i32 = 0;
            while ((lane < w)) {
                lanes[li] = StripeLane{ .chamber = c, .lane_id = lane };
                li = (li + 1);
                lane = (lane + 1);
            }
            ci = (ci + 1);
        }
    }
    free[ChamberCoord](&occupied);
    return StripePool{ .lanes = lanes, .lane_count = lane_count, .stripe_width = w, .total_bytes = 0, .grid_dims = g.*.dims };
}

fn pool_free(p: *StripePool) void {
    if ((p.*.lanes != null)) {
        _zag_free((p.*.lanes) as *i8);
    }
    p.*.lanes = (null) as *StripeLane;
    p.*.lane_count = 0;
    p.*.total_bytes = 0;
}

fn pool_set_total_bytes(p: *StripePool, nbytes: i32) void {
    if ((nbytes < 0)) {
        p.*.total_bytes = 0;
        return;
    }
    p.*.total_bytes = nbytes;
}

fn pool_lane_count(p: StripePool) i32 {
    return p.lane_count;
}

fn pool_capacity_bytes(p: StripePool) i32 {
    if ((p.lane_count == 0)) {
        return 0;
    }
    return (((p.lane_count * NANO_VOXELS_EDGE()) * NANO_VOXELS_EDGE()) * NANO_VOXELS_EDGE());
}

fn logical_offset_in_range(p: StripePool, byte_offset: i32) i32 {
    if ((p.lane_count == 0)) {
        return 0;
    }
    if ((byte_offset < 0)) {
        return 0;
    }
    if ((byte_offset >= pool_capacity_bytes(p))) {
        return 0;
    }
    return 1;
}

fn lane_at(p: StripePool, lane_index: i32) ?StripeLane {
    if (((lane_index < 0) || (lane_index >= p.lane_count))) {
        return null;
    }
    return p.lanes[lane_index];
}

fn logical_to_physical(p: StripePool, g: LatticeGrid, byte_offset: i32) ?PhysicalAddress {
    if ((p.lane_count == 0)) {
        return null;
    }
    if ((byte_offset < 0)) {
        return null;
    }
    let cap: i32 = pool_capacity_bytes(p);
    if ((byte_offset >= cap)) {
        return null;
    }
    let lane_idx: i32 = (byte_offset % p.lane_count);
    let cycle: i32 = (byte_offset / p.lane_count);
    if (lane_at(p, lane_idx)) |lane| {
        let edge: i32 = NANO_VOXELS_EDGE();
        let voxels_per_chamber: i32 = ((edge * edge) * edge);
        if ((cycle >= voxels_per_chamber)) {
            return null;
        }
        let lz: i32 = (cycle / (edge * edge));
        let rem: i32 = (cycle - ((lz * edge) * edge));
        let ly: i32 = (rem / edge);
        let lx: i32 = (rem - (ly * edge));
        let local: VoxelLocal = voxel_local(lx, ly, lz);
        let rot: RotationState = RotationState.R0;
        if (lattice_get(g, lane.chamber)) |cell| {
            rot = cell.rotation;
        }
        let mapped: VoxelLocal = remap_voxel_local(local, rot);
        return PhysicalAddress{ .chamber = lane.chamber, .voxel = mapped, .lane = lane.lane_id, .rot = rot };
    }
    return null;
}

fn physical_to_logical(p: StripePool, addr: PhysicalAddress) i32 {
    if ((p.lane_count == 0)) {
        return -1;
    }
    let edge: i32 = NANO_VOXELS_EDGE();
    let unmapped: VoxelLocal = inverse_remap_voxel_local(addr.voxel, addr.rot);
    let cycle: i32 = ((((unmapped.z * edge) * edge) + (unmapped.y * edge)) + unmapped.x);
    let i: i32 = 0;
    while ((i < p.lane_count)) {
        let lane: StripeLane = p.lanes[i];
        if (((((lane.chamber.x == addr.chamber.x) && (lane.chamber.y == addr.chamber.y)) && (lane.chamber.z == addr.chamber.z)) && (lane.lane_id == addr.lane))) {
            return ((cycle * p.lane_count) + i);
        }
        i = (i + 1);
    }
    return -1;
}

struct StripeWriteResult {
    bytes_written: i32,
    cycles_used: i32,
}

fn stripe_write_cycle(p: *StripePool, g: *LatticeGrid, data: *i8, data_len: i32, base_offset: i32, out_buf: *i8, out_cap: i32) StripeWriteResult {
    let written: i32 = 0;
    let cycles: i32 = 0;
    if ((p.*.lane_count == 0)) {
        return StripeWriteResult{ .bytes_written = 0, .cycles_used = 0 };
    }
    let i: i32 = 0;
    let go: i32 = 1;
    while (((go == 1) && (i < p.*.lane_count))) {
        let logical: i32 = (base_offset + i);
        if ((logical >= data_len)) {
            go = 0;
        } else if (logical_to_physical(p.*, g.*, logical)) |phys| {
            let tv: i32 = (data[logical]) as i32;
            if (!(grid_trit_valid(tv))) {
                tv = TRIT_ZERO();
            }
            if ((written < out_cap)) {
                out_buf[written] = (tv) as i8;
                written = (written + 1);
            }
            if ((phys.lane < 0)) {
                go = 0;
            }
        } else {
            go = 0;
        }
        if ((go == 1)) {
            i = (i + 1);
        }
    }
    if ((p.*.lane_count > 0)) {
        cycles = 1;
    }
    p.*.total_bytes = (p.*.total_bytes + written);
    return StripeWriteResult{ .bytes_written = written, .cycles_used = cycles };
}

fn chambers_in_lane_group(p: StripePool, lane_id: i32) ArrayList[ChamberCoord] {
    let xs: ArrayList[ChamberCoord] = make[ChamberCoord](4);
    let i: i32 = 0;
    while ((i < p.lane_count)) {
        let lane: StripeLane = p.lanes[i];
        if ((lane.lane_id == lane_id)) {
            push[ChamberCoord](&xs, lane.chamber);
        }
        i = (i + 1);
    }
    return xs;
}

struct CoordinateManifestEntry {
    chamber: ChamberCoord,
    rotation_deg: i32,
    occupied: i32,
    lane_id: i32,
    voxel: VoxelLocal,
    laser_axis: LaserAxis,
    mm_x: i32,
    mm_y: i32,
    mm_z: i32,
}

struct HardwareManager {
    lattice: LatticeGrid,
    stripe_pool: StripePool,
    stripe_width: i32,
}

fn manager_new(width: i32, height: i32, depth: i32, stripe_width: i32) HardwareManager {
    let g: LatticeGrid = lattice_new(width, height, depth);
    let gp: *LatticeGrid = &g;
    let sp: StripePool = pool_new(gp, stripe_width);
    return HardwareManager{ .lattice = g, .stripe_pool = sp, .stripe_width = stripe_width };
}

fn manager_free(m: *HardwareManager) void {
    pool_free(&m.*.stripe_pool);
    lattice_free(&m.*.lattice);
}

fn manager_rebuild_pool(m: *HardwareManager) void {
    pool_free(&m.*.stripe_pool);
    m.*.stripe_pool = pool_new(&m.*.lattice, m.*.stripe_width);
}

fn seat_nano_block(m: *HardwareManager, c: ChamberCoord, rot: RotationState) i32 {
    let ok: i32 = set_chamber_occupied(&m.*.lattice, c, 1);
    if ((ok == 0)) {
        return 0;
    }
    set_chamber_rotation(&m.*.lattice, c, rot);
    manager_rebuild_pool(m);
    return 1;
}

fn remove_nano_block(m: *HardwareManager, c: ChamberCoord) i32 {
    let ok: i32 = set_chamber_occupied(&m.*.lattice, c, 0);
    if ((ok == 0)) {
        return 0;
    }
    set_chamber_rotation(&m.*.lattice, c, RotationState.R0);
    manager_rebuild_pool(m);
    return 1;
}

fn auto_detect_rotation(m: *HardwareManager, c: ChamberCoord, markers: OrientationMarkers) RotationState {
    let detected: RotationState = detect_rotation_from_markers(markers);
    set_chamber_rotation(&m.*.lattice, c, detected);
    return detected;
}

fn auto_detect_all(m: *HardwareManager, markers: *OrientationMarkers) i32 {
    let updated: i32 = 0;
    let i: i32 = 0;
    while ((i < m.*.lattice.count)) {
        if ((m.*.lattice.cells[i].occupied == 1)) {
            let c: ChamberCoord = m.*.lattice.cells[i].coord;
            let rot: RotationState = auto_detect_rotation(m, c, markers[i]);
            m.*.lattice.cells[i].rotation = rot;
            updated = (updated + 1);
        }
        i = (i + 1);
    }
    manager_rebuild_pool(m);
    return updated;
}

fn parallel_stripe_write(m: *HardwareManager, data: *i8, data_len: i32, base_offset: i32, scratch: *i8, scratch_cap: i32) StripeWriteResult {
    return stripe_write_cycle(&m.*.stripe_pool, &m.*.lattice, data, data_len, base_offset, scratch, scratch_cap);
}

fn resolve_logical_address(m: HardwareManager, byte_offset: i32) ?PhysicalAddress {
    return logical_to_physical(m.stripe_pool, m.lattice, byte_offset);
}

fn manifest_entry_for_address(m: HardwareManager, addr: PhysicalAddress) CoordinateManifestEntry {
    let global: VoxelGlobal = VoxelGlobal{ .chamber = addr.chamber, .local = addr.voxel };
    let mm: ChamberCoord = voxel_mm_offset(m.lattice, global);
    return CoordinateManifestEntry{ .chamber = addr.chamber, .rotation_deg = rotation_to_deg(addr.rot), .occupied = 1, .lane_id = addr.lane, .voxel = addr.voxel, .laser_axis = LaserAxis.Vertical, .mm_x = mm.x, .mm_y = mm.y, .mm_z = mm.z };
}

fn emit_coordinate_manifest(m: *HardwareManager, out: *ArrayList[CoordinateManifestEntry]) i32 {
    let emitted: i32 = 0;
    let i: i32 = 0;
    while ((i < m.*.lattice.count)) {
        let cell: ChamberCell = m.*.lattice.cells[i];
        if ((cell.occupied != 0)) {
            let edge: i32 = NANO_VOXELS_EDGE();
            let lz: i32 = 0;
            while ((lz < edge)) {
                let ly: i32 = 0;
                while ((ly < edge)) {
                    let lx: i32 = 0;
                    while ((lx < edge)) {
                        let local: VoxelLocal = voxel_local(lx, ly, lz);
                        let mapped: VoxelLocal = remap_voxel_local(local, cell.rotation);
                        let global: VoxelGlobal = VoxelGlobal{ .chamber = cell.coord, .local = mapped };
                        let mm: ChamberCoord = voxel_mm_offset(m.*.lattice, global);
                        let entry: CoordinateManifestEntry = CoordinateManifestEntry{ .chamber = cell.coord, .rotation_deg = rotation_to_deg(cell.rotation), .occupied = 1, .lane_id = 0, .voxel = mapped, .laser_axis = remap_laser_axis(LaserAxis.Vertical, cell.rotation), .mm_x = mm.x, .mm_y = mm.y, .mm_z = mm.z };
                        push[CoordinateManifestEntry](out, entry);
                        emitted = (emitted + 1);
                        lx = (lx + 1);
                    }
                    ly = (ly + 1);
                }
                lz = (lz + 1);
            }
        }
        i = (i + 1);
    }
    return emitted;
}

fn emit_stripe_manifest(m: *HardwareManager, out: *ArrayList[CoordinateManifestEntry], max_entries: i32) i32 {
    let emitted: i32 = 0;
    let limit: i32 = max_entries;
    if ((limit < 1)) {
        limit = m.*.stripe_pool.lane_count;
    }
    let i: i32 = 0;
    while (((i < limit) && (i < m.*.stripe_pool.lane_count))) {
        if (logical_to_physical(m.*.stripe_pool, m.*.lattice, i)) |phys| {
            let entry: CoordinateManifestEntry = manifest_entry_for_address(m.*, phys);
            push[CoordinateManifestEntry](out, entry);
            emitted = (emitted + 1);
        }
        i = (i + 1);
    }
    return emitted;
}

struct HardwareSummary {
    chambers: i32,
    occupied: i32,
    stripe_lanes: i32,
    voxel_capacity: i32,
    pool_capacity: i32,
}

fn manager_summary(m: HardwareManager) HardwareSummary {
    let occ: i32 = 0;
    let i: i32 = 0;
    while ((i < m.lattice.count)) {
        if ((m.lattice.cells[i].occupied == 1)) {
            occ = (occ + 1);
        }
        i = (i + 1);
    }
    return HardwareSummary{ .chambers = m.lattice.count, .occupied = occ, .stripe_lanes = m.stripe_pool.lane_count, .voxel_capacity = lattice_voxel_capacity(m.lattice), .pool_capacity = pool_capacity_bytes(m.stripe_pool) };
}

struct Coord {
    x: f32,
    y: f32,
    z: f32,
}

struct PathSegment {
    from: Coord,
    to: Coord,
    laser_power_mw: f32,
    polarization: i32,
    op_tag: []u8,
}

struct CoordinateManifest {
    name: []u8,
    version: []u8,
    segments: ArrayList[PathSegment],
    peak_power_mw: f32,
    dominant_pol: i32,
}

fn coord(x: f32, y: f32, z: f32) Coord {
    return Coord{ .x = x, .y = y, .z = z };
}

fn manifest_new(name: []u8, version: []u8) CoordinateManifest {
    return CoordinateManifest{ .name = name, .version = version, .segments = make[PathSegment](8), .peak_power_mw = 0.0, .dominant_pol = 0 };
}

fn manifest_push_seg(m: *CoordinateManifest, seg: PathSegment) void {
    push[PathSegment](&m.*.segments, seg);
    if ((seg.laser_power_mw > m.*.peak_power_mw)) {
        m.*.peak_power_mw = seg.laser_power_mw;
    }
}

fn manifest_set_pol(m: *CoordinateManifest, pol: i32) void {
    m.*.dominant_pol = pol;
}

fn manifest_write(m: *CoordinateManifest) []u8 {
    let out: ArrayList[u8] = make[u8](256);
    manifest_app(&out, "# flash coordinate manifest\n");
    manifest_app(&out, "name = \"");
    manifest_app(&out, m.*.name);
    manifest_app(&out, "\"\n");
    manifest_app(&out, "version = \"");
    manifest_app(&out, m.*.version);
    manifest_app(&out, "\"\n");
    manifest_app(&out, "peak_power_mw = ");
    manifest_app_f32(&out, m.*.peak_power_mw);
    manifest_app(&out, "\n");
    manifest_app(&out, "dominant_pol = ");
    manifest_app_i32(&out, m.*.dominant_pol);
    manifest_app(&out, "\n");
    manifest_app(&out, "[paths]\n");
    let i: i32 = 0;
    let n: i32 = len[PathSegment](m.*.segments);
    while ((i < n)) {
        let s: PathSegment = get[PathSegment](m.*.segments, i);
        manifest_app(&out, "segment ");
        manifest_app_i32(&out, i);
        manifest_app(&out, " { op = \"");
        manifest_app(&out, s.op_tag);
        manifest_app(&out, "\", from = (");
        manifest_app_f32(&out, s.from.x);
        manifest_app(&out, ", ");
        manifest_app_f32(&out, s.from.y);
        manifest_app(&out, ", ");
        manifest_app_f32(&out, s.from.z);
        manifest_app(&out, "), to = (");
        manifest_app_f32(&out, s.to.x);
        manifest_app(&out, ", ");
        manifest_app_f32(&out, s.to.y);
        manifest_app(&out, ", ");
        manifest_app_f32(&out, s.to.z);
        manifest_app(&out, "), power_mw = ");
        manifest_app_f32(&out, s.laser_power_mw);
        manifest_app(&out, ", pol = ");
        manifest_app_i32(&out, s.polarization);
        manifest_app(&out, " }\n");
        i = (i + 1);
    }
    return out.data[0..out.len];
}

fn manifest_app(out: *ArrayList[u8], s: []u8) void {
    let i: i32 = 0;
    while ((i < s.len)) {
        push[u8](out, s[i]);
        i = (i + 1);
    }
}

fn manifest_app_i32(out: *ArrayList[u8], v: i32) void {
    let s: []u8 = _zag_i64_to_str((v) as i64);
    manifest_app(out, s);
}

fn manifest_app_f32(out: *ArrayList[u8], v: f32) void {
    let scaled: i32 = ((v * 1000.0)) as i32;
    manifest_app_i32(out, scaled);
    manifest_app(out, "m");
}

struct RouteCtx {
    byte_offset: i32,
    base_power_mw: f32,
}

fn route_ctx_new() RouteCtx {
    return RouteCtx{ .byte_offset = 0, .base_power_mw = 1.0 };
}

fn coord_from_mm(mm_x: i32, mm_y: i32, mm_z: i32) Coord {
    return coord((mm_x) as f32, (mm_y) as f32, (mm_z) as f32);
}

fn coord_from_manifest_entry(e: CoordinateManifestEntry) Coord {
    return coord_from_mm(e.mm_x, e.mm_y, e.mm_z);
}

fn resolve_logical_address_mgr(mgr: *HardwareManager, byte_offset: i32) ?PhysicalAddress {
    return logical_to_physical(mgr.*.stripe_pool, mgr.*.lattice, byte_offset);
}

fn resolve_mm_coord(mgr: *HardwareManager, byte_offset: i32) Coord {
    let fallback: Coord = coord(0.0, 0.0, 0.0);
    if (resolve_logical_address_mgr(mgr, byte_offset)) |addr| {
        let global: VoxelGlobal = VoxelGlobal{ .chamber = addr.chamber, .local = addr.voxel };
        let mm: ChamberCoord = voxel_mm_offset(mgr.*.lattice, global);
        let entry: CoordinateManifestEntry = CoordinateManifestEntry{ .chamber = addr.chamber, .rotation_deg = rotation_to_deg(addr.rot), .occupied = 1, .lane_id = addr.lane, .voxel = addr.voxel, .laser_axis = LaserAxis.Vertical, .mm_x = mm.x, .mm_y = mm.y, .mm_z = mm.z };
        return coord_from_manifest_entry(entry);
    }
    return fallback;
}

fn trit_to_pol(t: Trit) i32 {
    return t.val;
}

fn lower_trit_op(mgr: *HardwareManager, ctx: *RouteCtx, op: []u8, a: Trit, b: Trit, result: Trit) PathSegment {
    let from_off: i32 = ctx.*.byte_offset;
    let to_off: i32 = (from_off + 1);
    let from_c: Coord = resolve_mm_coord(mgr, from_off);
    let to_c: Coord = resolve_mm_coord(mgr, to_off);
    ctx.*.byte_offset = (to_off + 1);
    let power: f32 = (ctx.*.base_power_mw + ((((a.val * a.val) + (b.val * b.val))) as f32 * 0.25));
    return PathSegment{ .from = from_c, .to = to_c, .laser_power_mw = power, .polarization = trit_to_pol(result), .op_tag = op };
}

fn lower_wave(mgr: *HardwareManager, ctx: *RouteCtx, w: Wave) PathSegment {
    let from_off: i32 = ctx.*.byte_offset;
    let to_off: i32 = (from_off + 1);
    let from_c: Coord = resolve_mm_coord(mgr, from_off);
    let to_c: Coord = resolve_mm_coord(mgr, to_off);
    ctx.*.byte_offset = (to_off + 1);
    return PathSegment{ .from = from_c, .to = to_c, .laser_power_mw = (w.amplitude * ctx.*.base_power_mw), .polarization = 0, .op_tag = "wave" };
}

fn lower_beam(mgr: *HardwareManager, ctx: *RouteCtx, b: Beam) PathSegment {
    let from_off: i32 = ctx.*.byte_offset;
    let to_off: i32 = (from_off + 1);
    let from_c: Coord = resolve_mm_coord(mgr, from_off);
    let to_c: Coord = resolve_mm_coord(mgr, to_off);
    ctx.*.byte_offset = (to_off + 1);
    return PathSegment{ .from = from_c, .to = to_c, .laser_power_mw = b.power_mw, .polarization = trit_to_pol(b.polarization), .op_tag = "beam" };
}

fn lower_phase(mgr: *HardwareManager, ctx: *RouteCtx, p: Phase) PathSegment {
    let from_off: i32 = ctx.*.byte_offset;
    let to_off: i32 = (from_off + 1);
    let from_c: Coord = resolve_mm_coord(mgr, from_off);
    let to_c: Coord = resolve_mm_coord(mgr, to_off);
    ctx.*.byte_offset = (to_off + 1);
    let spin: Trit = phase_spin(p);
    return PathSegment{ .from = from_c, .to = to_c, .laser_power_mw = ctx.*.base_power_mw, .polarization = trit_to_pol(spin), .op_tag = "phase" };
}

fn compile_with_hardware(name: []u8, mgr: *HardwareManager) CoordinateManifest {
    let m: CoordinateManifest = manifest_new(name, "0.1.0");
    let ctx: RouteCtx = route_ctx_new();
    let a: Trit = trit(1);
    let b: Trit = trit(-1);
    let sum: Trit = trit_add(a, b);
    let prod: Trit = trit_mul(a, b);
    let gate: Trit = trit_nand(a, b);
    manifest_push_seg(&m, lower_trit_op(mgr, &ctx, "trit_add", a, b, sum));
    manifest_push_seg(&m, lower_trit_op(mgr, &ctx, "trit_mul", a, b, prod));
    manifest_push_seg(&m, lower_trit_op(mgr, &ctx, "trit_nand", a, b, gate));
    let w: Wave = wave_default();
    let beam: Beam = beam_default();
    let ph: Phase = phase_default();
    manifest_push_seg(&m, lower_wave(mgr, &ctx, w));
    manifest_push_seg(&m, lower_beam(mgr, &ctx, beam));
    manifest_push_seg(&m, lower_phase(mgr, &ctx, ph));
    manifest_set_pol(&m, sum.val);
    return m;
}

fn compile_ternary_program(name: []u8) CoordinateManifest {
    let mgr: HardwareManager = manager_new(2, 2, 1, 2);
    let mp: *HardwareManager = &mgr;
    seat_nano_block(mp, chamber_coord(0, 0, 0), RotationState.R0);
    seat_nano_block(mp, chamber_coord(1, 0, 0), RotationState.R0);
    seat_nano_block(mp, chamber_coord(0, 1, 0), RotationState.R0);
    seat_nano_block(mp, chamber_coord(1, 1, 0), RotationState.R0);
    let manifest: CoordinateManifest = compile_with_hardware(name, mp);
    manager_free(mp);
    return manifest;
}

@import("../flash/types/mat3.zag")
struct SgResult {
    out: ArrayList[u8],
    manifest_text: []u8,
    err: i32,
}

struct SCtx {
    route: RouteCtx,
    hw: *HardwareManager,
    manifest: *CoordinateManifest,
    out: *ArrayList[u8],
    chamber_slot: i32,
    last_trit: Trit,
    prog_name: []u8,
    bind_names: ArrayList[[]u8],
    bind_trits: ArrayList[Trit],
    triple_names: ArrayList[[]u8],
    num_names: ArrayList[[]u8],
    num_types: ArrayList[[]u8],
    mat_names: ArrayList[[]u8],
    mat_data: ArrayList[f32],
    mat3_seg_count: i32,
    raw_counter: i32,
    probe_x: i32,
    probe_y: i32,
    probe_z: i32,
    has_probe: i32,
    err: i32,
}

fn scg_app(out: *ArrayList[u8], s: []u8) void {
    let i: i32 = 0;
    while ((i < s.len)) {
        push[u8](out, s[i]);
        i = (i + 1);
    }
}

fn scg_line(ctx: *SCtx, s: []u8) void {
    scg_app(ctx.*.out, s);
    scg_app(ctx.*.out, "\n");
}

fn scg_dir_depth(dir: []u8) i32 {
    if ((@strEq(dir, ".") == 1)) {
        return 0;
    }
    let start: i32 = 0;
    if ((((dir.len >= 2) && (dir[0] == 46)) && (dir[1] == 47))) {
        start = 2;
    }
    let depth: i32 = 1;
    let i: i32 = start;
    while ((i < dir.len)) {
        if ((dir[i] == 47)) {
            depth = (depth + 1);
        }
        i = (i + 1);
    }
    return depth;
}

fn scg_rel_prefix(depth: i32, extra_up: i32) []u8 {
    let ups: i32 = (depth + extra_up);
    let s: []u8 = "";
    let i: i32 = 0;
    while ((i < ups)) {
        s = _zag_str_concat(s, "../");
        i = (i + 1);
    }
    return s;
}

fn scg_f32_text(v: f32) []u8 {
    let whole: i32 = (v) as i32;
    let frac: f32 = (v - (whole) as f32);
    if ((frac < 0.0)) {
        frac = (0.0 - frac);
        whole = (0 - whole);
    }
    if ((frac > 0.0001)) {
        let scaled: i32 = ((frac * 1000.0)) as i32;
        let s: []u8 = _zag_i64_to_str((whole) as i64);
        s = _zag_str_concat(s, ".");
        return _zag_str_concat(s, _zag_i64_to_str((scaled) as i64));
    }
    return _zag_i64_to_str((whole) as i64);
}

fn scg_parse_f32(text: []u8) f32 {
    let dot: i32 = sp_dot_index(text);
    if ((dot < 0)) {
        return (_zag_str_to_i64(text)) as f32;
    }
    let whole: f32 = (_zag_str_to_i64(text[0..dot])) as f32;
    let frac_s: []u8 = text[(dot + 1)..];
    let frac: f32 = (_zag_str_to_i64(frac_s)) as f32;
    let denom: f32 = 1.0;
    let fi: i32 = 0;
    while ((fi < frac_s.len)) {
        denom = (denom * 10.0);
        fi = (fi + 1);
    }
    return (whole + (frac / denom));
}

fn scg_trit_expr(v: i32) []u8 {
    if ((v == 1)) {
        return "trit(1)";
    }
    if ((v == -1)) {
        return "trit(-1)";
    }
    return "trit(0)";
}

fn scg_emit_header(out: *ArrayList[u8], shim_dir: []u8) void {
    scg_emit_header_full(out, shim_dir, 0, 0);
}

fn scg_emit_header_full(out: *ArrayList[u8], shim_dir: []u8, has_raw: i32, has_mat3: i32) void {
    let depth: i32 = scg_dir_depth(shim_dir);
    let zag_pfx: []u8 = scg_rel_prefix(depth, 1);
    let flash_pfx: []u8 = scg_rel_prefix(depth, 0);
    scg_app(out, "// generated by flashc — do not edit\n");
    scg_app(out, "// balanced trit lowering: flash/ternary/arithmetic.zag (via trit_math at compile time)\n");
    scg_app(out, "@import(\"");
    scg_app(out, zag_pfx);
    scg_app(out, "zag/zag-poc/std/rt.zag\")\n");
    scg_app(out, "@import(\"");
    scg_app(out, flash_pfx);
    scg_app(out, "flash/stdlib/flash_slim.zag\")\n");
    if ((has_raw == 1)) {
        scg_app(out, "@import(\"");
        scg_app(out, flash_pfx);
        scg_app(out, "flash/runtime/photonic_rt.zag\")\n");
    }
    if ((has_mat3 == 1)) {
        scg_app(out, "@import(\"");
        scg_app(out, flash_pfx);
        scg_app(out, "flash/runtime/matrix_shim.zag\")\n");
    }
    scg_app(out, "\n");
}

fn scg_emit_let(ctx: *SCtx, name: []u8, ty: []u8, expr: []u8) void {
    let line: []u8 = _zag_str_concat("    let ", name);
    line = _zag_str_concat(line, ": ");
    line = _zag_str_concat(line, ty);
    line = _zag_str_concat(line, " = ");
    line = _zag_str_concat(line, expr);
    line = _zag_str_concat(line, ";");
    scg_line(ctx, line);
}

fn scg_sync_hw(ctx: *SCtx) void {
    let w: i32 = ctx.*.hw.*.lattice.dims.width;
    let h: i32 = ctx.*.hw.*.lattice.dims.height;
    if ((w < 1)) {
        w = 1;
    }
    if ((h < 1)) {
        h = 1;
    }
    let slot: i32 = ctx.*.chamber_slot;
    let cx: i32 = (slot % w);
    let cy: i32 = ((slot / w) % h);
    let c: ChamberCoord = chamber_coord(cx, cy, 0);
    let rot: RotationState = RotationState.R0;
    if (((slot % 2) == 1)) {
        rot = RotationState.R90;
    }
    seat_nano_block(ctx.*.hw, c, rot);
    ctx.*.chamber_slot = (ctx.*.chamber_slot + 1);
}

fn scg_push_seg(ctx: *SCtx, seg: PathSegment) void {
    manifest_push_seg(ctx.*.manifest, seg);
    scg_sync_hw(ctx);
}

fn scg_segment_at_offset(ctx: *SCtx, op: []u8, power: f32, pol: i32) PathSegment {
    let from_off: i32 = ctx.*.route.byte_offset;
    let to_off: i32 = (from_off + 1);
    let from_c: Coord = resolve_mm_coord(ctx.*.hw, from_off);
    let to_c: Coord = resolve_mm_coord(ctx.*.hw, to_off);
    ctx.*.route.byte_offset = (to_off + 1);
    return PathSegment{ .from = from_c, .to = to_c, .laser_power_mw = power, .polarization = pol, .op_tag = op };
}

fn scg_bind_trit(ctx: *SCtx, name: []u8, t: Trit) void {
    push[[]u8](&ctx.*.bind_names, name);
    push[Trit](&ctx.*.bind_trits, t);
}

fn scg_lookup_trit(ctx: *SCtx, name: []u8) Trit {
    let i: i32 = 0;
    while ((i < len[[]u8](ctx.*.bind_names))) {
        if ((@strEq(get[[]u8](ctx.*.bind_names, i), name) == 1)) {
            return get[Trit](ctx.*.bind_trits, i);
        }
        i = (i + 1);
    }
    return trit(0);
}

fn scg_lower_trit_const(ctx: *SCtx, tag: []u8, t: Trit) Trit {
    let z: Trit = trit(0);
    let seg: PathSegment = lower_trit_op(ctx.*.hw, &ctx.*.route, tag, t, z, t);
    scg_push_seg(ctx, seg);
    ctx.*.last_trit = t;
    return t;
}

fn scg_eval_trit_arg(ctx: *SCtx, name: []u8) Trit {
    let t: Trit = scg_lookup_trit(ctx, name);
    return scg_lower_trit_const(ctx, "trit_var", t);
}

fn scg_lower_trit_op_call(ctx: *SCtx, st: SpStmt) Trit {
    if ((@strEq(st.op_name, "trit_add") == 1)) {
        let a: Trit = scg_eval_trit_arg(ctx, st.op_a);
        let b: Trit = scg_eval_trit_arg(ctx, st.op_b);
        let r: Trit = trit_add(a, b);
        scg_push_seg(ctx, lower_trit_op(ctx.*.hw, &ctx.*.route, "trit_add", a, b, r));
        ctx.*.last_trit = r;
        return r;
    }
    if ((@strEq(st.op_name, "trit_mul") == 1)) {
        let a: Trit = scg_eval_trit_arg(ctx, st.op_a);
        let b: Trit = scg_eval_trit_arg(ctx, st.op_b);
        let r: Trit = trit_mul(a, b);
        scg_push_seg(ctx, lower_trit_op(ctx.*.hw, &ctx.*.route, "trit_mul", a, b, r));
        ctx.*.last_trit = r;
        return r;
    }
    if ((@strEq(st.op_name, "trit_nand") == 1)) {
        let a: Trit = scg_eval_trit_arg(ctx, st.op_a);
        let b: Trit = scg_eval_trit_arg(ctx, st.op_b);
        let r: Trit = trit_nand(a, b);
        scg_push_seg(ctx, lower_trit_op(ctx.*.hw, &ctx.*.route, "trit_nand", a, b, r));
        ctx.*.last_trit = r;
        return r;
    }
    if ((@strEq(st.op_name, "trit_neg") == 1)) {
        let a: Trit = scg_eval_trit_arg(ctx, st.op_a);
        let r: Trit = trit_neg(a);
        let z: Trit = trit(0);
        scg_push_seg(ctx, lower_trit_op(ctx.*.hw, &ctx.*.route, "trit_neg", a, z, r));
        ctx.*.last_trit = r;
        return r;
    }
    return scg_lower_trit_const(ctx, "trit_call", trit(0));
}

fn scg_mat_push_flat(ctx: *SCtx, m: Mat3) void {
    push[f32](&ctx.*.mat_data, m.m00);
    push[f32](&ctx.*.mat_data, m.m01);
    push[f32](&ctx.*.mat_data, m.m02);
    push[f32](&ctx.*.mat_data, m.m10);
    push[f32](&ctx.*.mat_data, m.m11);
    push[f32](&ctx.*.mat_data, m.m12);
    push[f32](&ctx.*.mat_data, m.m20);
    push[f32](&ctx.*.mat_data, m.m21);
    push[f32](&ctx.*.mat_data, m.m22);
}

fn scg_mat_flat_at(ctx: *SCtx, idx: i32) Mat3 {
    let base: i32 = (idx * 9);
    return Mat3{ .m00 = get[f32](ctx.*.mat_data, (base + 0)), .m01 = get[f32](ctx.*.mat_data, (base + 1)), .m02 = get[f32](ctx.*.mat_data, (base + 2)), .m10 = get[f32](ctx.*.mat_data, (base + 3)), .m11 = get[f32](ctx.*.mat_data, (base + 4)), .m12 = get[f32](ctx.*.mat_data, (base + 5)), .m20 = get[f32](ctx.*.mat_data, (base + 6)), .m21 = get[f32](ctx.*.mat_data, (base + 7)), .m22 = get[f32](ctx.*.mat_data, (base + 8)) };
}

fn scg_bind_mat(ctx: *SCtx, name: []u8, m: Mat3) void {
    push[[]u8](&ctx.*.mat_names, name);
    scg_mat_push_flat(ctx, m);
}

fn scg_lookup_mat(ctx: *SCtx, name: []u8) Mat3 {
    let i: i32 = 0;
    while ((i < len[[]u8](ctx.*.mat_names))) {
        if ((@strEq(get[[]u8](ctx.*.mat_names, i), name) == 1)) {
            return scg_mat_flat_at(ctx, i);
        }
        i = (i + 1);
    }
    return mat3_identity();
}

fn scg_mat_abs_f32(v: f32) f32 {
    if ((v < 0.0)) {
        return (0.0 - v);
    }
    return v;
}

struct SMatRoute {
    pos: Coord,
    depth: i32,
    base_power_mw: f32,
}

fn scg_mat3_route_term(ctx: *SCtx, rt: *SMatRoute, row: i32, col: i32, weight: f32, tr: Trit, op_tag: []u8) void {
    let from: Coord = rt.*.pos;
    let dx: f32 = (col) as f32;
    let dy: f32 = (row) as f32;
    let dz: f32 = (rt.*.depth) as f32;
    let to_coord: Coord = coord((from.x + dx), (from.y + dy), (from.z + dz));
    rt.*.pos = to_coord;
    rt.*.depth = (rt.*.depth + 1);
    let pol: i32 = 0;
    if ((tr.val == 1)) {
        pol = 1;
    }
    if ((tr.val == -1)) {
        pol = -1;
    }
    let power: f32 = scg_mat_abs_f32((rt.*.base_power_mw * weight));
    let seg: PathSegment = PathSegment{ .from = from, .to = to_coord, .laser_power_mw = power, .polarization = pol, .op_tag = op_tag };
    manifest_push_seg(ctx.*.manifest, seg);
}

fn scg_mat3_route(ctx: *SCtx, m: Mat3, tx: Trit, ty: Trit, tz: Trit) void {
    let rt: SMatRoute = SMatRoute{ .pos = coord(0.0, 0.0, 0.0), .depth = 0, .base_power_mw = 1.0 };
    scg_mat3_route_term(ctx, &rt, 0, 0, m.m00, tx, "mat3_r0c0");
    scg_mat3_route_term(ctx, &rt, 0, 1, m.m01, ty, "mat3_r0c1");
    scg_mat3_route_term(ctx, &rt, 0, 2, m.m02, tz, "mat3_r0c2");
    scg_mat3_route_term(ctx, &rt, 1, 0, m.m10, tx, "mat3_r1c0");
    scg_mat3_route_term(ctx, &rt, 1, 1, m.m11, ty, "mat3_r1c1");
    scg_mat3_route_term(ctx, &rt, 1, 2, m.m12, tz, "mat3_r1c2");
    scg_mat3_route_term(ctx, &rt, 2, 0, m.m20, tx, "mat3_r2c0");
    scg_mat3_route_term(ctx, &rt, 2, 1, m.m21, ty, "mat3_r2c1");
    scg_mat3_route_term(ctx, &rt, 2, 2, m.m22, tz, "mat3_r2c2");
}

fn scg_lower_mat3(ctx: *SCtx, st: SpStmt) void {
    if ((@strEq(st.op_name, "mat3_identity") == 1)) {
        scg_bind_mat(ctx, st.op_dst, mat3_identity());
        scg_emit_let(ctx, st.op_dst, "Mat3", "mat3_identity()");
        return;
    }
    if ((@strEq(st.op_name, "mat3_rotation_xy_90") == 1)) {
        scg_bind_mat(ctx, st.op_dst, mat3_rotation_xy_90());
        scg_emit_let(ctx, st.op_dst, "Mat3", "mat3_rotation_xy_90()");
        return;
    }
    if ((@strEq(st.op_name, "mat3_mul") == 1)) {
        let a: Mat3 = scg_lookup_mat(ctx, st.op_a);
        let b: Mat3 = scg_lookup_mat(ctx, st.op_b);
        scg_bind_mat(ctx, st.op_dst, mat3_mul(a, b));
        let expr: []u8 = _zag_str_concat("mat3_mul(", st.op_a);
        expr = _zag_str_concat(expr, ", ");
        expr = _zag_str_concat(expr, st.op_b);
        expr = _zag_str_concat(expr, ")");
        scg_emit_let(ctx, st.op_dst, "Mat3", expr);
        return;
    }
    if ((@strEq(st.op_name, "mat3_apply") == 1)) {
        let m: Mat3 = scg_lookup_mat(ctx, st.op_a);
        let tx: Trit = scg_lookup_trit(ctx, st.op_b);
        let tyv: Trit = scg_lookup_trit(ctx, st.op_c);
        let tz: Trit = scg_lookup_trit(ctx, st.op_d);
        scg_mat3_route(ctx, m, tx, tyv, tz);
        ctx.*.mat3_seg_count = (ctx.*.mat3_seg_count + 9);
        let expr: []u8 = _zag_str_concat("mat3_apply_trit(", st.op_a);
        expr = _zag_str_concat(expr, ", TritTriple{ .x = ");
        expr = _zag_str_concat(expr, st.op_b);
        expr = _zag_str_concat(expr, ", .y = ");
        expr = _zag_str_concat(expr, st.op_c);
        expr = _zag_str_concat(expr, ", .z = ");
        expr = _zag_str_concat(expr, st.op_d);
        expr = _zag_str_concat(expr, " })");
        scg_emit_let(ctx, st.op_dst, "TritTriple", expr);
        push[[]u8](&ctx.*.triple_names, st.op_dst);
        ctx.*.last_trit = tx;
        return;
    }
    _zag_println("flashc1: unknown mat3 op in codegen");
    ctx.*.err = 1;
}

fn scg_raw_extern_name(callee: []u8) []u8 {
    if ((@strEq(callee, "fire_shield") == 1)) {
        return "_flash_raw_fire_shield";
    }
    if ((@strEq(callee, "inject_phase") == 1)) {
        return "_flash_raw_inject_phase";
    }
    if ((@strEq(callee, "set_laser_mw") == 1)) {
        return "_flash_raw_set_laser_mw";
    }
    if ((@strEq(callee, "target_voxel") == 1)) {
        return "_flash_raw_target_voxel";
    }
    if ((@strEq(callee, "manual_polarity") == 1)) {
        return "_flash_raw_set_polarity";
    }
    return "_flash_raw_mode_enter";
}

fn scg_raw_args_text(rc: SpRawCall) []u8 {
    let n: i32 = len[f32](rc.args);
    let s: []u8 = "";
    let i: i32 = 0;
    while ((i < n)) {
        if ((i > 0)) {
            s = _zag_str_concat(s, ", ");
        }
        let txt: []u8 = scg_f32_text(get[f32](rc.args, i));
        if (((@strEq(rc.name, "manual_polarity") == 1) && (i == (n - 1)))) {
            s = _zag_str_concat(s, "(");
            s = _zag_str_concat(s, txt);
            s = _zag_str_concat(s, ") as i32");
        } else {
            s = _zag_str_concat(s, txt);
        }
        i = (i + 1);
    }
    return s;
}

fn scg_track_probe(ctx: *SCtx, rc: SpRawCall) void {
    if ((((@strEq(rc.name, "target_voxel") == 1) || (@strEq(rc.name, "fire_shield") == 1)) || (@strEq(rc.name, "inject_phase") == 1))) {
        ctx.*.probe_x = (get[f32](rc.args, 0)) as i32;
        ctx.*.probe_y = (get[f32](rc.args, 1)) as i32;
        ctx.*.probe_z = (get[f32](rc.args, 2)) as i32;
        ctx.*.has_probe = 1;
    }
}

fn scg_emit_voxel_probe(ctx: *SCtx) void {
    if ((ctx.*.has_probe == 0)) {
        return;
    }
    let open: []u8 = _zag_str_concat("    if (runtime_voxel_at(", _zag_i64_to_str((ctx.*.probe_x) as i64));
    let line: []u8 = _zag_str_concat(open, ", ");
    line = _zag_str_concat(line, _zag_i64_to_str((ctx.*.probe_y) as i64));
    line = _zag_str_concat(line, ", ");
    line = _zag_str_concat(line, _zag_i64_to_str((ctx.*.probe_z) as i64));
    line = _zag_str_concat(line, ")) |cell| {");
    scg_line(ctx, line);
    scg_line(ctx, "        _zag_print(\"voxel pol=\");");
    scg_line(ctx, "        _zag_print(_zag_i64_to_str(runtime_pol_wire(cell.pol) as i64));");
    scg_line(ctx, "        _zag_print(\" phase_milli=\");");
    scg_line(ctx, "        _zag_print(_zag_i64_to_str(((cell.phase * 1000.0) as i32) as i64));");
    scg_line(ctx, "        _zag_print(\" amp_milli=\");");
    scg_line(ctx, "        _zag_print(_zag_i64_to_str(((cell.amp * 1000.0) as i32) as i64));");
    scg_line(ctx, "        _zag_println(\"\");");
    scg_line(ctx, "    } else {");
    scg_line(ctx, "        _zag_println(\"FAIL raw voxel missing\");");
    scg_line(ctx, "        return 1;");
    scg_line(ctx, "    }");
}

fn scg_lower_raw_call(ctx: *SCtx, rc: SpRawCall) void {
    let ext: []u8 = scg_raw_extern_name(rc.name);
    let args: []u8 = scg_raw_args_text(rc);
    scg_track_probe(ctx, rc);
    let slot: i32 = ctx.*.raw_counter;
    ctx.*.raw_counter = (ctx.*.raw_counter + 1);
    let line: []u8 = _zag_str_concat("    let _raw_", _zag_i64_to_str((slot) as i64));
    line = _zag_str_concat(line, ": i32 = ");
    line = _zag_str_concat(line, ext);
    line = _zag_str_concat(line, "(");
    line = _zag_str_concat(line, args);
    line = _zag_str_concat(line, ");");
    scg_line(ctx, line);
    let tag: []u8 = _zag_str_concat("raw_", rc.name);
    let seg: PathSegment = scg_segment_at_offset(ctx, tag, ctx.*.route.base_power_mw, 0);
    scg_push_seg(ctx, seg);
}

fn scg_lower_raw_block(ctx: *SCtx, st: SpStmt) void {
    scg_line(ctx, "    let _flash_raw_enter: i32 = _flash_raw_mode_enter();");
    let i: i32 = 0;
    while ((i < len[SpRawCall](st.raws))) {
        scg_lower_raw_call(ctx, get[SpRawCall](st.raws, i));
        i = (i + 1);
    }
    scg_line(ctx, "    let _flash_raw_exit: i32 = _flash_raw_mode_exit();");
    scg_emit_voxel_probe(ctx);
}

fn scg_lower_posit(ctx: *SCtx, st: SpStmt) void {
    let text: []u8 = scg_f32_text(st.num_f32);
    let v: f32 = scg_parse_f32(text);
    let bits: i32 = ((v * 1000.0)) as i32;
    let regime: i32 = (bits % 4);
    if ((regime > 1)) {
        regime = 1;
    }
    if ((regime < -1)) {
        regime = -1;
    }
    let seg: PathSegment = scg_segment_at_offset(ctx, "p32", ctx.*.route.base_power_mw, regime);
    scg_push_seg(ctx, seg);
}

fn scg_emit_trit_summary(ctx: *SCtx) void {
    if ((len[[]u8](ctx.*.bind_names) < 1)) {
        return;
    }
    let i: i32 = 0;
    while ((i < len[[]u8](ctx.*.bind_names))) {
        let name: []u8 = get[[]u8](ctx.*.bind_names, i);
        scg_line(ctx, "    _zag_print(\"trit \");");
        let nline: []u8 = _zag_str_concat("    _zag_print(\"", name);
        nline = _zag_str_concat(nline, "\");");
        scg_line(ctx, nline);
        scg_line(ctx, "    _zag_print(\"=\");");
        let vline: []u8 = _zag_str_concat("    _zag_print(_zag_i64_to_str(trit_val(", name);
        vline = _zag_str_concat(vline, ") as i64));");
        scg_line(ctx, vline);
        scg_line(ctx, "    _zag_println(\"\");");
        i = (i + 1);
    }
}

fn scg_emit_triple_summary(ctx: *SCtx) void {
    let i: i32 = 0;
    while ((i < len[[]u8](ctx.*.triple_names))) {
        let name: []u8 = get[[]u8](ctx.*.triple_names, i);
        scg_line(ctx, "    _zag_print(\"trit \");");
        let nline: []u8 = _zag_str_concat("    _zag_print(\"", name);
        nline = _zag_str_concat(nline, "\");");
        scg_line(ctx, nline);
        scg_line(ctx, "    _zag_print(\"=\");");
        let vline: []u8 = _zag_str_concat("    _zag_print(_zag_i64_to_str(trit_val(", name);
        vline = _zag_str_concat(vline, ".x) as i64));");
        scg_line(ctx, vline);
        scg_line(ctx, "    _zag_println(\"\");");
        i = (i + 1);
    }
}

fn scg_emit_num_summary(ctx: *SCtx) void {
    let i: i32 = 0;
    while ((i < len[[]u8](ctx.*.num_names))) {
        let name: []u8 = get[[]u8](ctx.*.num_names, i);
        let ty: []u8 = get[[]u8](ctx.*.num_types, i);
        scg_line(ctx, "    _zag_print(\"numeric \");");
        let tline: []u8 = _zag_str_concat("    _zag_print(\"", ty);
        tline = _zag_str_concat(tline, " ");
        tline = _zag_str_concat(tline, name);
        tline = _zag_str_concat(tline, "\");");
        scg_line(ctx, tline);
        scg_line(ctx, "    _zag_print(\"=\");");
        let vline: []u8 = _zag_str_concat("    _zag_print(_zag_i64_to_str(", name);
        vline = _zag_str_concat(vline, " as i64));");
        scg_line(ctx, vline);
        scg_line(ctx, "    _zag_println(\"\");");
        i = (i + 1);
    }
}

fn scg_emit_mat3_summary(ctx: *SCtx) void {
    if ((ctx.*.mat3_seg_count < 1)) {
        return;
    }
    scg_line(ctx, "    _zag_print(\"mat3_segments=\");");
    let line: []u8 = _zag_str_concat("    _zag_print(_zag_i64_to_str(", _zag_i64_to_str((ctx.*.mat3_seg_count) as i64));
    line = _zag_str_concat(line, " as i64));");
    scg_line(ctx, line);
    scg_line(ctx, "    _zag_println(\"\");");
}

fn scg_lower_stmt(ctx: *SCtx, st: SpStmt) void {
    if ((st.kind == spk_trit_bind())) {
        scg_emit_let(ctx, st.name, "Trit", scg_trit_expr(st.trit_lit));
        let v: i32 = st.trit_lit;
        if ((((v != -1) && (v != 0)) && (v != 1))) {
            v = 0;
        }
        let t: Trit = scg_lower_trit_const(ctx, "trit_lit", trit(v));
        scg_bind_trit(ctx, st.name, t);
        return;
    }
    if ((st.kind == spk_trit_op())) {
        let expr: []u8 = _zag_str_concat(st.op_name, "(");
        expr = _zag_str_concat(expr, st.op_a);
        if ((@strEq(st.op_name, "trit_neg") == 0)) {
            expr = _zag_str_concat(expr, ", ");
            expr = _zag_str_concat(expr, st.op_b);
        }
        expr = _zag_str_concat(expr, ")");
        scg_emit_let(ctx, st.op_dst, "Trit", expr);
        let r: Trit = scg_lower_trit_op_call(ctx, st);
        scg_bind_trit(ctx, st.op_dst, r);
        return;
    }
    if ((st.kind == spk_wave_bind())) {
        scg_emit_let(ctx, st.name, "Wave", "wave_default()");
        scg_push_seg(ctx, lower_wave(ctx.*.hw, &ctx.*.route, wave_default()));
        return;
    }
    if ((st.kind == spk_p32_bind())) {
        let expr: []u8 = _zag_str_concat("@floatToPosit(", scg_f32_text(st.num_f32));
        expr = _zag_str_concat(expr, ")");
        scg_emit_let(ctx, st.name, "p32", expr);
        scg_lower_posit(ctx, st);
        push[[]u8](&ctx.*.num_names, st.name);
        push[[]u8](&ctx.*.num_types, "p32");
        return;
    }
    if ((st.kind == spk_sat_bind())) {
        let expr: []u8 = _zag_str_concat("(", _zag_i64_to_str((st.trit_lit) as i64));
        expr = _zag_str_concat(expr, ") as sat_i16");
        scg_emit_let(ctx, st.name, "sat_i16", expr);
        let _t: Trit = scg_lower_trit_const(ctx, "sat_i16", trit(0));
        push[[]u8](&ctx.*.num_names, st.name);
        push[[]u8](&ctx.*.num_types, "sat_i16");
        return;
    }
    if ((st.kind == spk_mat3_op())) {
        scg_lower_mat3(ctx, st);
        return;
    }
    if ((st.kind == spk_raw_block())) {
        scg_lower_raw_block(ctx, st);
        return;
    }
    _zag_println("flashc1: unsupported statement kind in codegen");
    ctx.*.err = 1;
}

fn scg_has_raw(prog: *SpProgram) i32 {
    let i: i32 = 0;
    while ((i < len[SpStmt](prog.*.stmts))) {
        if ((get[SpStmt](prog.*.stmts, i).kind == spk_raw_block())) {
            return 1;
        }
        i = (i + 1);
    }
    return 0;
}

fn scg_has_mat3(prog: *SpProgram) i32 {
    let i: i32 = 0;
    while ((i < len[SpStmt](prog.*.stmts))) {
        if ((get[SpStmt](prog.*.stmts, i).kind == spk_mat3_op())) {
            return 1;
        }
        i = (i + 1);
    }
    return 0;
}

fn scg_emit(prog: *SpProgram, shim_dir: []u8) SgResult {
    let out: ArrayList[u8] = make[u8](4096);
    scg_emit_header_full(&out, shim_dir, scg_has_raw(prog), scg_has_mat3(prog));
    let mgr: HardwareManager = manager_new(4, 4, 1, 4);
    let mp: *HardwareManager = &mgr;
    seat_nano_block(mp, chamber_coord(0, 0, 0), RotationState.R0);
    seat_nano_block(mp, chamber_coord(1, 0, 0), RotationState.R0);
    seat_nano_block(mp, chamber_coord(0, 1, 0), RotationState.R0);
    seat_nano_block(mp, chamber_coord(1, 1, 0), RotationState.R0);
    let mani: CoordinateManifest = manifest_new(prog.*.name, "0.1.0");
    let ctx: SCtx = SCtx{ .route = route_ctx_new(), .hw = mp, .manifest = &mani, .out = &out, .chamber_slot = 0, .last_trit = trit(0), .prog_name = prog.*.name, .bind_names = make[[]u8](16), .bind_trits = make[Trit](16), .triple_names = make[[]u8](4), .num_names = make[[]u8](8), .num_types = make[[]u8](8), .mat_names = make[[]u8](8), .mat_data = make[f32](72), .mat3_seg_count = 0, .raw_counter = 0, .probe_x = 0, .probe_y = 0, .probe_z = 0, .has_probe = 0, .err = 0 };
    scg_app(&out, "fn main() i32 {\n");
    let i: i32 = 0;
    while ((i < len[SpStmt](prog.*.stmts))) {
        scg_lower_stmt(&ctx, get[SpStmt](prog.*.stmts, i));
        i = (i + 1);
    }
    scg_emit_trit_summary(&ctx);
    scg_emit_triple_summary(&ctx);
    scg_emit_num_summary(&ctx);
    scg_emit_mat3_summary(&ctx);
    if ((prog.*.name.len >= 1)) {
        let msg: []u8 = _zag_str_concat(prog.*.name, ": ok");
        let line: []u8 = _zag_str_concat("    _zag_println(\"", msg);
        scg_line(&ctx, _zag_str_concat(line, "\");"));
    }
    scg_app(&out, "    return 0;\n");
    scg_app(&out, "}\n");
    let mtext: []u8 = manifest_write(&mani);
    manager_free(mp);
    return SgResult{ .out = out, .manifest_text = mtext, .err = ctx.err };
}

