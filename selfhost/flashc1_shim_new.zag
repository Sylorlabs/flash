        return 1;
    }
    return 0;
}

fn sp_skip_semi(p: *SParser) void {
    let _s: i32 = sp_match(p, sfk_semi());
}

fn sp_trit_lit(t: SfToken) i32 {
    if (((t.kind == sfk_ident()) && (@strEq(t.text, "T") == 1))) {
        return -1;
    }
    if (((t.kind == sfk_int()) && (@strEq(t.text, "+1") == 1))) {
        return 1;
    }
    if (((t.kind == sfk_int()) && (@strEq(t.text, "-1") == 1))) {
        return -1;
    }
    if (((t.kind == sfk_int()) && (@strEq(t.text, "0") == 1))) {
        return 0;
    }
    if (((t.kind == sfk_int()) && (@strEq(t.text, "1") == 1))) {
        return 1;
    }
    return 99;
}

fn sp_dot_index(s: []u8) i32 {
    let i: i32 = 0;
    while ((i < s.len)) {
        if ((s[i] == 46)) {
            return i;
        }
        i = (i + 1);
    }
    return -1;
}

fn sp_parse_float(t: SfToken) f32 {
    if ((t.kind == sfk_int())) {
        return (_zag_str_to_i64(t.text)) as f32;
    }
    if ((t.kind == sfk_float())) {
        let dot: i32 = sp_dot_index(t.text);
        if ((dot < 0)) {
            return (_zag_str_to_i64(t.text)) as f32;
        }
        let whole: f32 = (_zag_str_to_i64(t.text[0..dot])) as f32;
        let frac_s: []u8 = t.text[(dot + 1)..];
        let frac: f32 = (_zag_str_to_i64(frac_s)) as f32;
        let denom: f32 = 1.0;
        let fi: i32 = 0;
        while ((fi < frac_s.len)) {
            denom = (denom * 10.0);
            fi = (fi + 1);
        }
        return (whole + (frac / denom));
    }
    return 0.0;
}

fn sp_raw_call_known(name: []u8) i32 {
    if ((@strEq(name, "fire_shield") == 1)) {
        return 1;
    }
    if ((@strEq(name, "inject_phase") == 1)) {
        return 1;
    }
    if ((@strEq(name, "set_laser_mw") == 1)) {
        return 1;
    }
    if ((@strEq(name, "target_voxel") == 1)) {
        return 1;
    }
    if ((@strEq(name, "manual_polarity") == 1)) {
        return 1;
    }
    return 0;
}

fn sp_raw_arg_count(name: []u8) i32 {
    if ((@strEq(name, "set_laser_mw") == 1)) {
        return 3;
    }
    if ((@strEq(name, "target_voxel") == 1)) {
        return 3;
    }
    return 4;
}

