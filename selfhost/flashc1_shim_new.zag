    return t;
}

fn sp_expect(p: *SParser, kind: i32) SfToken {
    let t: SfToken = sp_advance(p);
    if ((t.kind != kind)) {
        _zag_print("flashc1 parse error: unexpected token at line ");
        _zag_println(_zag_i64_to_str((t.line) as i64));
        p.*.err = 1;
    }
    return t;
}

