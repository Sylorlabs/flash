struct FxToken {
    kind: i32,
    text: []u8,
    line: i32,
}

fn fx_ch(src: []u8, i: i32) i32 {
    return (src[i]) as i32;
}

fn fx_is_digit(c: i32) i32 {
    if (((c >= 48) && (c <= 57))) {
        return 1;
    }
    return 0;
}

fn fx_is_alpha(c: i32) i32 {
    if (((c >= 97) && (c <= 122))) {
        return 1;
    }
    if (((c >= 65) && (c <= 90))) {
        return 1;
    }
    if ((c == 95)) {
        return 1;
    }
    return 0;
}

fn fx_is_alnum(c: i32) i32 {
    if (((fx_is_alpha(c) == 1) || (fx_is_digit(c) == 1))) {
        return 1;
    }
    return 0;
}

fn fx_is_space(c: i32) i32 {
    if (((((c == 32) || (c == 9)) || (c == 13)) || (c == 10))) {
        return 1;
    }
    return 0;
}

fn fx_parse_digits(w: []u8) i32 {
    if ((w.len < 1)) {
        return -1;
    }
    let n: i32 = 0;
    let i: i32 = 0;
    while ((i < w.len)) {
        let c: i32 = fx_ch(w, i);
        if ((fx_is_digit(c) == 0)) {
            return -1;
        }
        n = ((n * 10) + (c - 48));
        i = (i + 1);
    }
    return n;
}

fn fx_type_kind(w: []u8) i32 {
    if (((((@strEq(w, "i8") == 1) || (@strEq(w, "i16") == 1)) || (@strEq(w, "i32") == 1)) || (@strEq(w, "i64") == 1))) {
        return fx_type();
    }
    if (((((@strEq(w, "u8") == 1) || (@strEq(w, "u16") == 1)) || (@strEq(w, "u32") == 1)) || (@strEq(w, "u64") == 1))) {
        return fx_type();
    }
    if (((@strEq(w, "f32") == 1) || (@strEq(w, "f64") == 1))) {
        return fx_type();
    }
    if (((((@strEq(w, "p8") == 1) || (@strEq(w, "p16") == 1)) || (@strEq(w, "p32") == 1)) || (@strEq(w, "p64") == 1))) {
        return fx_type();
    }
    if ((((@strEq(w, "sat_i16") == 1) || (@strEq(w, "fixed_8_8") == 1)) || (@strEq(w, "u11") == 1))) {
        return fx_type();
    }
    if ((((@strEq(w, "u_any") == 1) || (@strEq(w, "rns_3") == 1)) || (@strEq(w, "quire") == 1))) {
        return fx_type();
    }
    if ((((@strEq(w, "sat_i8") == 1) || (@strEq(w, "sat_i32") == 1)) || (@strEq(w, "sat_i64") == 1))) {
        return fx_type();
    }
    if (((((@strEq(w, "sat_u8") == 1) || (@strEq(w, "sat_u16") == 1)) || (@strEq(w, "sat_u32") == 1)) || (@strEq(w, "sat_u64") == 1))) {
        return fx_type();
    }
    if ((@strEq(w, "i_any") == 1)) {
        return fx_type();
    }
    if ((w.len >= 2)) {
        let lead: i32 = fx_ch(w, 0);
        if (((lead == 105) || (lead == 117))) {
            let n: i32 = fx_parse_digits(w[1..w.len]);
            if (((n >= 1) && (n <= 127))) {
                return fx_type();
            }
        }
    }
    return fx_ident();
}

fn fx_zag_kw(w: []u8) i32 {
    if ((@strEq(w, "fn") == 1)) {
        return fx_kw_fn();
    }
    if ((@strEq(w, "extern") == 1)) {
        return fx_kw_extern();
    }
    if ((@strEq(w, "let") == 1)) {
        return fx_kw_let();
    }
    if ((@strEq(w, "return") == 1)) {
        return fx_kw_return();
    }
    if ((@strEq(w, "if") == 1)) {
        return fx_kw_if();
    }
    if ((@strEq(w, "else") == 1)) {
        return fx_kw_else();
    }
    if ((@strEq(w, "while") == 1)) {
        return fx_kw_while();
    }
    if ((@strEq(w, "true") == 1)) {
        return fx_kw_true();
    }
    if ((@strEq(w, "false") == 1)) {
        return fx_kw_false();
    }
    if ((@strEq(w, "struct") == 1)) {
        return fx_kw_struct();
    }
    if ((@strEq(w, "enum") == 1)) {
        return fx_kw_enum();
    }
    if ((@strEq(w, "union") == 1)) {
        return fx_kw_union();
    }
    if ((@strEq(w, "switch") == 1)) {
        return fx_kw_switch();
    }
    if ((@strEq(w, "error") == 1)) {
        return fx_kw_error();
    }
    if ((@strEq(w, "try") == 1)) {
        return fx_kw_try();
    }
    if ((@strEq(w, "catch") == 1)) {
        return fx_kw_catch();
    }
    if ((@strEq(w, "null") == 1)) {
        return fx_kw_null();
    }
    if ((@strEq(w, "orelse") == 1)) {
        return fx_kw_orelse();
    }
    if ((@strEq(w, "pub") == 1)) {
        return fx_kw_pub();
    }
    return fx_ident();
}

fn fx_flash_kw(w: []u8) i32 {
    if ((@strEq(w, "raw") == 1)) {
        return fx_kw_raw();
    }
    if ((@strEq(w, "wave") == 1)) {
        return fx_kw_wave();
    }
    if ((@strEq(w, "beam") == 1)) {
        return fx_kw_beam();
    }
    if ((@strEq(w, "phase") == 1)) {
        return fx_kw_phase();
    }
    if ((@strEq(w, "trit") == 1)) {
        return fx_kw_trit();
    }
    return fx_ident();
}

fn fx_word_kind(w: []u8) i32 {
    let z: i32 = fx_zag_kw(w);
    if ((z != fx_ident())) {
        return z;
    }
    let f: i32 = fx_flash_kw(w);
    if ((f != fx_ident())) {
        return f;
    }
    let t: i32 = fx_type_kind(w);
    if ((t != fx_ident())) {
        return t;
    }
    if ((@strEq(w, "T") == 1)) {
        return fx_tritlit();
    }
    return fx_ident();
}

fn fx_is_two_op(src: []u8, i: i32, n: i32) i32 {
    if (((i + 1) >= n)) {
        return 0;
    }
    let a: i32 = fx_ch(src, i);
    let b: i32 = fx_ch(src, (i + 1));
    if (((a == 61) && (b == 61))) {
        return 1;
    }
    if (((a == 33) && (b == 61))) {
        return 1;
    }
    if (((a == 60) && (b == 61))) {
        return 1;
    }
    if (((a == 62) && (b == 61))) {
        return 1;
    }
    if (((a == 38) && (b == 38))) {
        return 1;
    }
    if (((a == 124) && (b == 124))) {
        return 1;
    }
    if (((a == 61) && (b == 62))) {
        return 1;
    }
    return 0;
}

fn fx_punct_kind(c: i32) i32 {
    if ((c == 40)) {
        return fx_lp();
    }
    if ((c == 41)) {
        return fx_rp();
    }
    if ((c == 123)) {
        return fx_lbrace();
    }
    if ((c == 125)) {
        return fx_rbrace();
    }
    if ((c == 91)) {
        return fx_lbracket();
    }
    if ((c == 93)) {
        return fx_rbracket();
    }
    if ((c == 44)) {
        return fx_comma();
    }
    if ((c == 59)) {
        return fx_semi();
    }
    if ((c == 58)) {
        return fx_colon();
    }
    if ((c == 46)) {
        return fx_dot();
    }
    if ((c == 124)) {
        return fx_pipe();
    }
    return fx_op();
}

fn fx_is_single_op(c: i32) i32 {
    if ((((((c == 43) || (c == 45)) || (c == 42)) || (c == 47)) || (c == 37))) {
        return 1;
    }
    if ((((((c == 60) || (c == 62)) || (c == 61)) || (c == 33)) || (c == 38))) {
        return 1;
    }
    if ((c == 63)) {
        return 1;
    }
    return 0;
}

fn fx_mk(kind: i32, text: []u8, line: i32) FxToken {
    return FxToken{ .kind = kind, .text = text, .line = line };
}

fn flex(src: []u8) ArrayList[FxToken] {
    let toks: ArrayList[FxToken] = make[FxToken](128);
    let n: i32 = src.len;
    let i: i32 = 0;
    let line: i32 = 1;
    let expect_trit_type: i32 = 0;
    let in_trit_rhs: i32 = 0;
    while ((i < n)) {
        let c: i32 = fx_ch(src, i);
        if ((c == 10)) {
            line = (line + 1);
            i = (i + 1);
        } else if ((fx_is_space(c) == 1)) {
            i = (i + 1);
        } else if ((((c == 47) && ((i + 1) < n)) && (fx_ch(src, (i + 1)) == 47))) {
            while (((i < n) && (fx_ch(src, i) != 10))) {
                i = (i + 1);
            }
        } else if ((((c == 47) && ((i + 1) < n)) && (fx_ch(src, (i + 1)) == 42))) {
            i = (i + 2);
            let cmt_done: i32 = 0;
            while ((((i + 1) < n) && (cmt_done == 0))) {
                if (((fx_ch(src, i) == 42) && (fx_ch(src, (i + 1)) == 47))) {
                    i = (i + 2);
                    cmt_done = 1;
                } else {
                    if ((fx_ch(src, i) == 10)) {
                        line = (line + 1);
                    }
                    i = (i + 1);
                }
            }
        } else if ((c == 64)) {
            let start: i32 = i;
            i = (i + 1);
            while (((i < n) && (fx_is_alnum(fx_ch(src, i)) == 1))) {
                i = (i + 1);
            }
            push[FxToken](&toks, fx_mk(fx_annot(), src[start..i], line));
            expect_trit_type = 0;
        } else if ((fx_is_alpha(c) == 1)) {
            let start: i32 = i;
            i = (i + 1);
            while (((i < n) && (fx_is_alnum(fx_ch(src, i)) == 1))) {
                i = (i + 1);
            }
            let word: []u8 = src[start..i];
            let k: i32 = fx_word_kind(word);
            push[FxToken](&toks, fx_mk(k, word, line));
            if (((expect_trit_type == 1) && (k == fx_kw_trit()))) {
                expect_trit_type = 2;
            } else {
                expect_trit_type = 0;
            }
        } else if ((fx_is_digit(c) == 1)) {
            let start: i32 = i;
            let is_float: i32 = 0;
            let done: i32 = 0;
            i = (i + 1);
            while (((i < n) && (done == 0))) {
                let d: i32 = fx_ch(src, i);
                if ((fx_is_digit(d) == 1)) {
                    i = (i + 1);
                } else if ((((d == 46) && ((i + 1) < n)) && (fx_is_digit(fx_ch(src, (i + 1))) == 1))) {
                    is_float = 1;
                    i = (i + 1);
                } else {
                    done = 1;
                }
            }
            let slice: []u8 = src[start..i];
            let k: i32 = fx_int();
            if ((is_float == 1)) {
                k = fx_float();
            } else if (((in_trit_rhs == 1) && (slice.len == 1))) {
                let d0: i32 = fx_ch(slice, 0);
                if (((d0 == 48) || (d0 == 49))) {
                    k = fx_tritlit();
                    in_trit_rhs = 0;
                }
            }
            push[FxToken](&toks, fx_mk(k, slice, line));
            expect_trit_type = 0;
        } else if ((c == 34)) {
            let start: i32 = i;
            i = (i + 1);
            while (((i < n) && (fx_ch(src, i) != 34))) {
                if (((fx_ch(src, i) == 92) && ((i + 1) < n))) {
                    i = (i + 2);
                } else {
                    i = (i + 1);
                }
            }
            i = (i + 1);
            push[FxToken](&toks, fx_mk(fx_str(), src[start..i], line));
            expect_trit_type = 0;
        } else if ((c == 39)) {
            i = (i + 1);
            let cv: i32 = 0;
            if (((fx_ch(src, i) == 92) && ((i + 1) < n))) {
                i = (i + 1);
                let e: i32 = fx_ch(src, i);
                if ((e == 110)) {
                    cv = 10;
                } else if ((e == 116)) {
                    cv = 9;
                } else if ((e == 114)) {
                    cv = 13;
                } else if ((e == 48)) {
                    cv = 0;
                } else {
                    cv = e;
                }
                i = (i + 1);
            } else {
                cv = fx_ch(src, i);
                i = (i + 1);
            }
            if (((i < n) && (fx_ch(src, i) == 39))) {
                i = (i + 1);
            }
            push[FxToken](&toks, fx_mk(fx_int(), _zag_i64_to_str((cv) as i64), line));
            expect_trit_type = 0;
        } else if ((((c == 46) && ((i + 1) < n)) && (fx_ch(src, (i + 1)) == 46))) {
            push[FxToken](&toks, fx_mk(fx_dotdot(), src[i..(i + 2)], line));
            i = (i + 2);
            expect_trit_type = 0;
        } else if ((fx_is_two_op(src, i, n) == 1)) {
            push[FxToken](&toks, fx_mk(fx_op(), src[i..(i + 2)], line));
            in_trit_rhs = 0;
            expect_trit_type = 0;
            i = (i + 2);
        } else {
            let pk: i32 = fx_punct_kind(c);
            let one: []u8 = src[i..(i + 1)];
            let tok_kind: i32 = pk;
            if (((pk == fx_op()) && (fx_is_single_op(c) == 0))) {
                tok_kind = fx_err();
            }
            push[FxToken](&toks, fx_mk(tok_kind, one, line));
            if ((pk == fx_colon())) {
                expect_trit_type = 1;
            } else if ((pk == fx_semi())) {
                in_trit_rhs = 0;
                expect_trit_type = 0;
            } else if (((pk == fx_op()) && (c == 61))) {
                if ((expect_trit_type == 2)) {
                    in_trit_rhs = 1;
                } else {
                    in_trit_rhs = 0;
                }
                expect_trit_type = 0;
            } else {
                expect_trit_type = 0;
            }
            i = (i + 1);
        }
    }
    push[FxToken](&toks, fx_mk(fx_eof(), src[0..0], line));
    return toks;
}

struct FNode {
    code: i32,
    line: i32,
    text: []u8,
    ty: []u8,
    a: i32,
    b: i32,
    c: i32,
    flag: i32,
    flag2: i32,
    kids: ArrayList[i32],
    kids2: ArrayList[i32],
    names: ArrayList[[]u8],
    names2: ArrayList[[]u8],
    types: ArrayList[[]u8],
}

struct FPr {
    toks: ArrayList[FxToken],
    i: i32,
    err: i32,
    pool: *ArrayList[FNode],
}

struct FpResult {
    decls: ArrayList[i32],
    err: i32,
}

fn fn_blank(code: i32, line: i32) FNode {
    return FNode{ .code = code, .line = line, .text = "", .ty = "", .a = 0, .b = 0, .c = 0, .flag = 0, .flag2 = 0, .kids = make[i32](2), .kids2 = make[i32](2), .names = make[[]u8](2), .names2 = make[[]u8](2), .types = make[[]u8](2) };
}

fn fpp_push(p: *FPr, n: FNode) i32 {
    push[FNode](p.*.pool, n);
    return (len[FNode](p.*.pool.*) - 1);
}

fn fpp_mk_leaf(p: *FPr, code: i32, text: []u8) i32 {
    let n: FNode = fn_blank(code, 0);
    n.text = text;
    return fpp_push(p, n);
}

fn fpp_cur(p: *FPr) FxToken {
    return get[FxToken](p.*.toks, p.*.i);
}

fn fpp_at(p: *FPr, kind: i32) i32 {
    if ((fpp_cur(p).kind == kind)) {
        return 1;
    }
    return 0;
}

fn fpp_at_op(p: *FPr, s: []u8) i32 {
    let t: FxToken = fpp_cur(p);
    if (((t.kind == fx_op()) && (@strEq(t.text, s) == 1))) {
        return 1;
    }
    return 0;
}

fn fpp_err_at(p: *FPr, msg: []u8, line: i32) void {
    _zag_print("flashc1 parse error (line ");
    _zag_print(_zag_i64_to_str((line) as i64));
    _zag_print("): ");
    _zag_println(msg);
    p.*.err = 1;
}

fn fpp_adv(p: *FPr) FxToken {
    let t: FxToken = fpp_cur(p);
    if ((t.kind == fx_err())) {
        fpp_err_at(p, "invalid character in source", t.line);
    }
    p.*.i = (p.*.i + 1);
    return t;
}

fn fpp_eat_semi(p: *FPr) void {
    if ((fpp_at(p, fx_semi()) == 1)) {
        let _t: FxToken = fpp_adv(p);
    }
}

fn fpp_eat_pub(p: *FPr) i32 {
    if ((fpp_at(p, fx_kw_pub()) == 1)) {
        let _t: FxToken = fpp_adv(p);
        return 1;
    }
    return 0;
}

fn fpp_is_error_kw(p: *FPr) i32 {
    if ((fpp_at(p, fx_kw_error()) == 1)) {
        return 1;
    }
    let t: FxToken = fpp_cur(p);
    if ((@strEq(t.text, "error") == 1)) {
        return 1;
    }
    return 0;
}

fn fpp_parse_type(p: *FPr) []u8 {
    if ((fpp_at_op(p, "*") == 1)) {
        let _t: FxToken = fpp_adv(p);
        return _zag_str_concat("*", fpp_parse_type(p));
    }
    if ((fpp_at_op(p, "?") == 1)) {
        let _t: FxToken = fpp_adv(p);
        return _zag_str_concat("?", fpp_parse_type(p));
    }
    if ((fpp_at_op(p, "!") == 1)) {
        let _t: FxToken = fpp_adv(p);
        return _zag_str_concat("!", fpp_parse_type(p));
    }
    if ((fpp_at(p, fx_lbracket()) == 1)) {
        let _o: FxToken = fpp_adv(p);
        let _c: FxToken = fpp_adv(p);
        return _zag_str_concat("[]", fpp_parse_type(p));
    }
    let nm: []u8 = fpp_adv(p).text;
    if ((fpp_at(p, fx_lbracket()) == 1)) {
        let _ob: FxToken = fpp_adv(p);
        let s: []u8 = _zag_str_concat(nm, "[");
        let count: i32 = 0;
        while ((fpp_at(p, fx_rbracket()) == 0)) {
            if ((count > 0)) {
                s = _zag_str_concat(s, ",");
            }
            s = _zag_str_concat(s, fpp_parse_type(p));
            count = (count + 1);
            if ((fpp_at(p, fx_comma()) == 1)) {
                let _cm: FxToken = fpp_adv(p);
            }
        }
        let _rb: FxToken = fpp_adv(p);
        return _zag_str_concat(s, "]");
    }
    return nm;
}

fn fpp_prec(op: []u8) i32 {
    if ((@strEq(op, "||") == 1)) {
        return 1;
    }
    if ((@strEq(op, "&&") == 1)) {
        return 2;
    }
    if (((@strEq(op, "==") == 1) || (@strEq(op, "!=") == 1))) {
        return 3;
    }
    if (((((@strEq(op, "<") == 1) || (@strEq(op, ">") == 1)) || (@strEq(op, "<=") == 1)) || (@strEq(op, ">=") == 1))) {
        return 4;
    }
    if (((@strEq(op, "+") == 1) || (@strEq(op, "-") == 1))) {
        return 5;
    }
    if ((((@strEq(op, "*") == 1) || (@strEq(op, "/") == 1)) || (@strEq(op, "%") == 1))) {
        return 6;
    }
    return 0;
}

fn fpp_expr(p: *FPr) i32 {
    let e: i32 = fpp_bin(p, 1);
    if ((fpp_at(p, fx_kw_orelse()) == 1)) {
        let _o: FxToken = fpp_adv(p);
        let n: FNode = fn_blank(16, 0);
        n.text = "orelse";
        n.a = e;
        n.b = fpp_bin(p, 1);
        return fpp_push(p, n);
    }
    return e;
}

fn fpp_bin(p: *FPr, min: i32) i32 {
    let left: i32 = fpp_unary(p);
    let go: i32 = 1;
    while ((go == 1)) {
        if ((fpp_at(p, fx_op()) == 1)) {
            let op: []u8 = fpp_cur(p).text;
            let prec: i32 = fpp_prec(op);
            if (((prec > 0) && (prec >= min))) {
                let _t: FxToken = fpp_adv(p);
                let right: i32 = fpp_bin(p, (prec + 1));
                let n: FNode = fn_blank(16, 0);
                n.text = op;
                n.a = left;
                n.b = right;
                left = fpp_push(p, n);
            } else {
                go = 0;
            }
        } else {
            go = 0;
        }
    }
    return left;
}

fn fpp_unary(p: *FPr) i32 {
    if ((fpp_at(p, fx_kw_try()) == 1)) {
        let _t: FxToken = fpp_adv(p);
        let e: i32 = fpp_unary(p);
        let n: FNode = fn_blank(17, 0);
        n.text = "try";
        n.a = e;
        return fpp_push(p, n);
    }
    if ((((fpp_at_op(p, "-") == 1) || (fpp_at_op(p, "!") == 1)) || (fpp_at_op(p, "&") == 1))) {
        let op: []u8 = fpp_adv(p).text;
        let e: i32 = fpp_unary(p);
        let n: FNode = fn_blank(17, 0);
        n.text = op;
        n.a = e;
        return fpp_push(p, n);
    }
    return fpp_postfix(p);
}

fn fpp_matching_bracket(p: *FPr, open: i32) i32 {
    let depth: i32 = 0;
    let k: i32 = open;
    let n: i32 = len[FxToken](p.*.toks);
    while ((k < n)) {
        let kc: i32 = get[FxToken](p.*.toks, k).kind;
        if ((kc == fx_lbracket())) {
            depth = (depth + 1);
        } else if ((kc == fx_rbracket())) {
            depth = (depth - 1);
            if ((depth == 0)) {
                return k;
            }
        }
        k = (k + 1);
    }
    return -1;
}

fn fpp_kind_at(p: *FPr, idx: i32) i32 {
    if (((idx < 0) || (idx >= len[FxToken](p.*.toks)))) {
        return fx_eof();
    }
    return get[FxToken](p.*.toks, idx).kind;
}

fn fpp_call_args(p: *FPr, n: *FNode) void {
    let _o: FxToken = fpp_adv(p);
    while ((fpp_at(p, fx_rp()) == 0)) {
        push[i32](&n.*.kids, fpp_expr(p));
        if ((fpp_at(p, fx_comma()) == 1)) {
            let _c: FxToken = fpp_adv(p);
        }
    }
    let _r: FxToken = fpp_adv(p);
}

fn fpp_postfix(p: *FPr) i32 {
    let e: i32 = fpp_primary(p);
    let go: i32 = 1;
    while ((go == 1)) {
        if (((fpp_at(p, fx_ident()) == 1) && (@strEq(fpp_cur(p).text, "as") == 1))) {
            let _as: FxToken = fpp_adv(p);
            let n: FNode = fn_blank(19, 0);
            n.a = e;
            n.text = fpp_parse_type(p);
            e = fpp_push(p, n);
        } else if ((fpp_at(p, fx_lp()) == 1)) {
            let n: FNode = fn_blank(18, 0);
            n.a = e;
            fpp_call_args(p, &n);
            e = fpp_push(p, n);
        } else if ((fpp_at(p, fx_lbracket()) == 1)) {
            let close: i32 = fpp_matching_bracket(p, p.*.i);
            if ((fpp_kind_at(p, (close + 1)) == fx_lp())) {
                let n: FNode = fn_blank(18, 0);
                n.a = e;
                let _ob: FxToken = fpp_adv(p);
                while ((fpp_at(p, fx_rbracket()) == 0)) {
                    push[[]u8](&n.names, fpp_parse_type(p));
                    if ((fpp_at(p, fx_comma()) == 1)) {
                        let _c: FxToken = fpp_adv(p);
                    }
                }
                let _rb: FxToken = fpp_adv(p);
                fpp_call_args(p, &n);
                e = fpp_push(p, n);
            } else {
                let _o: FxToken = fpp_adv(p);
                let lo: i32 = fpp_expr(p);
                if ((fpp_at(p, fx_dotdot()) == 1)) {
                    let _dd: FxToken = fpp_adv(p);
                    let n: FNode = fn_blank(26, 0);
                    n.a = e;
                    n.b = lo;
                    if ((fpp_at(p, fx_rbracket()) == 0)) {
                        n.c = fpp_expr(p);
                        n.flag = 1;
                    }
                    let _r: FxToken = fpp_adv(p);
                    e = fpp_push(p, n);
                } else {
                    let _r: FxToken = fpp_adv(p);
                    let n: FNode = fn_blank(21, 0);
                    n.a = e;
                    n.b = lo;
                    e = fpp_push(p, n);
                }
            }
        } else if ((fpp_at(p, fx_dot()) == 1)) {
            let _d: FxToken = fpp_adv(p);
            let n: FNode = fn_blank(20, 0);
            n.a = e;
            n.text = fpp_adv(p).text;
            e = fpp_push(p, n);
        } else {
            go = 0;
        }
    }
    return e;
}

fn fpp_struct_lit(p: *FPr, name: []u8) i32 {
    let _o: FxToken = fpp_adv(p);
    let n: FNode = fn_blank(22, 0);
    n.text = name;
    while ((fpp_at(p, fx_rbrace()) == 0)) {
        let _dot: FxToken = fpp_adv(p);
        push[[]u8](&n.names, fpp_adv(p).text);
        let _eq: FxToken = fpp_adv(p);
        push[i32](&n.kids, fpp_expr(p));
        if ((fpp_at(p, fx_comma()) == 1)) {
            let _c: FxToken = fpp_adv(p);
        }
    }
    let _r: FxToken = fpp_adv(p);
    return fpp_push(p, n);
}

fn fpp_arm_body(p: *FPr) ArrayList[i32] {
    if ((fpp_at(p, fx_lbrace()) == 1)) {
        return fpp_block(p);
    }
    let body: ArrayList[i32] = make[i32](1);
    let e: i32 = fpp_expr(p);
    let n: FNode = fn_blank(8, 0);
    n.a = e;
    push[i32](&body, fpp_push(p, n));
    if ((fpp_at(p, fx_comma()) == 1)) {
        let _c: FxToken = fpp_adv(p);
    }
    return body;
}

fn fpp_parse_switch(p: *FPr) i32 {
    let _sw: FxToken = fpp_adv(p);
    let _o: FxToken = fpp_adv(p);
    let n: FNode = fn_blank(9, 0);
    n.a = fpp_expr(p);
    let _c: FxToken = fpp_adv(p);
    let _lb: FxToken = fpp_adv(p);
    while (((fpp_at(p, fx_rbrace()) == 0) && (fpp_at(p, fx_eof()) == 0))) {
        if ((fpp_at(p, fx_kw_else()) == 1)) {
            let _e: FxToken = fpp_adv(p);
            let _arrow: FxToken = fpp_adv(p);
            n.kids2 = fpp_arm_body(p);
            n.flag = 1;
        } else {
            let arm: FNode = fn_blank(90, 0);
            let more: i32 = 1;
            while ((more == 1)) {
                if ((fpp_at(p, fx_dot()) == 1)) {
                    let _dot: FxToken = fpp_adv(p);
                }
                push[[]u8](&arm.names, fpp_adv(p).text);
                if ((fpp_at(p, fx_comma()) == 1)) {
                    let _cm: FxToken = fpp_adv(p);
                } else {
                    more = 0;
                }
            }
            let _arrow: FxToken = fpp_adv(p);
            if ((fpp_at(p, fx_pipe()) == 1)) {
                let _p1: FxToken = fpp_adv(p);
                arm.text = fpp_adv(p).text;
                arm.flag = 1;
                let _p2: FxToken = fpp_adv(p);
            }
            arm.kids = fpp_arm_body(p);
            push[i32](&n.kids, fpp_push(p, arm));
        }
    }
    let _rb: FxToken = fpp_adv(p);
    return fpp_push(p, n);
}

fn fpp_primary(p: *FPr) i32 {
    if ((fpp_at(p, fx_kw_switch()) == 1)) {
        return fpp_parse_switch(p);
    }
    if ((fpp_at(p, fx_tritlit()) == 1)) {
        return fpp_mk_leaf(p, 11, fpp_adv(p).text);
    }
    if ((fpp_at(p, fx_int()) == 1)) {
        return fpp_mk_leaf(p, 12, fpp_adv(p).text);
    }
    if ((fpp_at(p, fx_float()) == 1)) {
        return fpp_mk_leaf(p, 13, fpp_adv(p).text);
    }
    if ((fpp_at(p, fx_str()) == 1)) {
        return fpp_mk_leaf(p, 14, fpp_adv(p).text);
    }
    if ((fpp_at(p, fx_kw_true()) == 1)) {
        let _t: FxToken = fpp_adv(p);
        return fpp_mk_leaf(p, 12, "1");
    }
    if ((fpp_at(p, fx_kw_false()) == 1)) {
        let _t: FxToken = fpp_adv(p);
        return fpp_mk_leaf(p, 12, "0");
    }
    if ((fpp_at(p, fx_annot()) == 1)) {
        return fpp_mk_leaf(p, 15, fpp_adv(p).text);
    }
    if ((fpp_at(p, fx_kw_null()) == 1)) {
        let _t: FxToken = fpp_adv(p);
        return fpp_mk_leaf(p, 15, "null");
    }
    if ((fpp_is_error_kw(p) == 1)) {
        let _t: FxToken = fpp_adv(p);
        return fpp_mk_leaf(p, 15, "error");
    }
    if (((fpp_at(p, fx_ident()) == 1) || (fpp_at(p, fx_type()) == 1))) {
        let name: []u8 = fpp_adv(p).text;
        if ((fpp_at(p, fx_lbracket()) == 1)) {
            let close: i32 = fpp_matching_bracket(p, p.*.i);
            if (((close >= 0) && (fpp_kind_at(p, (close + 1)) == fx_lbrace()))) {
                let n: FNode = fn_blank(22, 0);
                n.text = name;
                let _ob: FxToken = fpp_adv(p);
                while ((fpp_at(p, fx_rbracket()) == 0)) {
                    push[[]u8](&n.names2, fpp_adv(p).text);
                    if ((fpp_at(p, fx_comma()) == 1)) {
                        let _c: FxToken = fpp_adv(p);
                    }
                }
                let _rb: FxToken = fpp_adv(p);
                let _lb: FxToken = fpp_adv(p);
                while ((fpp_at(p, fx_rbrace()) == 0)) {
                    let _dot: FxToken = fpp_adv(p);
                    push[[]u8](&n.names, fpp_adv(p).text);
                    let _eq: FxToken = fpp_adv(p);
                    push[i32](&n.kids, fpp_expr(p));
                    if ((fpp_at(p, fx_comma()) == 1)) {
                        let _cm: FxToken = fpp_adv(p);
                    }
                }
                let _rb2: FxToken = fpp_adv(p);
                return fpp_push(p, n);
            }
        }
        if ((fpp_at(p, fx_lbrace()) == 1)) {
            return fpp_struct_lit(p, name);
        }
        return fpp_mk_leaf(p, 15, name);
    }
    if ((fpp_at(p, fx_lp()) == 1)) {
        let _o: FxToken = fpp_adv(p);
        let e: i32 = fpp_expr(p);
        let _c: FxToken = fpp_adv(p);
        return e;
    }
    return fpp_mk_leaf(p, 15, fpp_adv(p).text);
}

fn fpp_block(p: *FPr) ArrayList[i32] {
    let _o: FxToken = fpp_adv(p);
    let stmts: ArrayList[i32] = make[i32](8);
    while (((fpp_at(p, fx_rbrace()) == 0) && (fpp_at(p, fx_eof()) == 0))) {
        push[i32](&stmts, fpp_stmt(p));
    }
    let _c: FxToken = fpp_adv(p);
    return stmts;
}

fn fpp_stmt(p: *FPr) i32 {
    if ((fpp_at(p, fx_kw_switch()) == 1)) {
        return fpp_parse_switch(p);
    }
    if ((fpp_at(p, fx_kw_let()) == 1)) {
        let _t: FxToken = fpp_adv(p);
        let n: FNode = fn_blank(2, 0);
        n.text = fpp_adv(p).text;
        if ((fpp_at(p, fx_colon()) == 1)) {
            let _c: FxToken = fpp_adv(p);
            n.ty = fpp_parse_type(p);
            n.flag = 1;
        }
        if ((fpp_at_op(p, "=") == 1)) {
            let _eq: FxToken = fpp_adv(p);
            n.a = fpp_expr(p);
            n.flag2 = 1;
        }
        fpp_eat_semi(p);
        return fpp_push(p, n);
    }
    if ((fpp_at(p, fx_kw_return()) == 1)) {
        let _t: FxToken = fpp_adv(p);
        let n: FNode = fn_blank(3, 0);
        if ((fpp_at(p, fx_semi()) == 0)) {
            n.a = fpp_expr(p);
            n.flag2 = 1;
        }
        fpp_eat_semi(p);
        return fpp_push(p, n);
    }
    if ((fpp_at(p, fx_kw_if()) == 1)) {
        let _t: FxToken = fpp_adv(p);
        let _o: FxToken = fpp_adv(p);
        let n: FNode = fn_blank(4, 0);
        n.a = fpp_expr(p);
        let _c: FxToken = fpp_adv(p);
        if ((fpp_at(p, fx_pipe()) == 1)) {
            let _p1: FxToken = fpp_adv(p);
            n.text = fpp_adv(p).text;
            n.flag2 = 1;
            let _p2: FxToken = fpp_adv(p);
        }
        n.kids = fpp_block(p);
        if ((fpp_at(p, fx_kw_else()) == 1)) {
            let _e: FxToken = fpp_adv(p);
            n.flag = 1;
            if ((fpp_at(p, fx_kw_if()) == 1)) {
                push[i32](&n.kids2, fpp_stmt(p));
            } else {
                n.kids2 = fpp_block(p);
            }
        }
        return fpp_push(p, n);
    }
    if ((fpp_at(p, fx_kw_while()) == 1)) {
        let _t: FxToken = fpp_adv(p);
        let _o: FxToken = fpp_adv(p);
        let n: FNode = fn_blank(5, 0);
        n.a = fpp_expr(p);
        let _c: FxToken = fpp_adv(p);
        n.kids = fpp_block(p);
        return fpp_push(p, n);
    }
    let e: i32 = fpp_expr(p);
    if ((fpp_at_op(p, "=") == 1)) {
        let _eq: FxToken = fpp_adv(p);
        let n: FNode = fn_blank(7, 0);
        n.a = e;
        n.b = fpp_expr(p);
        fpp_eat_semi(p);
        return fpp_push(p, n);
    }
    fpp_eat_semi(p);
    let n: FNode = fn_blank(8, 0);
    n.a = e;
    return fpp_push(p, n);
}

fn fpp_parse_fn(p: *FPr) i32 {
    let is_pub: i32 = fpp_eat_pub(p);
    let is_extern: i32 = 0;
    if ((fpp_at(p, fx_kw_extern()) == 1)) {
        let _e: FxToken = fpp_adv(p);
        is_extern = 1;
    }
    let ftok: FxToken = fpp_adv(p);
    let n: FNode = fn_blank(1, ftok.line);
    n.flag = is_pub;
    n.flag2 = is_extern;
    let recv_name: []u8 = "";
    let recv_ty: []u8 = "";
    let is_method: i32 = 0;
    if ((fpp_at(p, fx_lp()) == 1)) {
        let _rp1: FxToken = fpp_adv(p);
        recv_name = fpp_adv(p).text;
        let _rc: FxToken = fpp_adv(p);
        recv_ty = fpp_parse_type(p);
        let _rp2: FxToken = fpp_adv(p);
        is_method = 1;
    }
    let bare: []u8 = fpp_adv(p).text;
    n.text = bare;
    if ((is_method == 1)) {
        n.text = _zag_str_concat(_zag_str_concat(recv_ty, "_"), bare);
    }
    if ((fpp_at(p, fx_lbracket()) == 1)) {
        let _ob: FxToken = fpp_adv(p);
        while ((fpp_at(p, fx_rbracket()) == 0)) {
            push[[]u8](&n.names2, fpp_adv(p).text);
            if ((fpp_at(p, fx_comma()) == 1)) {
                let _c: FxToken = fpp_adv(p);
            }
        }
        let _rb: FxToken = fpp_adv(p);
    }
    let _o: FxToken = fpp_adv(p);
    if ((is_method == 1)) {
        push[[]u8](&n.names, recv_name);
        push[[]u8](&n.types, recv_ty);
    }
    while ((fpp_at(p, fx_rp()) == 0)) {
        push[[]u8](&n.names, fpp_adv(p).text);
        let _co: FxToken = fpp_adv(p);
        push[[]u8](&n.types, fpp_parse_type(p));
        if ((fpp_at(p, fx_comma()) == 1)) {
            let _c: FxToken = fpp_adv(p);
        }
    }
    let _r: FxToken = fpp_adv(p);
    n.ty = fpp_parse_type(p);
    if ((is_extern == 0)) {
        n.kids = fpp_block(p);
    } else {
        fpp_eat_semi(p);
    }
    return fpp_push(p, n);
}

fn fpp_parse_struct(p: *FPr) i32 {
    let is_pub: i32 = fpp_eat_pub(p);
    let stok: FxToken = fpp_adv(p);
    let n: FNode = fn_blank(30, stok.line);
    n.flag = is_pub;
    n.text = fpp_adv(p).text;
    if ((fpp_at(p, fx_lbracket()) == 1)) {
        let _ob: FxToken = fpp_adv(p);
        while ((fpp_at(p, fx_rbracket()) == 0)) {
            push[[]u8](&n.names2, fpp_adv(p).text);
            if ((fpp_at(p, fx_comma()) == 1)) {
                let _c: FxToken = fpp_adv(p);
            }
        }
        let _rb: FxToken = fpp_adv(p);
    }
    let _lb: FxToken = fpp_adv(p);
    while ((fpp_at(p, fx_rbrace()) == 0)) {
        push[[]u8](&n.names, fpp_adv(p).text);
        if ((fpp_at(p, fx_colon()) == 1)) {
            let _co: FxToken = fpp_adv(p);
            push[[]u8](&n.types, fpp_parse_type(p));
        } else {
            push[[]u8](&n.types, "void");
        }
        if ((fpp_at(p, fx_comma()) == 1)) {
            let _c: FxToken = fpp_adv(p);
        }
    }
    let _rb: FxToken = fpp_adv(p);
    return fpp_push(p, n);
}

fn fpp_parse_enum(p: *FPr) i32 {
    let is_pub: i32 = fpp_eat_pub(p);
    let etok: FxToken = fpp_adv(p);
    let n: FNode = fn_blank(31, etok.line);
    n.flag = is_pub;
    n.text = fpp_adv(p).text;
    let _lb: FxToken = fpp_adv(p);
    while (((fpp_at(p, fx_rbrace()) == 0) && (fpp_at(p, fx_eof()) == 0))) {
        push[[]u8](&n.names, fpp_adv(p).text);
        if ((fpp_at(p, fx_comma()) == 1)) {
            let _c: FxToken = fpp_adv(p);
        }
    }
    let _rb: FxToken = fpp_adv(p);
    return fpp_push(p, n);
}

fn fpp_parse_union(p: *FPr) i32 {
    let utok: FxToken = fpp_adv(p);
    let n: FNode = fn_blank(32, utok.line);
    n.text = fpp_adv(p).text;
    let _lb: FxToken = fpp_adv(p);
    while (((fpp_at(p, fx_rbrace()) == 0) && (fpp_at(p, fx_eof()) == 0))) {
        push[[]u8](&n.names, fpp_adv(p).text);
        if ((fpp_at(p, fx_colon()) == 1)) {
            let _co: FxToken = fpp_adv(p);
            push[[]u8](&n.types, fpp_parse_type(p));
        } else {
            push[[]u8](&n.types, "void");
        }
        if ((fpp_at(p, fx_comma()) == 1)) {
            let _c: FxToken = fpp_adv(p);
        }
    }
    let _rb: FxToken = fpp_adv(p);
    return fpp_push(p, n);
}

fn fpp_strip_quotes(s: []u8) []u8 {
    if ((s.len >= 2)) {
        return s[1..(s.len - 1)];
    }
    return s;
}

fn fpp_parse_error(p: *FPr) i32 {
    let etok: FxToken = fpp_adv(p);
    let n: FNode = fn_blank(33, etok.line);
    n.text = "__flash_errors";
    if ((fpp_at(p, fx_lbrace()) == 1)) {
        let _lb: FxToken = fpp_adv(p);
        while ((fpp_at(p, fx_rbrace()) == 0)) {
            push[[]u8](&n.names, fpp_adv(p).text);
            if ((fpp_at(p, fx_comma()) == 1)) {
                let _c: FxToken = fpp_adv(p);
            }
        }
        let _rb: FxToken = fpp_adv(p);
        fpp_eat_semi(p);
    } else {
        push[[]u8](&n.names, fpp_adv(p).text);
        fpp_eat_semi(p);
    }
    return fpp_push(p, n);
}

fn fpp_parse_import(p: *FPr) i32 {
    let itok: FxToken = fpp_adv(p);
    let n: FNode = fn_blank(10, itok.line);
    let _lp: FxToken = fpp_adv(p);
    n.text = fpp_strip_quotes(fpp_adv(p).text);
    let _rp: FxToken = fpp_adv(p);
    if (((fpp_at(p, fx_ident()) == 1) && (@strEq(fpp_cur(p).text, "as") == 1))) {
        let _as: FxToken = fpp_adv(p);
        n.ty = fpp_adv(p).text;
        n.flag = 1;
    }
    fpp_eat_semi(p);
    return fpp_push(p, n);
}

fn fpp_parse_into(src: []u8, pool: *ArrayList[FNode]) FpResult {
    let toks: ArrayList[FxToken] = flex(src);
    let p: FPr = FPr{ .toks = toks, .i = 0, .err = 0, .pool = pool };
    let decls: ArrayList[i32] = make[i32](16);
    while ((fpp_at(&p, fx_eof()) == 0)) {
        if ((fpp_at(&p, fx_err()) == 1)) {
            let bad: FxToken = fpp_adv(&p);
            fpp_err_at(&p, "invalid character in source", bad.line);
        } else if (((fpp_at(&p, fx_annot()) == 1) && (@strEq(fpp_cur(&p).text, "@import") == 1))) {
            push[i32](&decls, fpp_parse_import(&p));
        } else if ((fpp_at(&p, fx_kw_pub()) == 1)) {
            let nk: i32 = fpp_kind_at(&p, (p.i + 1));
            if ((nk == fx_kw_struct())) {
                push[i32](&decls, fpp_parse_struct(&p));
            } else if ((nk == fx_kw_enum())) {
                push[i32](&decls, fpp_parse_enum(&p));
            } else if (((nk == fx_kw_fn()) || (nk == fx_kw_extern()))) {
                push[i32](&decls, fpp_parse_fn(&p));
            } else {
                let bad: FxToken = fpp_adv(&p);
                fpp_err_at(&p, "pub must prefix fn, extern fn, struct, or enum", bad.line);
            }
        } else if ((fpp_is_error_kw(&p) == 1)) {
            push[i32](&decls, fpp_parse_error(&p));
        } else if ((fpp_at(&p, fx_kw_struct()) == 1)) {
            push[i32](&decls, fpp_parse_struct(&p));
        } else if ((fpp_at(&p, fx_kw_enum()) == 1)) {
            push[i32](&decls, fpp_parse_enum(&p));
        } else if ((fpp_at(&p, fx_kw_union()) == 1)) {
            push[i32](&decls, fpp_parse_union(&p));
        } else if (((fpp_at(&p, fx_kw_extern()) == 1) || (fpp_at(&p, fx_kw_fn()) == 1))) {
            push[i32](&decls, fpp_parse_fn(&p));
        } else {
            let bad: FxToken = fpp_adv(&p);
            fpp_err_at(&p, "unsupported top-level declaration in stage-1", bad.line);
        }
    }
    return FpResult{ .decls = decls, .err = p.err };
}

fn fe_app(out: *ArrayList[u8], s: []u8) void {
    let i: i32 = 0;
    while ((i < s.len)) {
        push[u8](out, s[i]);
        i = (i + 1);
    }
}

fn fe_indent(out: *ArrayList[u8], depth: i32) void {
    let i: i32 = 0;
    while ((i < depth)) {
        fe_app(out, "    ");
        i = (i + 1);
    }
}

fn fe_at(pool: *ArrayList[FNode], idx: i32) FNode {
    return get[FNode](pool.*, idx);
}

fn fe_t_width(ty: []u8) i32 {
    if ((ty.len < 2)) {
        return 0;
    }
    if (((ty[0]) as i32 != 116)) {
        return 0;
    }
    let w: i32 = 0;
    let i: i32 = 1;
    while ((i < ty.len)) {
        let c: i32 = (ty[i]) as i32;
        if (((c < 48) || (c > 57))) {
            return 0;
        }
        w = ((w * 10) + (c - 48));
        if ((w > 127)) {
            return 0;
        }
        i = (i + 1);
    }
    return w;
}

fn fe_type(ty: []u8) []u8 {
    if ((@strEq(ty, "trit") == 1)) {
        return "Trit";
    }
    if ((@strEq(ty, "wave") == 1)) {
        return "Wave";
    }
    if ((@strEq(ty, "beam") == 1)) {
        return "Beam";
    }
    if ((@strEq(ty, "phase") == 1)) {
        return "Phase";
    }
    let tw: i32 = fe_t_width(ty);
    if (((tw >= 1) && (tw <= 40))) {
        return "i64";
    }
    return ty;
}

fn fe_trit_lit(text: []u8) []u8 {
    if ((@strEq(text, "T") == 1)) {
        return "trit(-1)";
    }
    if ((@strEq(text, "+1") == 1)) {
        return "trit(1)";
    }
    if ((@strEq(text, "-1") == 1)) {
        return "trit(-1)";
    }
    if ((@strEq(text, "0") == 1)) {
        return "trit(0)";
    }
    if ((@strEq(text, "1") == 1)) {
        return "trit(1)";
    }
    return _zag_str_concat(_zag_str_concat("trit(", text), ")");
}

fn fe_targs_str(targs: ArrayList[[]u8]) []u8 {
    let s: []u8 = "[";
    let i: i32 = 0;
    while ((i < len[[]u8](targs))) {
        if ((i > 0)) {
            s = _zag_str_concat(s, ", ");
        }
        s = _zag_str_concat(s, fe_type(get[[]u8](targs, i)));
        i = (i + 1);
    }
    return _zag_str_concat(s, "]");
}

fn fe_expr(pool: *ArrayList[FNode], idx: i32) []u8 {
    let n: FNode = fe_at(pool, idx);
    if ((n.code == 11)) {
        return fe_trit_lit(n.text);
    }
    if ((n.code == 12)) {
        return n.text;
    }
    if ((n.code == 13)) {
        return n.text;
    }
    if ((n.code == 14)) {
        return n.text;
    }
    if ((n.code == 15)) {
        return n.text;
    }
    if ((n.code == 16)) {
        let s: []u8 = _zag_str_concat("(", fe_expr(pool, n.a));
        s = _zag_str_concat(s, " ");
        s = _zag_str_concat(s, n.text);
        s = _zag_str_concat(s, " ");
        s = _zag_str_concat(s, fe_expr(pool, n.b));
        return _zag_str_concat(s, ")");
    }
    if ((n.code == 17)) {
        if ((@strEq(n.text, "-") == 1)) {
            let inner: FNode = fe_at(pool, n.a);
            if (((inner.code == 12) || (inner.code == 13))) {
                return _zag_str_concat("-", inner.text);
            }
            let s: []u8 = _zag_str_concat("(0 - ", fe_expr(pool, n.a));
            return _zag_str_concat(s, ")");
        }
        if ((@strEq(n.text, "!") == 1)) {
            let s: []u8 = _zag_str_concat("!(", fe_expr(pool, n.a));
            return _zag_str_concat(s, ")");
        }
        if ((@strEq(n.text, "&") == 1)) {
            return _zag_str_concat("&", fe_expr(pool, n.a));
        }
        if ((@strEq(n.text, "try") == 1)) {
            return _zag_str_concat("try ", fe_expr(pool, n.a));
        }
        return fe_expr(pool, n.a);
    }
    if ((n.code == 18)) {
        let s: []u8 = fe_expr(pool, n.a);
        if ((len[[]u8](n.names) > 0)) {
            s = _zag_str_concat(s, fe_targs_str(n.names));
        }
        s = _zag_str_concat(s, "(");
        let i: i32 = 0;
        while ((i < len[i32](n.kids))) {
            if ((i > 0)) {
                s = _zag_str_concat(s, ", ");
            }
            s = _zag_str_concat(s, fe_expr(pool, get[i32](n.kids, i)));
            i = (i + 1);
        }
        return _zag_str_concat(s, ")");
    }
    if ((n.code == 19)) {
        let s: []u8 = _zag_str_concat("(", fe_expr(pool, n.a));
        s = _zag_str_concat(s, ") as ");
        return _zag_str_concat(s, fe_type(n.text));
    }
    if ((n.code == 20)) {
        let s: []u8 = _zag_str_concat(fe_expr(pool, n.a), ".");
        return _zag_str_concat(s, n.text);
    }
    if ((n.code == 21)) {
        let s: []u8 = _zag_str_concat(fe_expr(pool, n.a), "[");
        s = _zag_str_concat(s, fe_expr(pool, n.b));
        return _zag_str_concat(s, "]");
    }
    if ((n.code == 26)) {
        let s: []u8 = _zag_str_concat(fe_expr(pool, n.a), "[");
        s = _zag_str_concat(s, fe_expr(pool, n.b));
        s = _zag_str_concat(s, "..");
        if ((n.flag == 1)) {
            s = _zag_str_concat(s, fe_expr(pool, n.c));
        }
        return _zag_str_concat(s, "]");
    }
    if ((n.code == 9)) {
        return fe_switch_expr(pool, n);
    }
    if ((n.code == 22)) {
        let s: []u8 = n.text;
        s = _zag_str_concat(s, "{");
        let i: i32 = 0;
        while ((i < len[i32](n.kids))) {
            if ((i > 0)) {
                s = _zag_str_concat(s, ",");
            }
            s = _zag_str_concat(s, " .");
            s = _zag_str_concat(s, get[[]u8](n.names, i));
            s = _zag_str_concat(s, " = ");
            s = _zag_str_concat(s, fe_expr(pool, get[i32](n.kids, i)));
            i = (i + 1);
        }
        return _zag_str_concat(s, " }");
    }
    return "0";
}

fn fe_arm_expr(pool: *ArrayList[FNode], body: ArrayList[i32]) []u8 {
    if ((len[i32](body) < 1)) {
        return "0";
    }
    let first: i32 = get[i32](body, 0);
    let n: FNode = fe_at(pool, first);
    if ((n.code == 8)) {
        return fe_expr(pool, n.a);
    }
    return fe_expr(pool, first);
}

fn fe_switch_expr(pool: *ArrayList[FNode], sw: FNode) []u8 {
    let s: []u8 = _zag_str_concat("switch (", fe_expr(pool, sw.a));
    s = _zag_str_concat(s, ") {");
    let ai: i32 = 0;
    while ((ai < len[i32](sw.kids))) {
        let arm: FNode = fe_at(pool, get[i32](sw.kids, ai));
        let ti: i32 = 0;
        while ((ti < len[[]u8](arm.names))) {
            if ((ti > 0)) {
                s = _zag_str_concat(s, ",");
            }
            s = _zag_str_concat(s, " .");
            s = _zag_str_concat(s, get[[]u8](arm.names, ti));
            ti = (ti + 1);
        }
        s = _zag_str_concat(s, " => ");
        if ((arm.flag == 1)) {
            s = _zag_str_concat(s, "|");
            s = _zag_str_concat(s, arm.text);
            s = _zag_str_concat(s, "| ");
        }
        s = _zag_str_concat(s, fe_arm_expr(pool, arm.kids));
        s = _zag_str_concat(s, ",");
        ai = (ai + 1);
    }
    if ((sw.flag == 1)) {
        s = _zag_str_concat(s, " else => ");
        s = _zag_str_concat(s, fe_arm_expr(pool, sw.kids2));
        s = _zag_str_concat(s, ",");
    }
    return _zag_str_concat(s, " }");
}

fn fe_switch_stmt(pool: *ArrayList[FNode], out: *ArrayList[u8], depth: i32, sw: FNode) i32 {
    let err: i32 = 0;
    fe_indent(out, depth);
    fe_app(out, "switch (");
    fe_app(out, fe_expr(pool, sw.a));
    fe_app(out, ") {\n");
    let ai: i32 = 0;
    while ((ai < len[i32](sw.kids))) {
        let arm: FNode = fe_at(pool, get[i32](sw.kids, ai));
        fe_indent(out, (depth + 1));
        let ti: i32 = 0;
        while ((ti < len[[]u8](arm.names))) {
            if ((ti > 0)) {
                fe_app(out, ", ");
            }
            fe_app(out, ".");
            fe_app(out, get[[]u8](arm.names, ti));
            ti = (ti + 1);
        }
        fe_app(out, " => ");
        if ((arm.flag == 1)) {
            fe_app(out, "|");
            fe_app(out, arm.text);
            fe_app(out, "| ");
        }
        fe_app(out, "{\n");
        err = (err + fe_stmts(pool, out, (depth + 2), arm.kids));
        fe_indent(out, (depth + 1));
        fe_app(out, "}\n");
        ai = (ai + 1);
    }
    if ((sw.flag == 1)) {
        fe_indent(out, (depth + 1));
        fe_app(out, "else => {\n");
        err = (err + fe_stmts(pool, out, (depth + 2), sw.kids2));
        fe_indent(out, (depth + 1));
        fe_app(out, "}\n");
    }
    fe_indent(out, depth);
    fe_app(out, "}\n");
    return err;
}

fn fe_let_fallback_ty(pool: *ArrayList[FNode], n: FNode) []u8 {
    if ((n.flag2 == 0)) {
        return "i32";
    }
    let e: FNode = fe_at(pool, n.a);
    if ((e.code == 11)) {
        return "Trit";
    }
    if ((e.code == 13)) {
        return "f32";
    }
    if ((e.code == 14)) {
        return "[]u8";
    }
    return "i32";
}

fn fe_stmts(pool: *ArrayList[FNode], out: *ArrayList[u8], depth: i32, body: ArrayList[i32]) i32 {
    let err: i32 = 0;
    let i: i32 = 0;
    while ((i < len[i32](body))) {
        err = (err + fe_stmt(pool, out, depth, get[i32](body, i)));
        i = (i + 1);
    }
    return err;
}

fn fe_if_chain(pool: *ArrayList[FNode], out: *ArrayList[u8], depth: i32, n: FNode) i32 {
    let err: i32 = 0;
    fe_app(out, "if (");
    fe_app(out, fe_expr(pool, n.a));
    fe_app(out, ") ");
    if ((n.flag2 == 1)) {
        fe_app(out, "|");
        fe_app(out, n.text);
        fe_app(out, "| ");
    }
    fe_app(out, "{\n");
    err = (err + fe_stmts(pool, out, (depth + 1), n.kids));
    fe_indent(out, depth);
    fe_app(out, "}");
    if ((n.flag == 1)) {
        fe_app(out, " else ");
        if ((len[i32](n.kids2) == 1)) {
            let first: FNode = fe_at(pool, get[i32](n.kids2, 0));
            if ((first.code == 4)) {
                err = (err + fe_if_chain(pool, out, depth, first));
                return err;
            }
        }
        fe_app(out, "{\n");
        err = (err + fe_stmts(pool, out, (depth + 1), n.kids2));
        fe_indent(out, depth);
        fe_app(out, "}\n");
        return err;
    }
    fe_app(out, "\n");
    return err;
}

fn fe_stmt(pool: *ArrayList[FNode], out: *ArrayList[u8], depth: i32, idx: i32) i32 {
    let n: FNode = fe_at(pool, idx);
    if ((n.code == 2)) {
        fe_indent(out, depth);
        fe_app(out, "let ");
        fe_app(out, n.text);
        fe_app(out, ": ");
        if ((n.flag == 1)) {
            fe_app(out, fe_type(n.ty));
        } else {
            fe_app(out, fe_let_fallback_ty(pool, n));
        }
        if ((n.flag2 == 1)) {
            fe_app(out, " = ");
            fe_app(out, fe_expr(pool, n.a));
        }
        fe_app(out, ";\n");
        return 0;
    }
    if ((n.code == 3)) {
        fe_indent(out, depth);
        if ((n.flag2 == 1)) {
            fe_app(out, "return ");
            fe_app(out, fe_expr(pool, n.a));
            fe_app(out, ";\n");
        } else {
            fe_app(out, "return;\n");
        }
        return 0;
    }
    if ((n.code == 4)) {
        fe_indent(out, depth);
        return fe_if_chain(pool, out, depth, n);
    }
    if ((n.code == 5)) {
        fe_indent(out, depth);
        fe_app(out, "while (");
        fe_app(out, fe_expr(pool, n.a));
        fe_app(out, ") {\n");
        let err: i32 = fe_stmts(pool, out, (depth + 1), n.kids);
        fe_indent(out, depth);
        fe_app(out, "}\n");
        return err;
    }
    if ((n.code == 7)) {
        fe_indent(out, depth);
        fe_app(out, fe_expr(pool, n.a));
        fe_app(out, " = ");
        fe_app(out, fe_expr(pool, n.b));
        fe_app(out, ";\n");
        return 0;
    }
    if ((n.code == 8)) {
        fe_indent(out, depth);
        fe_app(out, fe_expr(pool, n.a));
        fe_app(out, ";\n");
        return 0;
    }
    if ((n.code == 9)) {
        return fe_switch_stmt(pool, out, depth, n);
    }
    _zag_println("flashc1: unsupported statement in stage-1 full emitter");
    return 1;
}

fn fe_fn_decl(pool: *ArrayList[FNode], out: *ArrayList[u8], n: FNode) i32 {
    if ((n.flag == 1)) {
        fe_app(out, "pub ");
    }
    if ((n.flag2 == 1)) {
        fe_app(out, "extern ");
    }
    fe_app(out, "fn ");
    fe_app(out, n.text);
    if ((len[[]u8](n.names2) > 0)) {
        fe_app(out, fe_targs_str(n.names2));
    }
    fe_app(out, "(");
    let i: i32 = 0;
    while ((i < len[[]u8](n.names))) {
        if ((i > 0)) {
            fe_app(out, ", ");
        }
        fe_app(out, get[[]u8](n.names, i));
        fe_app(out, ": ");
        fe_app(out, fe_type(get[[]u8](n.types, i)));
        i = (i + 1);
    }
    fe_app(out, ") ");
    fe_app(out, fe_type(n.ty));
    if ((n.flag2 == 1)) {
        fe_app(out, ";\n\n");
        return 0;
    }
    fe_app(out, " {\n");
    let err: i32 = fe_stmts(pool, out, 1, n.kids);
    fe_app(out, "}\n\n");
    return err;
}

fn fe_struct_decl(out: *ArrayList[u8], n: FNode) i32 {
    if ((n.flag == 1)) {
        fe_app(out, "pub ");
    }
    fe_app(out, "struct ");
    fe_app(out, n.text);
    if ((len[[]u8](n.names2) > 0)) {
        fe_app(out, fe_targs_str(n.names2));
    }
    fe_app(out, " {\n");
    let i: i32 = 0;
    while ((i < len[[]u8](n.names))) {
        fe_app(out, "    ");
        fe_app(out, get[[]u8](n.names, i));
        fe_app(out, ": ");
        fe_app(out, fe_type(get[[]u8](n.types, i)));
        fe_app(out, ",\n");
        i = (i + 1);
    }
    fe_app(out, "}\n\n");
    return 0;
}

fn fe_enum_decl(out: *ArrayList[u8], n: FNode) i32 {
    if ((n.flag == 1)) {
        fe_app(out, "pub ");
    }
    fe_app(out, "enum ");
    fe_app(out, n.text);
    fe_app(out, " {\n    ");
    let i: i32 = 0;
    while ((i < len[[]u8](n.names))) {
        if ((i > 0)) {
            fe_app(out, ", ");
        }
        fe_app(out, get[[]u8](n.names, i));
        i = (i + 1);
    }
    fe_app(out, ",\n}\n\n");
    return 0;
}

fn fe_union_decl(out: *ArrayList[u8], n: FNode) i32 {
    fe_app(out, "union ");
    fe_app(out, n.text);
    fe_app(out, " {\n");
    let i: i32 = 0;
    while ((i < len[[]u8](n.names))) {
        fe_app(out, "    ");
        fe_app(out, get[[]u8](n.names, i));
        fe_app(out, ": ");
        fe_app(out, fe_type(get[[]u8](n.types, i)));
        fe_app(out, ",\n");
        i = (i + 1);
    }
    fe_app(out, "}\n\n");
    return 0;
}

fn fe_error_decl(out: *ArrayList[u8], n: FNode) i32 {
    fe_app(out, "enum __flash_errors {\n    ");
    let i: i32 = 0;
    while ((i < len[[]u8](n.names))) {
        if ((i > 0)) {
            fe_app(out, ", ");
        }
        fe_app(out, get[[]u8](n.names, i));
        i = (i + 1);
    }
    fe_app(out, ",\n}\n\n");
    return 0;
}

fn fe_import_decl(out: *ArrayList[u8], n: FNode) i32 {
    fe_app(out, "@import(\"");
    fe_app(out, n.text);
    fe_app(out, "\")");
    if ((n.flag == 1)) {
        fe_app(out, " as ");
        fe_app(out, n.ty);
    }
    fe_app(out, "\n");
    return 0;
}

fn fe_emit_decls(pool: *ArrayList[FNode], out: *ArrayList[u8], decls: ArrayList[i32]) i32 {
    let err: i32 = 0;
    let i: i32 = 0;
    while ((i < len[i32](decls))) {
        let n: FNode = fe_at(pool, get[i32](decls, i));
        if ((n.code == 1)) {
            err = (err + fe_fn_decl(pool, out, n));
        } else if ((n.code == 30)) {
            err = (err + fe_struct_decl(out, n));
        } else if ((n.code == 31)) {
            err = (err + fe_enum_decl(out, n));
        } else if ((n.code == 32)) {
            err = (err + fe_union_decl(out, n));
        } else if ((n.code == 33)) {
            err = (err + fe_error_decl(out, n));
        } else if ((n.code == 10)) {
            err = (err + fe_import_decl(out, n));
        } else {
            _zag_println("flashc1: unsupported declaration in stage-1 full emitter");
            err = (err + 1);
        }
        i = (i + 1);
    }
    return err;
}

fn fs_family_none() i32 {
    return 0;
}

fn fs_family_integer() i32 {
    return 1;
}

fn fs_family_posit() i32 {
    return 2;
}

fn fs_family_float() i32 {
    return 4;
}

fn fs_family_trit() i32 {
    return 8;
}

fn fs_family_wave() i32 {
    return 16;
}

fn fs_family_beam() i32 {
    return 32;
}

fn fs_family_phase() i32 {
    return 64;
}

fn fs_starts_with(t: []u8, prefix: []u8) i32 {
    if ((t.len < prefix.len)) {
        return 0;
    }
    let i: i32 = 0;
    while ((i < prefix.len)) {
        if ((t[i] != prefix[i])) {
            return 0;
        }
        i = (i + 1);
    }
    return 1;
}

fn fs_is_arb_int(t: []u8) i32 {
    if ((t.len < 2)) {
        return 0;
    }
    let c0: i32 = (t[0]) as i32;
    if (((c0 != 105) && (c0 != 117))) {
        return 0;
    }
    let i: i32 = 1;
    while ((i < t.len)) {
        let c: i32 = (t[i]) as i32;
        if (((c < 48) || (c > 57))) {
            return 0;
        }
        i = (i + 1);
    }
    return 1;
}

fn fs_is_posit(t: []u8) i32 {
    if (((@strEq(t, "p8") == 1) || (@strEq(t, "p16") == 1))) {
        return 1;
    }
    if (((@strEq(t, "p32") == 1) || (@strEq(t, "p64") == 1))) {
        return 1;
    }
    return 0;
}

fn fs_is_integer(t: []u8) i32 {
    if ((fs_is_arb_int(t) == 1)) {
        return 1;
    }
    if ((fs_starts_with(t, "sat_") == 1)) {
        return 1;
    }
    if ((fs_starts_with(t, "fixed_") == 1)) {
        return 1;
    }
    if (((@strEq(t, "u_any") == 1) || (@strEq(t, "i_any") == 1))) {
        return 1;
    }
    if ((@strEq(t, "u11") == 1)) {
        return 1;
    }
    if ((fs_starts_with(t, "rns_") == 1)) {
        return 1;
    }
    return 0;
}

fn fs_is_float(t: []u8) i32 {
    if ((((@strEq(t, "f16") == 1) || (@strEq(t, "f32") == 1)) || (@strEq(t, "f64") == 1))) {
        return 1;
    }
    if (((@strEq(t, "f80") == 1) || (@strEq(t, "f128") == 1))) {
        return 1;
    }
    if ((((@strEq(t, "bf16") == 1) || (@strEq(t, "mx_fp8") == 1)) || (@strEq(t, "mx_fp4") == 1))) {
        return 1;
    }
    return 0;
}

fn fs_is_trit_unit(t: []u8) i32 {
    if ((t.len < 2)) {
        return 0;
    }
    if (((t[0]) as i32 != 116)) {
        return 0;
    }
    let i: i32 = 1;
    while ((i < t.len)) {
        let c: i32 = (t[i]) as i32;
        if (((c < 48) || (c > 57))) {
            return 0;
        }
        i = (i + 1);
    }
    return 1;
}

fn fs_is_trit(t: []u8) i32 {
    if (((@strEq(t, "trit") == 1) || (@strEq(t, "Trit") == 1))) {
        return 1;
    }
    if ((@strEq(t, "trit.Trit") == 1)) {
        return 1;
    }
    if ((fs_is_trit_unit(t) == 1)) {
        return 1;
    }
    return 0;
}

fn fs_is_wave(t: []u8) i32 {
    if (((@strEq(t, "wave") == 1) || (@strEq(t, "Wave") == 1))) {
        return 1;
    }
    if ((@strEq(t, "wave.Wave") == 1)) {
        return 1;
    }
    return 0;
}

fn fs_is_beam(t: []u8) i32 {
    if (((@strEq(t, "beam") == 1) || (@strEq(t, "Beam") == 1))) {
        return 1;
    }
    if ((@strEq(t, "beam.Beam") == 1)) {
        return 1;
    }
    return 0;
}

fn fs_is_phase(t: []u8) i32 {
    if (((@strEq(t, "phase") == 1) || (@strEq(t, "Phase") == 1))) {
        return 1;
    }
    if ((@strEq(t, "phase.Phase") == 1)) {
        return 1;
    }
    return 0;
}

fn fs_family_of(t: []u8) i32 {
    if ((fs_is_trit(t) == 1)) {
        return fs_family_trit();
    }
    if ((fs_is_posit(t) == 1)) {
        return fs_family_posit();
    }
    if ((fs_is_integer(t) == 1)) {
        return fs_family_integer();
    }
    if ((fs_is_float(t) == 1)) {
        return fs_family_float();
    }
    if ((fs_is_wave(t) == 1)) {
        return fs_family_wave();
    }
    if ((fs_is_beam(t) == 1)) {
        return fs_family_beam();
    }
    if ((fs_is_phase(t) == 1)) {
        return fs_family_phase();
    }
    return fs_family_none();
}

fn fs_same_family(a: []u8, b: []u8) i32 {
    let fa: i32 = fs_family_of(a);
    let fb: i32 = fs_family_of(b);
    if (((fa == fs_family_none()) || (fb == fs_family_none()))) {
        return 0;
    }
    if ((fa == fb)) {
        return 1;
    }
    return 0;
}

fn fs_binop_compatible(a: []u8, b: []u8) i32 {
    if ((fs_same_family(a, b) == 1)) {
        return 1;
    }
    return 0;
}

fn fs_is_mixed_posit_integer(a: []u8, b: []u8) i32 {
    let fa: i32 = fs_family_of(a);
    let fb: i32 = fs_family_of(b);
    if (((fa == fs_family_posit()) && (fb == fs_family_integer()))) {
        return 1;
    }
    if (((fa == fs_family_integer()) && (fb == fs_family_posit()))) {
        return 1;
    }
    return 0;
}

fn fs_trit_bin_result() []u8 {
    return "Trit";
}

fn fs_photonic_bin_result(lty: []u8, rty: []u8) []u8 {
    if (((fs_is_wave(lty) == 1) && (fs_is_wave(rty) == 1))) {
        return "Wave";
    }
    if (((fs_is_beam(lty) == 1) && (fs_is_beam(rty) == 1))) {
        return "Beam";
    }
    if (((fs_is_phase(lty) == 1) && (fs_is_phase(rty) == 1))) {
        return "Phase";
    }
    return "";
}

fn fs_eff_alloc() i32 {
    return 1;
}

fn fs_eff_io() i32 {
    return 4;
}

fn fs_eff_photonic() i32 {
    return 32;
}

fn fs_eff_raw() i32 {
    return 64;
}

fn fs_eff_has_bit(v: i32, bit: i32) i32 {
    if ((v < bit)) {
        return 0;
    }
    let q: i32 = (v / bit);
    let half: i32 = (q / 2);
    if (((half * 2) == q)) {
        return 0;
    }
    return 1;
}

fn fs_eff_bor(a: i32, b: i32) i32 {
    let r: i32 = 0;
    if (((fs_eff_has_bit(a, 1) == 1) || (fs_eff_has_bit(b, 1) == 1))) {
        r = (r + 1);
    }
    if (((fs_eff_has_bit(a, 2) == 1) || (fs_eff_has_bit(b, 2) == 1))) {
        r = (r + 2);
    }
    if (((fs_eff_has_bit(a, 4) == 1) || (fs_eff_has_bit(b, 4) == 1))) {
        r = (r + 4);
    }
    if (((fs_eff_has_bit(a, 32) == 1) || (fs_eff_has_bit(b, 32) == 1))) {
        r = (r + 32);
    }
    if (((fs_eff_has_bit(a, 64) == 1) || (fs_eff_has_bit(b, 64) == 1))) {
        r = (r + 64);
    }
    return r;
}

fn fs_eff_intersects(a: i32, b: i32) i32 {
    if (((fs_eff_has_bit(a, 1) == 1) && (fs_eff_has_bit(b, 1) == 1))) {
        return 1;
    }
    if (((fs_eff_has_bit(a, 2) == 1) && (fs_eff_has_bit(b, 2) == 1))) {
        return 1;
    }
    if (((fs_eff_has_bit(a, 4) == 1) && (fs_eff_has_bit(b, 4) == 1))) {
        return 1;
    }
    if (((fs_eff_has_bit(a, 32) == 1) && (fs_eff_has_bit(b, 32) == 1))) {
        return 1;
    }
    if (((fs_eff_has_bit(a, 64) == 1) && (fs_eff_has_bit(b, 64) == 1))) {
        return 1;
    }
    return 0;
}

struct FsTypeInfo {
    ty: []u8,
    eff: i32,
}

struct FsCtx {
    pool: *ArrayList[FNode],
    local_names: ArrayList[[]u8],
    local_types: ArrayList[[]u8],
    fn_eff_names: ArrayList[[]u8],
    fn_eff_vals: ArrayList[i32],
    mono_mangled: ArrayList[[]u8],
    mono_resolved: ArrayList[[]u8],
    errors: i32,
    raw_depth: i32,
    file: []u8,
}

fn fs_at(ctx: *FsCtx, idx: i32) FNode {
    return get[FNode](ctx.*.pool.*, idx);
}

fn fs_mono_register(ctx: *FsCtx, mangled: []u8, resolved: []u8) void {
    push[[]u8](&ctx.*.mono_mangled, mangled);
    push[[]u8](&ctx.*.mono_resolved, resolved);
}

fn fs_mono_lookup(ctx: *FsCtx, mangled: []u8) []u8 {
    let i: i32 = 0;
    while ((i < len[[]u8](ctx.*.mono_mangled))) {
        if ((@strEq(get[[]u8](ctx.*.mono_mangled, i), mangled) == 1)) {
            return get[[]u8](ctx.*.mono_resolved, i);
        }
        i = (i + 1);
    }
    return "";
}

fn fs_mono_init(ctx: *FsCtx) void {
    fs_mono_register(ctx, "Box__i32", "Box_i32");
    fs_mono_register(ctx, "Box__Trit", "Box_Trit");
    fs_mono_register(ctx, "Box__p32", "Box_p32");
    fs_mono_register(ctx, "Vec__i32", "Vec_i32");
    fs_mono_register(ctx, "Vec__trit", "Vec_trit");
}

fn fs_ctx_new(pool: *ArrayList[FNode], file: []u8) FsCtx {
    let ctx: FsCtx = FsCtx{ .pool = pool, .local_names = make[[]u8](16), .local_types = make[[]u8](16), .fn_eff_names = make[[]u8](8), .fn_eff_vals = make[i32](8), .mono_mangled = make[[]u8](8), .mono_resolved = make[[]u8](8), .errors = 0, .raw_depth = 0, .file = file };
    fs_mono_init(&ctx);
    return ctx;
}

fn fs_err(ctx: *FsCtx, code: []u8, msg: []u8, line: i32) void {
    ctx.*.errors = (ctx.*.errors + 1);
    _zag_print("flashc1 sema ");
    _zag_print(code);
    _zag_print(" (");
    _zag_print(ctx.*.file);
    if ((line > 0)) {
        _zag_print(":");
        _zag_print(_zag_i64_to_str((line) as i64));
    }
    _zag_print("): ");
    _zag_println(msg);
}

fn fs_annot_declares(a: []u8) i32 {
    if ((@strEq(a, "@io") == 1)) {
        return fs_eff_io();
    }
    if ((@strEq(a, "@photonic") == 1)) {
        return fs_eff_photonic();
    }
    if ((@strEq(a, "@alloc") == 1)) {
        return fs_eff_alloc();
    }
    return 0;
}

fn fs_annot_forbids(a: []u8) i32 {
    if ((@strEq(a, "@realtime") == 1)) {
        return fs_eff_bor(fs_eff_alloc(), fs_eff_io());
    }
    if ((@strEq(a, "@photonic") == 1)) {
        return fs_eff_raw();
    }
    return 0;
}

fn fs_fn_declared_eff(annots: ArrayList[[]u8]) i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while ((i < len[[]u8](annots))) {
        acc = fs_eff_bor(acc, fs_annot_declares(get[[]u8](annots, i)));
        i = (i + 1);
    }
    return acc;
}

fn fs_mono_mangle(base: []u8, targs: ArrayList[[]u8]) []u8 {
    let s: []u8 = base;
    let i: i32 = 0;
    let n: i32 = len[[]u8](targs);
    while ((i < n)) {
        s = _zag_str_concat(s, "__");
        s = _zag_str_concat(s, get[[]u8](targs, i));
        i = (i + 1);
    }
    return s;
}

fn fs_mono_instantiate(base: []u8, targs: ArrayList[[]u8]) []u8 {
    if ((len[[]u8](targs) < 1)) {
        return base;
    }
    return fs_mono_mangle(base, targs);
}

fn fs_mono_resolve(ctx: *FsCtx, mangled: []u8, targs: ArrayList[[]u8]) []u8 {
    let hit: []u8 = fs_mono_lookup(ctx, mangled);
    if ((hit.len > 0)) {
        return hit;
    }
    if ((len[[]u8](targs) > 0)) {
        let msg: []u8 = _zag_str_concat("generic instantiation failure: unknown template ", mangled);
        fs_err(ctx, "F0005", msg, 0);
    }
    return mangled;
}

fn fs_type_of_literal(text: []u8) []u8 {
    let has_dot: i32 = 0;
    let i: i32 = 0;
    while ((i < text.len)) {
        if ((text[i] == 46)) {
            has_dot = 1;
        }
        i = (i + 1);
    }
    if ((has_dot == 1)) {
        return "f64";
    }
    return "i32";
}

fn fs_lookup_local(ctx: *FsCtx, name: []u8) []u8 {
    let i: i32 = 0;
    while ((i < len[[]u8](ctx.*.local_names))) {
        if ((@strEq(get[[]u8](ctx.*.local_names, i), name) == 1)) {
            return get[[]u8](ctx.*.local_types, i);
        }
        i = (i + 1);
    }
    return "";
}

fn fs_bind_local(ctx: *FsCtx, name: []u8, ty: []u8) void {
    push[[]u8](&ctx.*.local_names, name);
    push[[]u8](&ctx.*.local_types, ty);
}

fn fs_binop_result_ty(lty: []u8, rty: []u8, op: []u8) []u8 {
    let fl: i32 = fs_family_of(lty);
    let fr: i32 = fs_family_of(rty);
    if (((fl == fs_family_trit()) && (fr == fs_family_trit()))) {
        return fs_trit_bin_result();
    }
    let photo: []u8 = fs_photonic_bin_result(lty, rty);
    if ((photo.len > 0)) {
        return photo;
    }
    if ((fs_same_family(lty, rty) == 1)) {
        if ((fl == fs_family_posit())) {
            return lty;
        }
        if ((fl == fs_family_integer())) {
            return lty;
        }
        if ((fl == fs_family_float())) {
            return lty;
        }
    }
    if (((@strEq(op, "==") == 1) || (@strEq(op, "!=") == 1))) {
        return "i32";
    }
    return "";
}

fn fs_callee_name(ctx: *FsCtx, callee_idx: i32) []u8 {
    let n: FNode = fs_at(ctx, callee_idx);
    if ((n.code == 15)) {
        return n.text;
    }
    return "";
}

fn fs_raw_mode_call(name: []u8) i32 {
    if ((@strEq(name, "fire_shield") == 1)) {
        return 1;
    }
    if ((@strEq(name, "inject_phase") == 1)) {
        return 1;
    }
    if ((@strEq(name, "set_laser_mw") == 1)) {
        return 1;
    }
    if ((@strEq(name, "target_voxel") == 1)) {
        return 1;
    }
    if ((@strEq(name, "manual_polarity") == 1)) {
        return 1;
    }
    return 0;
}

fn fs_builtin_eff(name: []u8) i32 {
    if ((@strEq(name, "_zag_print") == 1)) {
        return fs_eff_io();
    }
    if ((@strEq(name, "_zag_println") == 1)) {
        return fs_eff_io();
    }
    if ((@strEq(name, "_zag_eprintln") == 1)) {
        return fs_eff_io();
    }
    if ((@strEq(name, "_zag_write_file") == 1)) {
        return fs_eff_io();
    }
    if ((@strEq(name, "_zag_malloc") == 1)) {
        return fs_eff_bor(fs_eff_alloc(), 2);
    }
    if ((@strEq(name, "_zag_free") == 1)) {
        return fs_eff_alloc();
    }
    if ((@strEq(name, "fire_shield") == 1)) {
        return fs_eff_bor(fs_eff_io(), fs_eff_photonic());
    }
    if ((@strEq(name, "inject_phase") == 1)) {
        return fs_eff_bor(fs_eff_io(), fs_eff_photonic());
    }
    if ((@strEq(name, "set_laser_mw") == 1)) {
        return fs_eff_bor(fs_eff_io(), fs_eff_photonic());
    }
    return 0;
}

fn fs_fn_eff_lookup(ctx: *FsCtx, name: []u8) i32 {
    let i: i32 = 0;
    while ((i < len[[]u8](ctx.*.fn_eff_names))) {
        if ((@strEq(get[[]u8](ctx.*.fn_eff_names, i), name) == 1)) {
            return get[i32](ctx.*.fn_eff_vals, i);
        }
        i = (i + 1);
    }
    return -1;
}

fn fs_fn_eff_put(ctx: *FsCtx, name: []u8, eff: i32) void {
    push[[]u8](&ctx.*.fn_eff_names, name);
    push[i32](&ctx.*.fn_eff_vals, eff);
}

fn fs_check_expr(ctx: *FsCtx, idx: i32) FsTypeInfo {
    let n: FNode = fs_at(ctx, idx);
    if ((n.code == 11)) {
        return FsTypeInfo{ .ty = "trit", .eff = 0 };
    }
    if ((n.code == 12)) {
        return FsTypeInfo{ .ty = fs_type_of_literal(n.text), .eff = 0 };
    }
    if ((n.code == 13)) {
        return FsTypeInfo{ .ty = "f32", .eff = 0 };
    }
    if ((n.code == 14)) {
        return FsTypeInfo{ .ty = "[]u8", .eff = 0 };
    }
    if ((n.code == 15)) {
        let ty: []u8 = fs_lookup_local(ctx, n.text);
        if ((ty.len == 0)) {
            fs_err(ctx, "F0001", "unknown identifier", n.line);
            return FsTypeInfo{ .ty = "", .eff = 0 };
        }
        return FsTypeInfo{ .ty = ty, .eff = 0 };
    }
    if ((n.code == 16)) {
        let lt: FsTypeInfo = fs_check_expr(ctx, n.a);
        let rt: FsTypeInfo = fs_check_expr(ctx, n.b);
        let acc_eff: i32 = fs_eff_bor(lt.eff, rt.eff);
        if ((fs_is_mixed_posit_integer(lt.ty, rt.ty) == 1)) {
            fs_err(ctx, "F0002", "mixed posit and integer in binary op — add explicit cast", n.line);
            return FsTypeInfo{ .ty = "", .eff = acc_eff };
        }
        if ((fs_binop_compatible(lt.ty, rt.ty) == 0)) {
            fs_err(ctx, "F0001", "incompatible operand types in binary op", n.line);
            return FsTypeInfo{ .ty = "", .eff = acc_eff };
        }
        let res: []u8 = fs_binop_result_ty(lt.ty, rt.ty, n.text);
        if ((res.len == 0)) {
            fs_err(ctx, "F0001", "cannot infer result type of binary op", n.line);
            return FsTypeInfo{ .ty = "", .eff = acc_eff };
        }
        return FsTypeInfo{ .ty = res, .eff = acc_eff };
    }
    if ((n.code == 19)) {
        let sub: FsTypeInfo = fs_check_expr(ctx, n.a);
        return FsTypeInfo{ .ty = n.text, .eff = sub.eff };
    }
    if ((n.code == 18)) {
        let acc_eff: i32 = 0;
        let i: i32 = 0;
        while ((i < len[i32](n.kids))) {
            let a: FsTypeInfo = fs_check_expr(ctx, get[i32](n.kids, i));
            acc_eff = fs_eff_bor(acc_eff, a.eff);
            i = (i + 1);
        }
        let cn: []u8 = fs_callee_name(ctx, n.a);
        let callee_eff: i32 = fs_fn_eff_lookup(ctx, cn);
        if ((callee_eff < 0)) {
            callee_eff = fs_builtin_eff(cn);
        }
        acc_eff = fs_eff_bor(acc_eff, callee_eff);
        if (((ctx.*.raw_depth > 0) && (fs_raw_mode_call(cn) == 1))) {
            acc_eff = fs_eff_bor(acc_eff, fs_eff_bor(fs_eff_io(), fs_eff_raw()));
        }
        if ((len[[]u8](n.names) > 0)) {
            let mangled: []u8 = fs_mono_instantiate(cn, n.names);
            let resolved: []u8 = fs_mono_resolve(ctx, mangled, n.names);
            return FsTypeInfo{ .ty = resolved, .eff = acc_eff };
        }
        if ((@strEq(cn, "trit") == 1)) {
            return FsTypeInfo{ .ty = "trit", .eff = acc_eff };
        }
        if (((@strEq(cn, "trit_add") == 1) || (@strEq(cn, "trit_mul") == 1))) {
            return FsTypeInfo{ .ty = "trit", .eff = acc_eff };
        }
        if (((@strEq(cn, "trit_nand") == 1) || (@strEq(cn, "trit_neg") == 1))) {
            return FsTypeInfo{ .ty = "trit", .eff = acc_eff };
        }
        if ((@strEq(cn, "wave_default") == 1)) {
            return FsTypeInfo{ .ty = "Wave", .eff = acc_eff };
        }
        if (((@strEq(cn, "mat3_identity") == 1) || (@strEq(cn, "mat3_rotation_xy_90") == 1))) {
            return FsTypeInfo{ .ty = "Mat3", .eff = acc_eff };
        }
        if ((@strEq(cn, "mat3_mul") == 1)) {
            return FsTypeInfo{ .ty = "Mat3", .eff = acc_eff };
        }
        if ((@strEq(cn, "mat3_apply") == 1)) {
            return FsTypeInfo{ .ty = "TritTriple", .eff = acc_eff };
        }
        return FsTypeInfo{ .ty = "void", .eff = acc_eff };
    }
    if ((n.code == 17)) {
        let sub: FsTypeInfo = fs_check_expr(ctx, n.a);
        return FsTypeInfo{ .ty = sub.ty, .eff = sub.eff };
    }
    return FsTypeInfo{ .ty = "", .eff = 0 };
}

fn fs_check_stmts(ctx: *FsCtx, body: ArrayList[i32]) i32 {
    let acc_eff: i32 = 0;
    let i: i32 = 0;
    while ((i < len[i32](body))) {
        acc_eff = fs_eff_bor(acc_eff, fs_check_stmt(ctx, get[i32](body, i)));
        i = (i + 1);
    }
    return acc_eff;
}

fn fs_ty_eq(declared: []u8, inferred: []u8) i32 {
    if ((@strEq(declared, inferred) == 1)) {
        return 1;
    }
    if ((((@strEq(declared, "trit") == 1) || (@strEq(declared, "Trit") == 1)) && ((@strEq(inferred, "trit") == 1) || (@strEq(inferred, "Trit") == 1)))) {
        return 1;
    }
    return 0;
}

fn fs_check_stmt(ctx: *FsCtx, idx: i32) i32 {
    let n: FNode = fs_at(ctx, idx);
    if ((n.code == 2)) {
        let ti: FsTypeInfo = fs_check_expr(ctx, n.a);
        let ty: []u8 = n.ty;
        if ((n.flag == 0)) {
            ty = ti.ty;
        }
        if (((((n.flag == 1) && (ty.len > 0)) && (ti.ty.len > 0)) && (fs_ty_eq(ty, ti.ty) == 0))) {
            fs_err(ctx, "F0001", "let binding type mismatch", n.line);
        }
        fs_bind_local(ctx, n.text, ty);
        return ti.eff;
    }
    if ((n.code == 3)) {
        if ((n.flag2 == 1)) {
            let ti: FsTypeInfo = fs_check_expr(ctx, n.a);
            return ti.eff;
        }
        return 0;
    }
    if ((n.code == 6)) {
        ctx.*.raw_depth = (ctx.*.raw_depth + 1);
        let inner: i32 = fs_eff_bor(fs_check_stmts(ctx, n.kids), fs_eff_raw());
        ctx.*.raw_depth = (ctx.*.raw_depth - 1);
        return inner;
    }
    if ((n.code == 4)) {
        let ce: FsTypeInfo = fs_check_expr(ctx, n.a);
        let te: i32 = fs_check_stmts(ctx, n.kids);
        let ee: i32 = 0;
        if ((n.flag == 1)) {
            ee = fs_check_stmts(ctx, n.kids2);
        }
        return fs_eff_bor(fs_eff_bor(ce.eff, te), ee);
    }
    if ((n.code == 5)) {
        let ce: FsTypeInfo = fs_check_expr(ctx, n.a);
        let be: i32 = fs_check_stmts(ctx, n.kids);
        return fs_eff_bor(ce.eff, be);
    }
    if ((n.code == 7)) {
        let te: FsTypeInfo = fs_check_expr(ctx, n.a);
        let ve: FsTypeInfo = fs_check_expr(ctx, n.b);
        return fs_eff_bor(te.eff, ve.eff);
    }
    if ((n.code == 8)) {
        let ti: FsTypeInfo = fs_check_expr(ctx, n.a);
        return ti.eff;
    }
    return 0;
}

fn fs_fn_annots(n: FNode) ArrayList[[]u8] {
    return make[[]u8](1);
}

fn fs_check_fn_effects(ctx: *FsCtx, n: FNode) void {
    let body_eff: i32 = fs_check_stmts(ctx, n.kids);
    let annots: ArrayList[[]u8] = fs_fn_annots(n);
    let declared: i32 = fs_fn_declared_eff(annots);
    let total: i32 = fs_eff_bor(body_eff, declared);
    fs_fn_eff_put(ctx, n.text, total);
    let i: i32 = 0;
    while ((i < len[[]u8](annots))) {
        let a: []u8 = get[[]u8](annots, i);
        let forb: i32 = fs_annot_forbids(a);
        if (((forb != 0) && (fs_eff_intersects(total, forb) == 1))) {
            fs_err(ctx, "F0003", "capability constraint violated in function", n.line);
        }
        i = (i + 1);
    }
}

fn fs_check_fn(ctx: *FsCtx, n: FNode) void {
    let pi: i32 = 0;
    while ((pi < len[[]u8](n.names))) {
        fs_bind_local(ctx, get[[]u8](n.names, pi), get[[]u8](n.types, pi));
        pi = (pi + 1);
    }
    fs_check_fn_effects(ctx, n);
}

fn fs_check_decl(ctx: *FsCtx, idx: i32) void {
    let n: FNode = fs_at(ctx, idx);
    if ((n.code == 1)) {
        fs_check_fn(ctx, n);
    }
}

fn fsema_check_pool(pool: *ArrayList[FNode], decls: ArrayList[i32], file: []u8) i32 {
    let ctx: FsCtx = fs_ctx_new(pool, file);
    let i: i32 = 0;
    while ((i < len[i32](decls))) {
        fs_check_decl(&ctx, get[i32](decls, i));
        i = (i + 1);
    }
    return ctx.errors;
}

struct FssEnv {
    names: ArrayList[[]u8],
    types: ArrayList[[]u8],
}

fn fss_has(env: *FssEnv, name: []u8) i32 {
    let i: i32 = 0;
    while ((i < len[[]u8](env.*.names))) {
        if ((@strEq(get[[]u8](env.*.names, i), name) == 1)) {
            return 1;
        }
        i = (i + 1);
    }
    return 0;
}

fn fss_bind(env: *FssEnv, name: []u8, ty: []u8) void {
    push[[]u8](&env.*.names, name);
    push[[]u8](&env.*.types, ty);
}

fn fss_lookup_ty(env: *FssEnv, name: []u8) []u8 {
    let i: i32 = 0;
    while ((i < len[[]u8](env.*.names))) {
        if ((@strEq(get[[]u8](env.*.names, i), name) == 1)) {
            return get[[]u8](env.*.types, i);
        }
        i = (i + 1);
    }
    return "trit";
}

fn fss_surface_err(file: []u8, line: i32, code: []u8, msg: []u8) void {
    _zag_print("flashc1 surface ");
    _zag_print(code);
    _zag_print(" (");
    _zag_print(file);
    _zag_print(":");
    _zag_print(_zag_i64_to_str((line) as i64));
    _zag_print("): ");
    _zag_println(msg);
}

fn fss_valid_trit(v: i32) i32 {
    if ((((v == -1) || (v == 0)) || (v == 1))) {
        return 1;
    }
    return 0;
}

fn fss_raw_arg_count(name: []u8) i32 {
    if ((@strEq(name, "set_laser_mw") == 1)) {
        return 3;
    }
    if ((@strEq(name, "target_voxel") == 1)) {
        return 3;
    }
    return 4;
}

fn fss_check_mixed_trit_op(env: *FssEnv, st: SpStmt, file: []u8) i32 {
    let ta: []u8 = fss_lookup_ty(env, st.op_a);
    let tb: []u8 = fss_lookup_ty(env, st.op_b);
    if ((fs_is_mixed_posit_integer(ta, tb) == 1)) {
        fss_surface_err(file, st.line, "F0002", "mixed posit and integer in surface trit op — add explicit cast");
        return 1;
    }
    if ((@strEq(ta, "trit") == 0)) {
        fss_surface_err(file, st.line, "F0001", "expected trit binding in surface trit op");
        return 1;
    }
    if ((@strEq(tb, "trit") == 0)) {
        fss_surface_err(file, st.line, "F0001", "expected trit binding in surface trit op");
        return 1;
    }
    return 0;
}

fn fss_check_surface_stmt(env: *FssEnv, st: SpStmt, file: []u8) i32 {
    let errs: i32 = 0;
    if ((st.kind == spk_trit_bind())) {
        if ((fss_valid_trit(st.trit_lit) == 0)) {
            fss_surface_err(file, st.line, "F0001", "invalid trit literal in surface binding");
            errs = (errs + 1);
        }
        if ((fss_has(env, st.name) == 1)) {
            fss_surface_err(file, st.line, "F0001", "duplicate surface binding name");
            errs = (errs + 1);
        } else {
            fss_bind(env, st.name, "trit");
        }
    } else if ((st.kind == spk_wave_bind())) {
        if ((fss_has(env, st.name) == 1)) {
            fss_surface_err(file, st.line, "F0001", "duplicate surface binding name");
            errs = (errs + 1);
        } else {
            fss_bind(env, st.name, "Wave");
        }
    } else if ((st.kind == spk_p32_bind())) {
        if ((fss_has(env, st.name) == 1)) {
            fss_surface_err(file, st.line, "F0001", "duplicate surface binding name");
            errs = (errs + 1);
        } else {
            fss_bind(env, st.name, "p32");
        }
    } else if ((st.kind == spk_sat_bind())) {
        if (((st.trit_lit < -32768) || (st.trit_lit > 32767))) {
            fss_surface_err(file, st.line, "F0001", "sat_i16 surface binding out of range");
            errs = (errs + 1);
        }
        if ((fss_has(env, st.name) == 1)) {
            fss_surface_err(file, st.line, "F0001", "duplicate surface binding name");
            errs = (errs + 1);
        } else {
            fss_bind(env, st.name, "sat_i16");
        }
    } else if ((st.kind == spk_trit_op())) {
        if ((fss_has(env, st.op_a) == 0)) {
            fss_surface_err(file, st.line, "F0001", "unknown identifier in surface trit op");
            errs = (errs + 1);
        }
        if ((fss_has(env, st.op_b) == 0)) {
            fss_surface_err(file, st.line, "F0001", "unknown identifier in surface trit op");
            errs = (errs + 1);
        }
        if (((fss_has(env, st.op_a) == 1) && (fss_has(env, st.op_b) == 1))) {
            errs = (errs + fss_check_mixed_trit_op(env, st, file));
        }
        if ((fss_has(env, st.op_dst) == 1)) {
            fss_surface_err(file, st.line, "F0001", "duplicate surface binding name");
            errs = (errs + 1);
        } else {
            fss_bind(env, st.op_dst, "trit");
        }
    } else if ((st.kind == spk_mat3_op())) {
        if ((fss_has(env, st.op_dst) == 1)) {
            fss_surface_err(file, st.line, "F0001", "duplicate surface binding name");
            errs = (errs + 1);
        } else if ((@strEq(st.op_name, "mat3_apply") == 1)) {
            fss_bind(env, st.op_dst, "TritTriple");
        } else {
            fss_bind(env, st.op_dst, "Mat3");
        }
    } else if ((st.kind == spk_raw_block())) {
        let ci: i32 = 0;
        while ((ci < len[SpRawCall](st.raws))) {
            let rc: SpRawCall = get[SpRawCall](st.raws, ci);
            let need: i32 = fss_raw_arg_count(rc.name);
            if ((len[f32](rc.args) != need)) {
                fss_surface_err(file, st.line, "F0004", "raw {} call arity mismatch");
                errs = (errs + 1);
            }
            ci = (ci + 1);
        }
    }
    return errs;
}

fn fss_surface_extra_validate(prog: *SpProgram, file: []u8) i32 {
    let env: FssEnv = FssEnv{ .names = make[[]u8](16), .types = make[[]u8](16) };
    let errs: i32 = 0;
    let i: i32 = 0;
    while ((i < len[SpStmt](prog.*.stmts))) {
        let st: SpStmt = get[SpStmt](prog.*.stmts, i);
        errs = (errs + fss_check_surface_stmt(&env, st, file));
        i = (i + 1);
    }
    return errs;
}

fn fss_push(pool: *ArrayList[FNode], n: FNode) i32 {
    push[FNode](pool.*, n);
    return (len[FNode](pool.*) - 1);
}

fn fss_blank(code: i32, line: i32) FNode {
    return FNode{ .code = code, .line = line, .text = "", .ty = "", .a = 0, .b = 0, .c = 0, .flag = 0, .flag2 = 0, .kids = make[i32](2), .kids2 = make[i32](2), .names = make[[]u8](2), .names2 = make[[]u8](2), .types = make[[]u8](2) };
}

fn fss_trit_lit_text(v: i32) []u8 {
    if ((v == -1)) {
        return "T";
    }
    if ((v == 1)) {
        return "+1";
    }
    if ((v == 0)) {
        return "0";
    }
    return _zag_i64_to_str((v) as i64);
}

fn fss_f32_text(v: f32) []u8 {
    let whole: i32 = (v) as i32;
    let frac: f32 = (v - (whole) as f32);
    if ((frac < 0.0)) {
        frac = (0.0 - frac);
        whole = (0 - whole);
    }
    if ((frac > 0.0001)) {
        let scaled: i32 = ((frac * 1000.0)) as i32;
        let s: []u8 = _zag_i64_to_str((whole) as i64);
        s = _zag_str_concat(s, ".");
        return _zag_str_concat(s, _zag_i64_to_str((scaled) as i64));
    }
    return _zag_i64_to_str((whole) as i64);
}

fn fss_mk_ident(pool: *ArrayList[FNode], name: []u8) i32 {
    let n: FNode = fss_blank(15, 0);
    n.text = name;
    return fss_push(pool, n);
}

fn fss_mk_trit(pool: *ArrayList[FNode], text: []u8) i32 {
    let n: FNode = fss_blank(11, 0);
    n.text = text;
    return fss_push(pool, n);
}

fn fss_mk_int(pool: *ArrayList[FNode], text: []u8) i32 {
    let n: FNode = fss_blank(12, 0);
    n.text = text;
    return fss_push(pool, n);
}

fn fss_mk_float(pool: *ArrayList[FNode], text: []u8) i32 {
    let n: FNode = fss_blank(13, 0);
    n.text = text;
    return fss_push(pool, n);
}

fn fss_mk_cast(pool: *ArrayList[FNode], expr: i32, target: []u8) i32 {
    let n: FNode = fss_blank(19, 0);
    n.a = expr;
    n.text = target;
    return fss_push(pool, n);
}

fn fss_mk_call(pool: *ArrayList[FNode], callee: i32, args: ArrayList[i32]) i32 {
    let n: FNode = fss_blank(18, 0);
    n.a = callee;
    n.kids = args;
    return fss_push(pool, n);
}

fn fss_mk_let(pool: *ArrayList[FNode], name: []u8, dty: []u8, expr: i32) i32 {
    let n: FNode = fss_blank(2, 0);
    n.text = name;
    n.ty = dty;
    n.a = expr;
    n.flag = 1;
    n.flag2 = 1;
    return fss_push(pool, n);
}

fn fss_mk_estmt(pool: *ArrayList[FNode], expr: i32) i32 {
    let n: FNode = fss_blank(8, 0);
    n.a = expr;
    return fss_push(pool, n);
}

fn fss_mk_raw(pool: *ArrayList[FNode], body: ArrayList[i32]) i32 {
    let n: FNode = fss_blank(6, 0);
    n.kids = body;
    return fss_push(pool, n);
}

fn fss_push_f32_arg(pool: *ArrayList[FNode], args: *ArrayList[i32], v: f32) void {
    push[i32](args, fss_mk_float(pool, fss_f32_text(v)));
}

fn fss_raw_call_node(pool: *ArrayList[FNode], rc: SpRawCall) i32 {
    let args: ArrayList[i32] = make[i32](6);
    let ai: i32 = 0;
    while ((ai < len[f32](rc.args))) {
        fss_push_f32_arg(pool, &args, get[f32](rc.args, ai));
        ai = (ai + 1);
    }
    return fss_mk_call(pool, fss_mk_ident(pool, rc.name), args);
}

fn fss_mat3_ret_ty(op: []u8) []u8 {
    if ((@strEq(op, "mat3_apply") == 1)) {
        return "TritTriple";
    }
    return "Mat3";
}

fn fss_mat3_call_node(pool: *ArrayList[FNode], st: SpStmt) i32 {
    let args: ArrayList[i32] = make[i32](4);
    if ((st.op_argc >= 1)) {
        push[i32](&args, fss_mk_ident(pool, st.op_a));
    }
    if ((st.op_argc >= 2)) {
        push[i32](&args, fss_mk_ident(pool, st.op_b));
    }
    if ((st.op_argc >= 3)) {
        push[i32](&args, fss_mk_ident(pool, st.op_c));
    }
    if ((st.op_argc >= 4)) {
        push[i32](&args, fss_mk_ident(pool, st.op_d));
    }
    return fss_mk_call(pool, fss_mk_ident(pool, st.op_name), args);
}

fn fss_stmt_to_node(pool: *ArrayList[FNode], st: SpStmt) i32 {
    if ((st.kind == spk_trit_bind())) {
        return fss_mk_let(pool, st.name, "trit", fss_mk_trit(pool, fss_trit_lit_text(st.trit_lit)));
    }
    if ((st.kind == spk_wave_bind())) {
        let args: ArrayList[i32] = make[i32](1);
        return fss_mk_let(pool, st.name, "Wave", fss_mk_call(pool, fss_mk_ident(pool, "wave_default"), args));
    }
    if ((st.kind == spk_p32_bind())) {
        return fss_mk_let(pool, st.name, "p32", fss_mk_cast(pool, fss_mk_float(pool, fss_f32_text(st.num_f32)), "p32"));
    }
    if ((st.kind == spk_sat_bind())) {
        return fss_mk_let(pool, st.name, "sat_i16", fss_mk_cast(pool, fss_mk_int(pool, _zag_i64_to_str((st.trit_lit) as i64)), "sat_i16"));
    }
    if ((st.kind == spk_trit_op())) {
        let args: ArrayList[i32] = make[i32](2);
        push[i32](&args, fss_mk_ident(pool, st.op_a));
        if ((@strEq(st.op_name, "trit_neg") == 0)) {
            push[i32](&args, fss_mk_ident(pool, st.op_b));
        }
        return fss_mk_let(pool, st.op_dst, "trit", fss_mk_call(pool, fss_mk_ident(pool, st.op_name), args));
    }
    if ((st.kind == spk_mat3_op())) {
        return fss_mk_let(pool, st.op_dst, fss_mat3_ret_ty(st.op_name), fss_mat3_call_node(pool, st));
    }
    if ((st.kind == spk_raw_block())) {
        let body: ArrayList[i32] = make[i32](8);
        let ci: i32 = 0;
        while ((ci < len[SpRawCall](st.raws))) {
            let rc: SpRawCall = get[SpRawCall](st.raws, ci);
            push[i32](&body, fss_mk_estmt(pool, fss_raw_call_node(pool, rc)));
            ci = (ci + 1);
        }
        return fss_mk_raw(pool, body);
    }
    return fss_mk_estmt(pool, fss_mk_ident(pool, ""));
}

fn fss_prog_to_main_fn(pool: *ArrayList[FNode], prog: *SpProgram) i32 {
    let body: ArrayList[i32] = make[i32](20);
    let i: i32 = 0;
    while ((i < len[SpStmt](prog.*.stmts))) {
        push[i32](&body, fss_stmt_to_node(pool, get[SpStmt](prog.*.stmts, i)));
        i = (i + 1);
    }
    let n: FNode = fss_blank(1, 1);
    n.text = "main";
    n.ty = "i32";
    n.kids = body;
    return fss_push(pool, n);
}

fn fsema_surface_ast(prog: *SpProgram, file: []u8) i32 {
    let pool: ArrayList[FNode] = make[FNode](64);
    let decls: ArrayList[i32] = make[i32](2);
    push[i32](&decls, fss_prog_to_main_fn(&pool, prog));
    return fsema_check_pool(&pool, decls, file);
}

fn fsema_surface_check(prog: *SpProgram, file: []u8) i32 {
    let extra: i32 = fss_surface_extra_validate(prog, file);
    let ast: i32 = fsema_surface_ast(prog, file);
    return (extra + ast);
}

fn f1_rel_path(path: []u8) []u8 {
    let ex: i32 = flash_str_index_of(path, "examples/");
    if ((ex >= 0)) {
        return path[ex..];
    }
    let sh: i32 = flash_str_index_of(path, "selfhost/");
    if ((sh >= 0)) {
        return path[sh..];
    }
    let td: i32 = flash_str_index_of(path, "flash/compiler/testdata/");
    if ((td >= 0)) {
        return path[td..];
    }
    let fc: i32 = flash_str_index_of(path, "flash/compiler/");
    if ((fc >= 0)) {
        return path[fc..];
    }
    if ((((path.len >= 2) && (path[0] == 46)) && (path[1] == 47))) {
        return path[2..];
    }
    return path;
}

fn f1_shim_path(src: []u8) []u8 {
    let stem: []u8 = flash_path_stem(src);
    let dir: []u8 = flash_path_dir(src);
    let base: []u8 = _zag_str_concat(stem, "_shim.zag");
    if ((@strEq(dir, ".") == 1)) {
        return base;
    }
    return _zag_str_concat(_zag_str_concat(dir, "/"), base);
}

fn f1_manifest_path(shim_path: []u8) []u8 {
    let dir: []u8 = flash_path_dir(shim_path);
    if ((@strEq(dir, ".") == 1)) {
        return "flash.manifest";
    }
    return _zag_str_concat(_zag_str_concat(dir, "/"), "flash.manifest");
}

fn f1_has_flag(name: []u8) i32 {
    let i: i32 = 0;
    while ((i < process_arg_count())) {
        if ((@strEq(process_arg(i), name) == 1)) {
            return 1;
        }
        i = (i + 1);
    }
    return 0;
}

fn f1_flag_value(name: []u8) []u8 {
    let i: i32 = 0;
    while ((i < process_arg_count())) {
        if ((@strEq(process_arg(i), name) == 1)) {
            if (((i + 1) < process_arg_count())) {
                return process_arg((i + 1));
            }
        }
        i = (i + 1);
    }
    return "";
}

fn f1_is_word_char(c: i32) i32 {
    if (((c >= 97) && (c <= 122))) {
        return 1;
    }
    if (((c >= 65) && (c <= 90))) {
        return 1;
    }
    if ((c == 95)) {
        return 1;
    }
    return 0;
}

fn f1_is_surface(text: []u8) i32 {
    let i: i32 = 0;
    let n: i32 = text.len;
    while ((i < n)) {
        let c: i32 = (text[i]) as i32;
        if (((((c == 32) || (c == 9)) || (c == 13)) || (c == 10))) {
            i = (i + 1);
        } else if ((((c == 47) && ((i + 1) < n)) && ((text[(i + 1)]) as i32 == 47))) {
            while (((i < n) && ((text[i]) as i32 != 10))) {
                i = (i + 1);
            }
        } else {
            let start: i32 = i;
            while (((i < n) && (f1_is_word_char((text[i]) as i32) == 1))) {
                i = (i + 1);
            }
            if ((@strEq(text[start..i], "program") == 1)) {
                return 1;
            }
            return 0;
        }
    }
    return 0;
}

fn f1_collect(path: []u8, pool: *ArrayList[FNode], out_decls: *ArrayList[i32], seen_files: *ArrayList[[]u8], seen_imports: *ArrayList[[]u8]) i32 {
    if ((flash_list_has(seen_files, path) == 1)) {
        return 0;
    }
    push[[]u8](seen_files, path);
    let text: []u8 = _zag_read_file(path);
    if ((text.len < 0)) {
        _zag_print("flashc1: cannot read import ");
        _zag_println(path);
        return 1;
    }
    let pr: FpResult = fpp_parse_into(text, pool);
    if ((pr.err != 0)) {
        _zag_print("flashc1: parse errors in ");
        _zag_println(path);
        return 1;
    }
    let errs: i32 = 0;
    let dir: []u8 = flash_path_dir(path);
    let i: i32 = 0;
    while ((i < len[i32](pr.decls))) {
        let didx: i32 = get[i32](pr.decls, i);
        let d: FNode = get[FNode](pool.*, didx);
        if (((d.code == 10) && (flash_str_ends_with(d.text, "list.flash") == 1))) {
        } else if (((d.code == 10) && ((flash_str_ends_with(d.text, ".flash.zag") == 1) || (flash_str_ends_with(d.text, ".flash") == 1)))) {
            errs = (errs + f1_collect(flash_path_join(dir, d.text), pool, out_decls, seen_files, seen_imports));
        } else if ((d.code == 10)) {
            if ((flash_list_has(seen_imports, d.text) == 0)) {
                push[[]u8](seen_imports, d.text);
                push[i32](out_decls, didx);
            }
        } else {
            push[i32](out_decls, didx);
        }
        i = (i + 1);
    }
    return errs;
}

fn f1_write_or_die(path: []u8, text: []u8) i32 {
    let rc: i32 = _zag_write_file(path, text);
    if ((rc != 0)) {
        _zag_print("flashc1: failed to write ");
        _zag_println(path);
        return 1;
    }
    return 0;
}

struct F1Out {
    shim_text: []u8,
    manifest_text: []u8,
    err: i32,
}

fn f1_build_surface(text: []u8, shim_dir: []u8) F1Out {
    let prog: SpProgram = sp_parse_program(text);
    if ((prog.err != 0)) {
        _zag_println("flashc1: parse errors — aborting");
        return F1Out{ .shim_text = "", .manifest_text = "", .err = 1 };
    }
    let verrs: i32 = sp_validate(&prog);
    if ((verrs > 0)) {
        _zag_println("flashc1: semantic errors — aborting");
        return F1Out{ .shim_text = "", .manifest_text = "", .err = 1 };
    }
    let serr: i32 = fsema_surface_ast(&prog, text);
    if ((serr > 0)) {
        _zag_println("flashc1: semantic errors — aborting");
        return F1Out{ .shim_text = "", .manifest_text = "", .err = 1 };
    }
    let res: SgResult = scg_emit(&prog, shim_dir);
    if ((res.err != 0)) {
        _zag_println("flashc1: codegen errors — aborting");
        return F1Out{ .shim_text = "", .manifest_text = "", .err = 1 };
    }
    return F1Out{ .shim_text = res.out.data[0..res.out.len], .manifest_text = res.manifest_text, .err = 0 };
}

fn f1_check_full(src: []u8) i32 {
    let pool: ArrayList[FNode] = make[FNode](512);
    let decls: ArrayList[i32] = make[i32](128);
    let seen_files: ArrayList[[]u8] = make[[]u8](8);
    let seen_imports: ArrayList[[]u8] = make[[]u8](8);
    let errs: i32 = f1_collect(src, &pool, &decls, &seen_files, &seen_imports);
    if ((errs > 0)) {
        _zag_println("flashc1: parse errors — aborting");
        return 1;
    }
    let verrs: i32 = fsema_check_pool(&pool, decls, src);
    if ((verrs > 0)) {
        _zag_println("flashc1: semantic errors — aborting");
        return 1;
    }
    return 0;
}

fn f1_build_full(src: []u8, shim_dir: []u8, stem: []u8) F1Out {
    let pool: ArrayList[FNode] = make[FNode](512);
    let decls: ArrayList[i32] = make[i32](128);
    let seen_files: ArrayList[[]u8] = make[[]u8](8);
    let seen_imports: ArrayList[[]u8] = make[[]u8](8);
    let errs: i32 = f1_collect(src, &pool, &decls, &seen_files, &seen_imports);
    if ((errs > 0)) {
        _zag_println("flashc1: parse errors — aborting");
        return F1Out{ .shim_text = "", .manifest_text = "", .err = 1 };
    }
    let out: ArrayList[u8] = make[u8](8192);
    scg_emit_header(&out, shim_dir);
    let eerr: i32 = fe_emit_decls(&pool, &out, decls);
    if ((eerr > 0)) {
        _zag_println("flashc1: codegen errors — aborting");
        return F1Out{ .shim_text = "", .manifest_text = "", .err = 1 };
    }
    let mani: CoordinateManifest = manifest_new(stem, "0.1.0");
    let mtext: []u8 = manifest_write(&mani);
    return F1Out{ .shim_text = out.data[0..out.len], .manifest_text = mtext, .err = 0 };
}

fn f1_build(src: []u8, shim_dir: []u8) F1Out {
    let text: []u8 = _zag_read_file(src);
    if ((text.len < 0)) {
        _zag_print("flashc1: cannot read ");
        _zag_println(src);
        return F1Out{ .shim_text = "", .manifest_text = "", .err = 1 };
    }
    if ((f1_is_surface(text) == 1)) {
        return f1_build_surface(text, shim_dir);
    }
    return f1_build_full(src, shim_dir, flash_path_stem(src));
}

fn f1_usage() void {
    _zag_println("usage: flashc1 <file.flash> <out_shim.zag> [--emit-manifest]");
    _zag_println("       flashc1 <file.flash> [-o output] [--emit-manifest] [--emit-zag]");
    _zag_println("               [--check] [--run] [--znc <path-to-znc>]");
}

fn f1_quote(s: []u8) []u8 {
    return _zag_str_concat(_zag_str_concat("\"", s), "\"");
}

fn f1_mod_zag_path() []u8 {
    if ((_zag_file_exists("flash.mod") == 0)) {
        return "";
    }
    let src: []u8 = _zag_read_file("flash.mod");
    if ((src.len < 0)) {
        return "";
    }
    let mod_: ZagMod = zagmod_parse(src);
    let i: i32 = 0;
    while ((i < len[Dep](mod_.deps))) {
        let d: Dep = get[Dep](mod_.deps, i);
        if ((@strEq(d.name, "zag") == 1)) {
            return d.path;
        }
        i = (i + 1);
    }
    return "";
}

fn f1_znc_path() []u8 {
    let flag: []u8 = f1_flag_value("--znc");
    if ((flag.len > 0)) {
        if ((_zag_file_exists(flag) == 1)) {
            return flag;
        }
        _zag_print("flashc1: --znc path does not exist: ");
        _zag_println(flag);
        return "";
    }
    let env: []u8 = _zag_getenv("ZNC");
    if ((env.len > 0)) {
        if ((_zag_file_exists(env) == 1)) {
            return env;
        }
        _zag_print("flashc1: ZNC env path does not exist: ");
        _zag_println(env);
        return "";
    }
    let dep: []u8 = f1_mod_zag_path();
    if ((dep.len > 0)) {
        let cand: []u8 = _zag_str_concat(dep, "/znc");
        if ((_zag_file_exists(cand) == 1)) {
            return cand;
        }
        _zag_print("flashc1: flash.mod declares zag at ");
        _zag_print(dep);
        _zag_println(" but no znc binary there — trying fallbacks");
    }
    if ((_zag_file_exists("../zag/zag-poc/znc") == 1)) {
        return "../zag/zag-poc/znc";
    }
    if ((_zag_file_exists("zag/zag-poc/znc") == 1)) {
        return "zag/zag-poc/znc";
    }
    if ((_zag_file_exists("./znc") == 1)) {
        return "./znc";
    }
    _zag_println("flashc1: cannot locate znc — pass --znc <path>, or declare");
    _zag_println("flashc1: [deps] zag = { path = \"...\" } in flash.mod with znc built there");
    return "";
}

fn f1_find_path(start: i32) []u8 {
    let i: i32 = start;
    while ((i < process_arg_count())) {
        let a: []u8 = process_arg(i);
        if ((a.len > 0)) {
            if ((a[0] != 45)) {
                return a;
            }
        }
        i = (i + 1);
    }
    return "";
}

fn f1_positional_shim() []u8 {
    let seen_src: i32 = 0;
    let i: i32 = 1;
    while ((i < process_arg_count())) {
        let a: []u8 = process_arg(i);
        if (((a.len > 0) && (a[0] != 45))) {
            if ((seen_src == 1)) {
                if (((flash_str_ends_with(a, ".zag") == 1) && (flash_str_ends_with(a, ".flash") == 0))) {
                    return a;
                }
                return "";
            }
            seen_src = 1;
        } else if ((@strEq(a, "-o") == 1)) {
            i = (i + 1);
        }
        i = (i + 1);
    }
    return "";
}

fn main() i32 {
    if ((process_arg_count() < 2)) {
        f1_usage();
        return 1;
    }
    let src: []u8 = f1_rel_path(f1_find_path(1));
    if ((src.len == 0)) {
        f1_usage();
        return 1;
    }
    let legacy_shim: []u8 = f1_positional_shim();
    let shim_path: []u8 = f1_shim_path(src);
    if ((legacy_shim.len > 0)) {
        shim_path = legacy_shim;
    }
    let shim_dir: []u8 = flash_path_dir(shim_path);
    if ((f1_has_flag("--check") == 1)) {
        let text: []u8 = _zag_read_file(src);
        if ((text.len < 0)) {
            _zag_print("flashc1: cannot read ");
            _zag_println(src);
            return 1;
        }
        if ((f1_is_surface(text) == 1)) {
            let prog: SpProgram = sp_parse_program(text);
            if (((prog.err != 0) || (sp_validate(&prog) > 0))) {
                _zag_println("flashc1: --check failed");
                return 1;
            }
            if ((fsema_surface_check(&prog, src) > 0)) {
                _zag_println("flashc1: --check failed");
                return 1;
            }
        } else if ((f1_check_full(src) != 0)) {
            _zag_println("flashc1: --check failed");
            return 1;
        }
        _zag_println("flashc1: --check ok");
        return 0;
    }
    let built: F1Out = f1_build(src, shim_dir);
    if ((built.err != 0)) {
        return 1;
    }
    if ((f1_write_or_die(shim_path, built.shim_text) != 0)) {
        return 1;
    }
    _zag_print("flashc1: wrote ");
    _zag_println(shim_path);
    if ((f1_has_flag("--emit-manifest") == 1)) {
        let mpath: []u8 = f1_manifest_path(shim_path);
        if ((f1_write_or_die(mpath, built.manifest_text) != 0)) {
            return 1;
        }
        _zag_print("flashc1: emitted manifest ");
        _zag_println(mpath);
    }
    if (((legacy_shim.len > 0) || (f1_has_flag("--emit-zag") == 1))) {
        return 0;
    }
    let out_path: []u8 = f1_flag_value("-o");
    if ((out_path.len == 0)) {
        out_path = _zag_str_concat(flash_path_stem(src), ".out");
    }
    let znc: []u8 = f1_znc_path();
    if ((znc.len == 0)) {
        return 1;
    }
    let cmd: []u8 = _zag_str_concat(f1_quote(znc), " ");
    cmd = _zag_str_concat(cmd, f1_quote(shim_path));
    cmd = _zag_str_concat(cmd, " -o ");
    cmd = _zag_str_concat(cmd, f1_quote(out_path));
    let rc: i32 = process_run_shell(cmd);
    if ((rc != 0)) {
        _zag_println("flashc1: znc compile failed");
        return 1;
    }
    _zag_print("flashc1: built ");
    _zag_println(out_path);
    if ((f1_has_flag("--run") == 1)) {
        let runcmd: []u8 = out_path;
        if (((out_path.len > 0) && (out_path[0] != 47))) {
            runcmd = _zag_str_concat("./", out_path);
        }
        _zag_println("flashc1: -- running --");
        _zag_flush();
        let run_rc: i32 = process_run_shell(f1_quote(runcmd));
        return run_rc;
    }
    return 0;
}

