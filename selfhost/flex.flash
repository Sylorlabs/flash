// selfhost/flex.flash.zag — full-language Flash lexer, written in Flash.
//
// Stage-1 port of lex() from flash/compiler/flash_lex.zag. Token kinds are
// i32 codes mirroring tk_code() so behavior matches stage-0 exactly.
// Library file (no main).

@import("std/list.flash")

fn fx_eof() i32       { return 0; }
fn fx_err() i32       { return 99; }
fn fx_ident() i32     { return 1; }
fn fx_annot() i32     { return 2; }
fn fx_op() i32        { return 3; }
fn fx_str() i32       { return 4; }
fn fx_int() i32       { return 5; }
fn fx_float() i32     { return 6; }
fn fx_type() i32      { return 7; }
fn fx_tritlit() i32   { return 8; }
fn fx_kw_fn() i32     { return 10; }
fn fx_kw_extern() i32 { return 11; }
fn fx_kw_let() i32    { return 12; }
fn fx_kw_return() i32 { return 13; }
fn fx_kw_if() i32     { return 14; }
fn fx_kw_else() i32   { return 15; }
fn fx_kw_while() i32  { return 16; }
fn fx_kw_true() i32   { return 17; }
fn fx_kw_false() i32  { return 18; }
fn fx_kw_struct() i32 { return 19; }
fn fx_kw_enum() i32   { return 20; }
fn fx_kw_union() i32  { return 21; }
fn fx_kw_switch() i32 { return 22; }
fn fx_kw_error() i32  { return 23; }
fn fx_kw_try() i32    { return 24; }
fn fx_kw_catch() i32  { return 25; }
fn fx_kw_null() i32   { return 26; }
fn fx_kw_orelse() i32 { return 27; }
fn fx_kw_pub() i32    { return 28; }
fn fx_kw_group() i32  { return 52; }
fn fx_kw_defer() i32  { return 53; }
fn fx_kw_concept() i32 { return 54; }
fn fx_kw_raw() i32    { return 70; }
fn fx_kw_wave() i32   { return 71; }
fn fx_kw_beam() i32   { return 72; }
fn fx_kw_phase() i32  { return 73; }
fn fx_kw_trit() i32   { return 74; }
fn fx_lp() i32        { return 40; }
fn fx_rp() i32        { return 41; }
fn fx_lbrace() i32    { return 42; }
fn fx_rbrace() i32    { return 43; }
fn fx_lbracket() i32  { return 44; }
fn fx_rbracket() i32  { return 45; }
fn fx_comma() i32     { return 46; }
fn fx_semi() i32      { return 47; }
fn fx_colon() i32     { return 48; }
fn fx_dot() i32       { return 49; }
fn fx_pipe() i32      { return 50; }
fn fx_dotdot() i32    { return 51; }

struct FxToken {
    kind: i32,
    text: []u8,
    line: i32,
}

fn fx_ch(src: []u8, i: i32) i32 {
    return src[i] as i32;
}

fn fx_is_digit(c: i32) i32 {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

fn fx_is_hex_digit(c: i32) i32 {
    if (fx_is_digit(c) == 1) { return 1; }
    if (c >= 97 && c <= 102) { return 1; }
    if (c >= 65 && c <= 70) { return 1; }
    return 0;
}

// Remove underscore separators from a numeric literal slice.
fn fx_strip_underscores(s: []u8) []u8 {
    let has: i32 = 0;
    let i: i32 = 0;
    while (i < s.len) {
        if (fx_ch(s, i) == 95) { has = 1; }
        i = i + 1;
    }
    if (has == 0) { return s; }
    let out: []u8 = "";
    i = 0;
    while (i < s.len) {
        if (fx_ch(s, i) != 95) {
            out = _zag_str_concat(out, s[i..i + 1]);
        }
        i = i + 1;
    }
    return out;
}

fn fx_is_alpha(c: i32) i32 {
    if (c >= 97 && c <= 122) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c == 95) { return 1; }
    return 0;
}

fn fx_is_alnum(c: i32) i32 {
    if (fx_is_alpha(c) == 1 || fx_is_digit(c) == 1) { return 1; }
    return 0;
}

fn fx_is_space(c: i32) i32 {
    if (c == 32 || c == 9 || c == 13 || c == 10) { return 1; }
    return 0;
}

fn fx_parse_digits(w: []u8) i32 {
    if (w.len < 1) { return -1; }
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < w.len) {
        let c: i32 = fx_ch(w, i);
        if (fx_is_digit(c) == 0) { return -1; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    return n;
}

fn fx_type_kind(w: []u8) i32 {
    if (@strEq(w, "i8") == 1 || @strEq(w, "i16") == 1 || @strEq(w, "i32") == 1 || @strEq(w, "i64") == 1) { return fx_type(); }
    if (@strEq(w, "u8") == 1 || @strEq(w, "u16") == 1 || @strEq(w, "u32") == 1 || @strEq(w, "u64") == 1) { return fx_type(); }
    if (@strEq(w, "f32") == 1 || @strEq(w, "f64") == 1) { return fx_type(); }
    if (@strEq(w, "p8") == 1 || @strEq(w, "p16") == 1 || @strEq(w, "p32") == 1 || @strEq(w, "p64") == 1) { return fx_type(); }
    if (@strEq(w, "sat_i16") == 1 || @strEq(w, "fixed_8_8") == 1 || @strEq(w, "u11") == 1) { return fx_type(); }
    if (@strEq(w, "u_any") == 1 || @strEq(w, "rns_3") == 1 || @strEq(w, "quire") == 1) { return fx_type(); }
    if (@strEq(w, "sat_i8") == 1 || @strEq(w, "sat_i32") == 1 || @strEq(w, "sat_i64") == 1) { return fx_type(); }
    if (@strEq(w, "sat_u8") == 1 || @strEq(w, "sat_u16") == 1 || @strEq(w, "sat_u32") == 1 || @strEq(w, "sat_u64") == 1) { return fx_type(); }
    if (@strEq(w, "i_any") == 1) { return fx_type(); }
    if (w.len >= 2) {
        let lead: i32 = fx_ch(w, 0);
        if (lead == 105 || lead == 117) {
            let n: i32 = fx_parse_digits(w[1..w.len]);
            if (n >= 1 && n <= 127) { return fx_type(); }
        }
    }
    return fx_ident();
}

fn fx_zag_kw(w: []u8) i32 {
    if (@strEq(w, "fn") == 1)     { return fx_kw_fn(); }
    if (@strEq(w, "extern") == 1) { return fx_kw_extern(); }
    if (@strEq(w, "let") == 1)    { return fx_kw_let(); }
    if (@strEq(w, "return") == 1) { return fx_kw_return(); }
    if (@strEq(w, "if") == 1)     { return fx_kw_if(); }
    if (@strEq(w, "else") == 1)   { return fx_kw_else(); }
    if (@strEq(w, "while") == 1)  { return fx_kw_while(); }
    if (@strEq(w, "true") == 1)   { return fx_kw_true(); }
    if (@strEq(w, "false") == 1)  { return fx_kw_false(); }
    if (@strEq(w, "struct") == 1) { return fx_kw_struct(); }
    if (@strEq(w, "enum") == 1)   { return fx_kw_enum(); }
    if (@strEq(w, "union") == 1)  { return fx_kw_union(); }
    if (@strEq(w, "switch") == 1) { return fx_kw_switch(); }
    if (@strEq(w, "error") == 1)  { return fx_kw_error(); }
    if (@strEq(w, "try") == 1)    { return fx_kw_try(); }
    if (@strEq(w, "catch") == 1)  { return fx_kw_catch(); }
    if (@strEq(w, "null") == 1)   { return fx_kw_null(); }
    if (@strEq(w, "orelse") == 1) { return fx_kw_orelse(); }
    if (@strEq(w, "pub") == 1)    { return fx_kw_pub(); }
    if (@strEq(w, "group") == 1)  { return fx_kw_group(); }
    if (@strEq(w, "defer") == 1)  { return fx_kw_defer(); }
    if (@strEq(w, "concept") == 1) { return fx_kw_concept(); }
    return fx_ident();
}

fn fx_flash_kw(w: []u8) i32 {
    if (@strEq(w, "raw") == 1)   { return fx_kw_raw(); }
    if (@strEq(w, "wave") == 1)  { return fx_kw_wave(); }
    if (@strEq(w, "beam") == 1)  { return fx_kw_beam(); }
    if (@strEq(w, "phase") == 1) { return fx_kw_phase(); }
    if (@strEq(w, "trit") == 1)  { return fx_kw_trit(); }
    return fx_ident();
}

fn fx_word_kind(w: []u8) i32 {
    let z: i32 = fx_zag_kw(w);
    if (z != fx_ident()) { return z; }
    let f: i32 = fx_flash_kw(w);
    if (f != fx_ident()) { return f; }
    let t: i32 = fx_type_kind(w);
    if (t != fx_ident()) { return t; }
    if (@strEq(w, "T") == 1) { return fx_tritlit(); }
    return fx_ident();
}

fn fx_is_two_op(src: []u8, i: i32, n: i32) i32 {
    if (i + 1 >= n) { return 0; }
    let a: i32 = fx_ch(src, i);
    let b: i32 = fx_ch(src, i + 1);
    if (a == 61 && b == 61) { return 1; }
    if (a == 33 && b == 61) { return 1; }
    if (a == 60 && b == 61) { return 1; }
    if (a == 62 && b == 61) { return 1; }
    if (a == 38 && b == 38) { return 1; }
    if (a == 124 && b == 124) { return 1; }
    if (a == 60 && b == 60) { return 1; }
    if (a == 62 && b == 62) { return 1; }
    if (a == 61 && b == 62) { return 1; }
    return 0;
}

fn fx_punct_kind(c: i32) i32 {
    if (c == 40) { return fx_lp(); }
    if (c == 41) { return fx_rp(); }
    if (c == 123) { return fx_lbrace(); }
    if (c == 125) { return fx_rbrace(); }
    if (c == 91) { return fx_lbracket(); }
    if (c == 93) { return fx_rbracket(); }
    if (c == 44) { return fx_comma(); }
    if (c == 59) { return fx_semi(); }
    if (c == 58) { return fx_colon(); }
    if (c == 46) { return fx_dot(); }
    if (c == 124) { return fx_pipe(); }
    return fx_op();
}

fn fx_is_single_op(c: i32) i32 {
    if (c == 43 || c == 45 || c == 42 || c == 47 || c == 37) { return 1; }
    if (c == 60 || c == 62 || c == 61 || c == 33 || c == 38 || c == 94) { return 1; }
    if (c == 63) { return 1; }
    return 0;
}

fn fx_mk(kind: i32, text: []u8, line: i32) FxToken {
    return FxToken{ .kind = kind, .text = text, .line = line };
}

fn flex(src: []u8) ArrayList[FxToken] {
    let toks: ArrayList[FxToken] = make[FxToken](128);
    let n: i32 = src.len;
    let i: i32 = 0;
    let line: i32 = 1;
    let expect_trit_type: i32 = 0;
    let in_trit_rhs: i32 = 0;

    while (i < n) {
        let c: i32 = fx_ch(src, i);
        if (c == 10) {
            line = line + 1;
            i = i + 1;
        } else if (fx_is_space(c) == 1) {
            i = i + 1;
        } else if (c == 47 && i + 1 < n && fx_ch(src, i + 1) == 47) {
            while (i < n && fx_ch(src, i) != 10) { i = i + 1; }
        } else if (c == 47 && i + 1 < n && fx_ch(src, i + 1) == 42) {
            i = i + 2;
            let cmt_done: i32 = 0;
            while (i + 1 < n && cmt_done == 0) {
                if (fx_ch(src, i) == 42 && fx_ch(src, i + 1) == 47) {
                    i = i + 2;
                    cmt_done = 1;
                } else {
                    if (fx_ch(src, i) == 10) { line = line + 1; }
                    i = i + 1;
                }
            }
        } else if (c == 64) {
            let start: i32 = i;
            i = i + 1;
            while (i < n && fx_is_alnum(fx_ch(src, i)) == 1) { i = i + 1; }
            push[FxToken](&toks, fx_mk(fx_annot(), src[start..i], line));
            expect_trit_type = 0;
        } else if (fx_is_alpha(c) == 1) {
            let start: i32 = i;
            i = i + 1;
            while (i < n && fx_is_alnum(fx_ch(src, i)) == 1) { i = i + 1; }
            let word: []u8 = src[start..i];
            let k: i32 = fx_word_kind(word);
            push[FxToken](&toks, fx_mk(k, word, line));
            if (expect_trit_type == 1 && k == fx_kw_trit()) {
                expect_trit_type = 2;
            } else {
                expect_trit_type = 0;
            }
        } else if (fx_is_digit(c) == 1) {
            let start: i32 = i;
            let is_float: i32 = 0;
            let is_hex: i32 = 0;
            i = i + 1;
            if (c == 48 && i < n) {
                let nx: i32 = fx_ch(src, i);
                if (nx == 120 || nx == 88) {
                    is_hex = 1;
                    i = i + 1;
                    let hex_done: i32 = 0;
                    while (i < n && hex_done == 0) {
                        let d: i32 = fx_ch(src, i);
                        if (fx_is_hex_digit(d) == 1) {
                            i = i + 1;
                        } else if (d == 95 && i + 1 < n && fx_is_hex_digit(fx_ch(src, i + 1)) == 1) {
                            i = i + 1;
                        } else {
                            hex_done = 1;
                        }
                    }
                }
            }
            if (is_hex == 0) {
                let done: i32 = 0;
                while (i < n && done == 0) {
                    let d: i32 = fx_ch(src, i);
                    if (fx_is_digit(d) == 1) {
                        i = i + 1;
                    } else if (d == 95 && i + 1 < n && fx_is_digit(fx_ch(src, i + 1)) == 1) {
                        i = i + 1;
                    } else if (d == 46 && is_float == 0 && i + 1 < n && fx_is_digit(fx_ch(src, i + 1)) == 1) {
                        is_float = 1;
                        i = i + 1;
                    } else {
                        done = 1;
                    }
                }
            }
            let slice: []u8 = fx_strip_underscores(src[start..i]);
            let k: i32 = fx_int();
            if (is_float == 1) {
                k = fx_float();
            } else if (is_hex == 0 && in_trit_rhs == 1 && slice.len == 1) {
                let d0: i32 = fx_ch(slice, 0);
                if (d0 == 48 || d0 == 49) {
                    k = fx_tritlit();
                    in_trit_rhs = 0;
                }
            }
            push[FxToken](&toks, fx_mk(k, slice, line));
            expect_trit_type = 0;
        } else if (c == 34) {
            let start: i32 = i;
            i = i + 1;
            while (i < n && fx_ch(src, i) != 34) {
                if (fx_ch(src, i) == 92 && i + 1 < n) { i = i + 2; }
                else { i = i + 1; }
            }
            i = i + 1;
            push[FxToken](&toks, fx_mk(fx_str(), src[start..i], line));
            expect_trit_type = 0;
        } else if (c == 39) {
            i = i + 1;
            let cv: i32 = 0;
            if (fx_ch(src, i) == 92 && i + 1 < n) {
                i = i + 1;
                let e: i32 = fx_ch(src, i);
                if (e == 110) { cv = 10; }
                else if (e == 116) { cv = 9; }
                else if (e == 114) { cv = 13; }
                else if (e == 48) { cv = 0; }
                else { cv = e; }
                i = i + 1;
            } else {
                cv = fx_ch(src, i);
                i = i + 1;
            }
            if (i < n && fx_ch(src, i) == 39) { i = i + 1; }
            push[FxToken](&toks, fx_mk(fx_int(), _zag_i64_to_str(cv as i64), line));
            expect_trit_type = 0;
        } else if (c == 46 && i + 1 < n && fx_ch(src, i + 1) == 46) {
            push[FxToken](&toks, fx_mk(fx_dotdot(), src[i..i + 2], line));
            i = i + 2;
            expect_trit_type = 0;
        } else if (fx_is_two_op(src, i, n) == 1) {
            push[FxToken](&toks, fx_mk(fx_op(), src[i..i + 2], line));
            in_trit_rhs = 0;
            expect_trit_type = 0;
            i = i + 2;
        } else {
            let pk: i32 = fx_punct_kind(c);
            let one: []u8 = src[i..i + 1];
            let tok_kind: i32 = pk;
            if (pk == fx_op() && fx_is_single_op(c) == 0) {
                tok_kind = fx_err();
            }
            push[FxToken](&toks, fx_mk(tok_kind, one, line));
            if (pk == fx_colon()) {
                expect_trit_type = 1;
            } else if (pk == fx_semi()) {
                in_trit_rhs = 0;
                expect_trit_type = 0;
            } else if (pk == fx_op() && c == 61) {
                if (expect_trit_type == 2) { in_trit_rhs = 1; }
                else { in_trit_rhs = 0; }
                expect_trit_type = 0;
            } else {
                expect_trit_type = 0;
            }
            i = i + 1;
        }
    }

    push[FxToken](&toks, fx_mk(fx_eof(), src[0..0], line));
    return toks;
}
