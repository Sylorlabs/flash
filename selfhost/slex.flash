// selfhost/slex.flash.zag — Flash surface-DSL lexer library, written in Flash.
//
// Stage-1 port of flash_lex() from flash/compiler/flash_lex.zag. Library file
// (no main): imported by other selfhost sources via Flash-to-Flash @import.
// Token kinds are i32 codes so they cross the emit boundary trivially.

@import("std/list.flash")

fn sfk_eof() i32        { return 0; }
fn sfk_err() i32        { return 99; }
fn sfk_ident() i32      { return 1; }
fn sfk_int() i32        { return 2; }
fn sfk_float() i32      { return 3; }
fn sfk_str() i32        { return 4; }
fn sfk_kw_program() i32 { return 10; }
fn sfk_kw_trit() i32    { return 11; }
fn sfk_kw_wave() i32    { return 12; }
fn sfk_kw_p32() i32     { return 13; }
fn sfk_kw_sat_i16() i32 { return 14; }
fn sfk_kw_raw() i32     { return 15; }
fn sfk_kw_let() i32     { return 16; }
fn sfk_kw_optical() i32 { return 17; }
fn sfk_kw_default() i32 { return 18; }
fn sfk_eq() i32         { return 30; }
fn sfk_lbrace() i32     { return 31; }
fn sfk_rbrace() i32     { return 32; }
fn sfk_lp() i32         { return 33; }
fn sfk_rp() i32         { return 34; }
fn sfk_comma() i32      { return 35; }
fn sfk_semi() i32       { return 36; }

struct SfToken {
    kind: i32,
    text: []u8,
    line: i32,
}

fn sf_ch(src: []u8, i: i32) i32 {
    return src[i] as i32;
}

fn sf_digit(c: i32) i32 {
    if (c >= '0' && c <= '9') { return 1; }
    return 0;
}

fn sf_alpha(c: i32) i32 {
    if (c >= 'a' && c <= 'z') { return 1; }
    if (c >= 'A' && c <= 'Z') { return 1; }
    if (c == '_') { return 1; }
    return 0;
}

fn sf_alnum(c: i32) i32 {
    if (sf_alpha(c) == 1 || sf_digit(c) == 1) { return 1; }
    return 0;
}

fn sf_space(c: i32) i32 {
    if (c == ' ' || c == '\t' || c == '\r' || c == '\n') { return 1; }
    return 0;
}

fn sf_kw(w: []u8) i32 {
    if (@strEq(w, "program") == 1) { return sfk_kw_program(); }
    if (@strEq(w, "trit") == 1)    { return sfk_kw_trit(); }
    if (@strEq(w, "wave") == 1)    { return sfk_kw_wave(); }
    if (@strEq(w, "p32") == 1)     { return sfk_kw_p32(); }
    if (@strEq(w, "sat_i16") == 1) { return sfk_kw_sat_i16(); }
    if (@strEq(w, "raw") == 1)     { return sfk_kw_raw(); }
    if (@strEq(w, "let") == 1)     { return sfk_kw_let(); }
    if (@strEq(w, "optical") == 1) { return sfk_kw_optical(); }
    if (@strEq(w, "default") == 1) { return sfk_kw_default(); }
    return sfk_ident();
}

fn sf_mk(kind: i32, text: []u8, line: i32) SfToken {
    return SfToken{ .kind = kind, .text = text, .line = line };
}

fn sf_punct_kind(c: i32) i32 {
    if (c == '=') { return sfk_eq(); }
    if (c == '{') { return sfk_lbrace(); }
    if (c == '}') { return sfk_rbrace(); }
    if (c == '(') { return sfk_lp(); }
    if (c == ')') { return sfk_rp(); }
    if (c == ',') { return sfk_comma(); }
    if (c == ';') { return sfk_semi(); }
    return sfk_err();
}

fn slex_surface(src: []u8) ArrayList[SfToken] {
    let out: ArrayList[SfToken] = make[SfToken](64);
    let n: i32 = src.len;
    let i: i32 = 0;
    let line: i32 = 1;
    while (i < n) {
        let c: i32 = sf_ch(src, i);
        if (sf_space(c) == 1) {
            if (c == '\n') { line = line + 1; }
            i = i + 1;
        } else if (c == '/' && i + 1 < n && sf_ch(src, i + 1) == '/') {
            i = i + 2;
            while (i < n && sf_ch(src, i) != '\n') { i = i + 1; }
        } else if (c == '"') {
            let start: i32 = i + 1;
            i = i + 1;
            while (i < n && sf_ch(src, i) != '"') { i = i + 1; }
            push[SfToken](&out, sf_mk(sfk_str(), src[start..i], line));
            i = i + 1;
        } else if (c == '+' || c == '-') {
            if (i + 1 < n && sf_digit(sf_ch(src, i + 1)) == 1) {
                let start: i32 = i;
                i = i + 1;
                while (i < n && sf_digit(sf_ch(src, i)) == 1) { i = i + 1; }
                push[SfToken](&out, sf_mk(sfk_int(), src[start..i], line));
            } else if (c == '+') {
                push[SfToken](&out, sf_mk(sfk_int(), "+1", line));
                i = i + 1;
            } else {
                push[SfToken](&out, sf_mk(sfk_ident(), "T", line));
                i = i + 1;
            }
        } else if (sf_digit(c) == 1) {
            let start: i32 = i;
            let is_float: i32 = 0;
            i = i + 1;
            while (i < n && sf_digit(sf_ch(src, i)) == 1) { i = i + 1; }
            if (i < n && sf_ch(src, i) == '.') {
                is_float = 1;
                i = i + 1;
                while (i < n && sf_digit(sf_ch(src, i)) == 1) { i = i + 1; }
            }
            if (is_float == 1) {
                push[SfToken](&out, sf_mk(sfk_float(), src[start..i], line));
            } else {
                push[SfToken](&out, sf_mk(sfk_int(), src[start..i], line));
            }
        } else if (sf_alpha(c) == 1) {
            let start: i32 = i;
            i = i + 1;
            while (i < n && sf_alnum(sf_ch(src, i)) == 1) { i = i + 1; }
            let w: []u8 = src[start..i];
            push[SfToken](&out, sf_mk(sf_kw(w), w, line));
        } else {
            let pk: i32 = sf_punct_kind(c);
            push[SfToken](&out, sf_mk(pk, src[i..i + 1], line));
            i = i + 1;
        }
    }
    push[SfToken](&out, sf_mk(sfk_eof(), "", line));
    return out;
}
