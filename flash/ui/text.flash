// flash/ui/text.flash — text layout: word-wrapping, alignment, rich runs.
//
// Builds on the vector font (vgpu.flash). Wraps text at word boundaries to a
// pixel width, aligns each line (left/center/right/justify), and flows mixed
// styled runs (size/weight/colour spans) inline — the primitives a browser
// and native apps need for real text.
//
//   let end_y: i32 = text_paint(fb, x, y, "long text...", 13.0, 0.6,
//                               220,222,235,255, width, TEXT_LEFT(), 20);

@import("../driver/vgpu.flash")

fn TEXT_LEFT() i32    { return 0; }
fn TEXT_CENTER() i32  { return 1; }
fn TEXT_RIGHT() i32   { return 2; }
fn TEXT_JUSTIFY() i32 { return 3; }

// Fixed advance matching the vector font (13 grid units at 14px cap height).
fn text_advance(size: f32) f32 { return size * 13.0 / 14.0; }

fn text_width(s: []u8, size: f32) f32 {
    return (s.len as f32) * text_advance(size);
}

fn text_is_space(c: u8) i32 {
    if (c == 32 || c == 9 || c == 10 || c == 13) { return 1; }
    return 0;
}

// Draw one line span [a,b) at (x,y), aligned within max_w. When justify and
// not the last line, stretch inter-word gaps to fill the width.
fn text_draw_line(fb: *SoftFb, x: f32, y: f32, s: []u8, a: i32, b: i32,
                  size: f32, weight: f32, r: i32, g: i32, bl: i32, al: i32,
                  max_w: f32, align: i32, last: i32) void {
    let adv: f32 = text_advance(size);
    let n: i32 = b - a;
    if (n < 1) { return; }
    let line_w: f32 = (n as f32) * adv;

    if (align == TEXT_JUSTIFY() && last == 0) {
        // count gaps (space runs) and distribute slack
        let gaps: i32 = 0;
        let i: i32 = a;
        while (i < b) { if (s[i] == (32 as u8)) { gaps = gaps + 1; } i = i + 1; }
        let slack: f32 = max_w - line_w;
        let extra: f32 = 0.0;
        if (gaps > 0 && slack > 0.0) { extra = slack / (gaps as f32); }
        let cx: f32 = x;
        i = a;
        while (i < b) {
            vg_text_vec(fb, cx, y, s[i..i + 1], size, weight, r, g, bl, al);
            cx = cx + adv;
            if (s[i] == (32 as u8)) { cx = cx + extra; }
            i = i + 1;
        }
        return;
    }

    let off: f32 = 0.0;
    if (align == TEXT_CENTER()) { off = (max_w - line_w) * 0.5; }
    else if (align == TEXT_RIGHT()) { off = max_w - line_w; }
    if (off < 0.0) { off = 0.0; }
    vg_text_vec(fb, x + off, y, s[a..b], size, weight, r, g, bl, al);
}

// Wrap + paint. Returns the y just past the last line.
fn text_paint(fb: *SoftFb, x: i32, y: i32, s: []u8, size: f32, weight: f32,
              r: i32, g: i32, b: i32, a: i32, max_w: i32, align: i32, line_h: i32) i32 {
    let adv: f32 = text_advance(size);
    let max_chars: i32 = (max_w as f32 / adv) as i32;
    if (max_chars < 1) { max_chars = 1; }

    let line_y: i32 = y;
    let at: i32 = 0;
    while (at < s.len) {
        // skip leading spaces
        while (at < s.len && text_is_space(s[at]) == 1) { at = at + 1; }
        if (at >= s.len) { return line_y; }
        let end: i32 = at + max_chars;
        if (end >= s.len) { end = s.len; }
        else {
            // back up to the last space so words don't split
            let split: i32 = end;
            while (split > at && s[split] != (32 as u8)) { split = split - 1; }
            if (split > at) { end = split; }
        }
        let last: i32 = 0;
        if (end >= s.len) { last = 1; }
        // trim trailing spaces from the drawn span
        let de: i32 = end;
        while (de > at && text_is_space(s[de - 1]) == 1) { de = de - 1; }
        text_draw_line(fb, x as f32, line_y as f32, s, at, de, size, weight,
                       r, g, b, a, max_w as f32, align, last);
        line_y = line_y + line_h;
        at = end;
    }
    return line_y;
}

// ── rich runs (inline styled spans) ──────────────────────────────────────────
//
// A run is (text, size, weight, colour). text_flow lays runs out inline with
// word-wrapping across run boundaries — for bold/colour spans, links, etc.

struct TextRun {
    text: []u8,
    size: f32,
    weight: f32,
    r: i32, g: i32, b: i32, a: i32,
}

fn text_run(text: []u8, size: f32, weight: f32, r: i32, g: i32, b: i32, a: i32) TextRun {
    return TextRun{ .text = text, .size = size, .weight = weight, .r = r, .g = g, .b = b, .a = a };
}

// Flow a list of runs from (x,y) within max_w, wrapping at spaces. Returns the
// y past the last line. Wraps whole words; a word never splits mid-run.
fn text_flow(fb: *SoftFb, x: i32, y: i32, max_w: i32, runs: *TextRun, count: i32, line_h: i32) i32 {
    let cx: f32 = x as f32;
    let cy: i32 = y;
    let right: f32 = (x + max_w) as f32;
    let ri: i32 = 0;
    while (ri < count) {
        let run: TextRun = runs[ri];
        let adv: f32 = text_advance(run.size);
        let at: i32 = 0;
        while (at < run.text.len) {
            // next word (skip leading spaces, keeping one gap)
            let ws: i32 = at;
            while (ws < run.text.len && run.text[ws] == (32 as u8)) { ws = ws + 1; }
            let we: i32 = ws;
            while (we < run.text.len && run.text[we] != (32 as u8)) { we = we + 1; }
            let word: []u8 = run.text[ws..we];
            let wpx: f32 = (word.len as f32) * adv;
            // wrap if the word won't fit and we're not at line start
            if (cx > (x as f32) && cx + wpx > right) {
                cx = x as f32;
                cy = cy + line_h;
            } else if (ws > at) {
                cx = cx + adv;   // the space we skipped
            }
            if (word.len > 0) {
                vg_text_vec(fb, cx, cy as f32, word, run.size, run.weight, run.r, run.g, run.b, run.a);
                cx = cx + wpx;
            }
            at = we;
        }
        ri = ri + 1;
    }
    return cy + line_h;
}
