// Pure-Flash Linux x86-64 transport substrate.
//
// Syscall numbers and i64 pointer carriers are confined to this OS ABI module.
// Application/runtime state remains in Flash native balanced-ternary types.

struct LinuxFdPair {
    first: i64,
    second: i64,
    ok: i32,
}

struct LinuxByteBuffer {
    words: ArrayList[i64],
    len: i32,
    capacity_bytes: i32,
}

struct LinuxConnectResult {
    fd: i64,
    error_code: i64,
    connected: i32,
}

// Pathname AF_UNIX server results make descriptor and filesystem ownership
// explicit. A successful listener transfers fd ownership to the caller. When
// path_bound is one, the caller owns exact-path cleanup even if listen failed.
struct LinuxUnixListenResult {
    fd: i64,
    last_closed_fd: i64,
    error_code: i64,
    path_bound: i32,
    listening: i32,
    cloexec_applied: i32,
    nonblocking_applied: i32,
    permissions_applied: i32,
    close_error: i32,
}

// A successful accept transfers fd ownership to the caller. Failed accepted
// descriptors are closed internally and exposed only through last_closed_fd so
// tests and callers can audit ownership without reusing them.
struct LinuxUnixAcceptResult {
    fd: i64,
    last_closed_fd: i64,
    error_code: i64,
    accepted: i32,
    timed_out: i32,
    cloexec_applied: i32,
    close_error: i32,
}

struct LinuxUnixUnlinkResult {
    error_code: i64,
    removed: i32,
    missing: i32,
    path_valid: i32,
}

// Internal descriptor setup result. ABI flags stay inside this module; callers
// observe explicit ownership and balanced-ternary status values.
struct LinuxDescriptorResult {
    fd: i64,
    last_closed_fd: i64,
    error_code: i64,
    valid: i32,
    cloexec_applied: i32,
    nonblocking_applied: i32,
    close_error: i32,
}

// Exact stream writes report progress separately from the terminal syscall
// result. A protocol owner can therefore retire a connection if an error
// follows a partial frame instead of accidentally continuing at a new frame.
struct LinuxWriteAllResult {
    written: i64,
    error_code: i64,
    complete: i32,
}

struct LinuxPipeWriteResult {
    written: i64,
    error_code: i64,
    cleanup_error_code: i64,
    complete: i32,
}

// Bounded directional-pipe reads preserve partial progress separately from
// EOF, timeout/error, and an authoritative size rejection. The descriptor
// remains caller-owned and its original status flags are restored before return.
struct LinuxReadAllResult {
    data: LinuxByteBuffer,
    read: i64,
    error_code: i64,
    cleanup_error_code: i64,
    complete: i32,
    eof: i32,
    too_large: i32,
}

// Thread-local SIGPIPE containment owns old_mask while active. This prevents a
// closed pipe reader from terminating the process before write(2) can report
// EPIPE, without changing process-wide signal disposition.
struct LinuxSigpipeGuard {
    old_mask: LinuxByteBuffer,
    was_pending: i32,
    active: i32,
    error_code: i64,
    cleanup_error_code: i64,
}

struct LinuxSharedMemory {
    fd: i64,
    address: i64,
    len: i64,
    valid: i32,
}

// Read-only mapping that takes ownership of an existing descriptor. This is
// distinct from LinuxSharedMemory so callers cannot accidentally use the
// writable shared-memory helpers on a PROT_READ mapping.
struct LinuxReadOnlyMapping {
    fd: i64,
    address: i64,
    len: i64,
    error_code: i64,
    close_error: i32,
    valid: i32,
}

struct LinuxFileStatus {
    size: i64,
    mode: t27,
    regular: i32,
    error_code: i64,
    valid: i32,
}

// The caller always owns data and, when has_fd is one, received_fd. ok means a
// non-empty payload arrived without payload/control truncation or malformed
// ancillary state; a valid data-only recvmsg therefore has ok=1, has_fd=0.
struct LinuxReceiveFdResult {
    data: LinuxByteBuffer,
    received_fd: i64,
    got: i64,
    payload_received: i32,
    has_fd: i32,
    fd_count: t27,
    excess_fd_count: t27,
    closed_fd_count: t27,
    last_closed_fd: i64,
    message_truncated: i32,
    control_truncated: i32,
    control_invalid: i32,
    close_error: i32,
    cloexec_applied: i32,
    error_code: i64,
    ok: i32,
}

// Internal ownership result for SCM_RIGHTS parsing. At most one descriptor is
// retained for the caller. Every additional descriptor, and every descriptor
// discovered before a malformed/truncated control record, is closed here.
struct LinuxControlFdResult {
    received_fd: i64,
    fd_count: t27,
    excess_fd_count: t27,
    closed_fd_count: t27,
    last_closed_fd: i64,
    invalid: i32,
    close_error: i32,
}

// One recvmsg result for stream demarshallers. Descriptor order is the kernel
// SCM_RIGHTS order and is independent of payload chunk boundaries. The caller
// owns data and every non-negative entry in fds until it takes an entry or
// calls linux_receive_fds_result_free. Peer metadata never controls capacity:
// accepted_fd_cap is validated against linux_receive_fds_max_count first.
struct LinuxReceiveFdsResult {
    data: LinuxByteBuffer,
    fds: ArrayList[i64],
    accepted_fd_cap: t27,
    got: i64,
    payload_received: i32,
    eof: i32,
    fd_count: t27,
    retained_fd_count: t27,
    close_attempt_count: t27,
    closed_fd_count: t27,
    last_closed_fd: i64,
    message_truncated: i32,
    control_truncated: i32,
    control_invalid: i32,
    fd_overflow: i32,
    close_error_code: i64,
    cloexec_applied_count: t27,
    used_cmsg_cloexec: i32,
    error_code: i64,
    ok: i32,
    released: i32,
}

// Internal ordered ownership result. On invalid/overflow/discard paths fds is
// empty and every descriptor parsed from the kernel control buffer has already
// had a close attempt recorded.
struct LinuxControlFdsResult {
    fds: ArrayList[i64],
    fd_count: t27,
    retained_fd_count: t27,
    close_attempt_count: t27,
    closed_fd_count: t27,
    last_closed_fd: i64,
    invalid: i32,
    overflow: i32,
    close_error_code: i64,
}

fn linux_sys_read() i64 { return 0; }
fn linux_sys_write() i64 { return 1; }
fn linux_sys_close() i64 { return 3; }
fn linux_sys_stat() i64 { return 4; }
fn linux_sys_fstat() i64 { return 5; }
fn linux_sys_mmap() i64 { return 9; }
fn linux_sys_munmap() i64 { return 11; }
fn linux_sys_rt_sigaction() i64 { return 13; }
fn linux_sys_rt_sigprocmask() i64 { return 14; }
fn linux_sys_pipe() i64 { return 22; }
fn linux_sys_poll() i64 { return 7; }
fn linux_sys_getpid() i64 { return 39; }
fn linux_sys_socket() i64 { return 41; }
fn linux_sys_connect() i64 { return 42; }
fn linux_sys_accept() i64 { return 43; }
fn linux_sys_sendto() i64 { return 44; }
fn linux_sys_bind() i64 { return 49; }
fn linux_sys_listen() i64 { return 50; }
fn linux_sys_socketpair() i64 { return 53; }
