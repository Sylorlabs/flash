// photonic_rt.zag — software simulation driver for Active Lattice chamber externs
//
// Provides the bodies for _flash_raw_* (raw.zag) and _flash_* pipeline symbols
// (pipeline.zag).  Links at compile time when this module is imported alongside
// the wave modules that declare those names as extern.
//
// DEPENDENCY: chamber_sim.zag (chamber grid), std/rt.zag (system calls)

@import("../toolchain/zag-poc/std/rt.zag")
@import("chamber_sim.zag")

// znc native has no writable module globals and does not lower custom C externs.
// Persist the driver heap block via a pid-scoped cache file under /tmp (software sim only).
// On Linux reads /proc/self/pid so parallel test processes do not share one pointer file.
fn rt_trim_newline(s: []u8) []u8 {
    if (s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}

fn RT_STATE_CACHE() []u8 {
    if (_zag_file_exists("/proc/self/pid") == 1) {
        let raw: []u8 = _zag_read_file("/proc/self/pid");
        if (raw.len > 0) {
            let pid: []u8 = rt_trim_newline(raw);
            return _zag_str_concat(_zag_str_concat("/tmp/flash_rt_state.", pid), ".ptr");
        }
    }
    return "/tmp/flash_rt_state.ptr";
}
fn RT_STATE_MAGIC() i32 { return 1179406920; } // "FLRH" (0x464C5248) — validates cached pointer

struct PhotonicRtState {
    magic:        i32,
    grid:         ChamberGrid,
    raw_active:   i32,
    target_x:     i32,
    target_y:     i32,
    target_z:     i32,
    laser_mw_0:   f32,
    laser_mw_1:   f32,
    laser_mw_2:   f32,
    laser_mw_3:   f32,
    pipe_active:  i32,
    pipe_col:     i32,
    pipe_dep:     i32,
    pipe_head_z:  i32,
}

fn rt_state_new() PhotonicRtState {
    let grid: ChamberGrid = ChamberGrid{
        .cells = null as *VoxelCell,
        .edge  = CHAMBER_EDGE(),
        .ready = 0,
    };
    return PhotonicRtState{
        .magic       = RT_STATE_MAGIC(),
        .grid        = grid,
        .raw_active  = 0,
        .target_x    = 0,
        .target_y    = 0,
        .target_z    = 0,
        .laser_mw_0  = 0.0,
        .laser_mw_1  = 0.0,
        .laser_mw_2  = 0.0,
        .laser_mw_3  = 0.0,
        .pipe_active = 0,
        .pipe_col    = 0,
        .pipe_dep    = 0,
        .pipe_head_z = 0,
    };
}

fn rt_state_ptr_from_cache() ?*PhotonicRtState {
    if (_zag_file_exists(RT_STATE_CACHE()) == 0) { return null; }
    let text: []u8 = _zag_read_file(RT_STATE_CACHE());
    if (text.len < 1) { return null; }
    let addr: i64 = _zag_str_to_i64(text);
    if (addr == 0) { return null; }
    let st: *PhotonicRtState = addr as *PhotonicRtState;
    if (st.*.magic != RT_STATE_MAGIC()) { return null; }
    return st;
}

fn rt_state_ptr_to_cache(st: *PhotonicRtState) void {
    let text: []u8 = _zag_i64_to_str(st as i64);
    _zag_write_file(RT_STATE_CACHE(), text);
}

fn rt_state_mut() *PhotonicRtState {
    if (rt_state_ptr_from_cache()) |cached| {
        return cached;
    }
    let size: i32 = @sizeOf[PhotonicRtState]();
    let raw: *i8 = _zag_malloc(size);
    let st: *PhotonicRtState = raw as *PhotonicRtState;
    st.* = rt_state_new();
    rt_state_ptr_to_cache(st);
    return st;
}

fn rt_state_shutdown() void {
    if (rt_state_ptr_from_cache()) |st| {
        let path: []u8 = RT_STATE_CACHE();
        if (st.*.grid.ready == 1 && st.*.grid.cells != null) {
            _zag_free(st.*.grid.cells as *i8);
            st.*.grid.cells = null;
            st.*.grid.ready = 0;
        }
        st.*.magic = 0;
        _zag_free(st as *i8);
        let rm_cmd: []u8 = _zag_str_concat("rm -f ", path);
        _zag_exec_cmd(rm_cmd);
    }
}

fn ensure_chamber(st: *PhotonicRtState) void {
    chamber_init(&st.*.grid);
}

fn laser_slot_set_mw(st: *PhotonicRtState, wall: i32, slot: i32, mw: f32) i32 {
    if (slot != 0) { return 0; }
    if (wall == 0) { st.*.laser_mw_0 = mw; return 1; }
    if (wall == 1) { st.*.laser_mw_1 = mw; return 1; }
    if (wall == 2) { st.*.laser_mw_2 = mw; return 1; }
    if (wall == 3) { st.*.laser_mw_3 = mw; return 1; }
    return 0;
}

// ── raw {} hardware bindings ──────────────────────────────────────────────────

fn _flash_raw_mode_enter() i32 @io {
    let st: *PhotonicRtState = rt_state_mut();
    ensure_chamber(st);
    if (st.*.raw_active == 1) { return 0; }
    st.*.raw_active = 1;
    return 1;
}

fn _flash_raw_mode_exit() i32 @io {
    let st: *PhotonicRtState = rt_state_mut();
    st.*.raw_active = 0;
    return 1;
}

fn _flash_raw_fire_shield(x: i32, y: i32, z: i32, mw: f32) i32 @io {
    let st: *PhotonicRtState = rt_state_mut();
    ensure_chamber(st);
    if (st.*.raw_active == 0) { return 0; }
    st.*.target_x = x;
    st.*.target_y = y;
    st.*.target_z = z;
    return chamber_fire_shield(&st.*.grid, x, y, z, mw);
}

fn _flash_raw_inject_phase(x: i32, y: i32, z: i32, phase: f32) i32 @io {
    let st: *PhotonicRtState = rt_state_mut();
    ensure_chamber(st);
    if (st.*.raw_active == 0) { return 0; }
    return chamber_set_phase(&st.*.grid, x, y, z, phase);
}

fn _flash_raw_set_laser_mw(wall: i32, slot: i32, mw: f32) i32 @io {
    let st: *PhotonicRtState = rt_state_mut();
    ensure_chamber(st);
    if (st.*.raw_active == 0) { return 0; }
    return laser_slot_set_mw(st, wall, slot, mw);
}

fn _flash_raw_target_voxel(x: i32, y: i32, z: i32) i32 @io {
    let st: *PhotonicRtState = rt_state_mut();
    ensure_chamber(st);
    if (st.*.raw_active == 0) { return 0; }
    st.*.target_x = x;
    st.*.target_y = y;
    st.*.target_z = z;
    if (sim_voxel_in_bounds(st.*.grid.edge, x, y, z)) { return 1; }
    return 0;
}

fn _flash_raw_set_polarity(x: i32, y: i32, z: i32, pol: i32) i32 @io {
    let st: *PhotonicRtState = rt_state_mut();
    ensure_chamber(st);
    if (st.*.raw_active == 0) { return 0; }
    return chamber_set_polarity_tag(&st.*.grid, x, y, z, pol);
}

// ── vertical pipeline hardware bindings ───────────────────────────────────────

fn _flash_pipeline_activate(col: i32, dep: i32) i32 @io {
    let st: *PhotonicRtState = rt_state_mut();
    ensure_chamber(st);
    st.*.pipe_col = col;
    st.*.pipe_dep = dep;
    st.*.pipe_head_z = 0;
    st.*.pipe_active = 1;
    return 1;
}

fn _flash_pipeline_head_z(col: i32, dep: i32) i32 @io {
    let st: *PhotonicRtState = rt_state_mut();
    if (st.*.pipe_active == 0) { return 0; }
    if (st.*.pipe_col != col) { return 0; }
    if (st.*.pipe_dep != dep) { return 0; }
    return st.*.pipe_head_z;
}

fn _flash_stream_up(col: i32, dep: i32, src: []u8) i32 @io {
    let st: *PhotonicRtState = rt_state_mut();
    ensure_chamber(st);
    if (st.*.pipe_active == 0) { return 0; }
    if (st.*.pipe_col != col) { return 0; }
    if (st.*.pipe_dep != dep) { return 0; }
    if (src.len == 0) { return 0; }

    let edge: i32 = st.*.grid.edge;
    let pushed: i32 = 0;
    let i: i32 = 0;
    while (i < src.len) {
        let z: i32 = st.*.pipe_head_z + pushed;
        if (z >= edge) { i = src.len; }
        if (z < edge) {
            let amp: f32 = 0.75;
            let _ok: i32 = chamber_write_payload(&st.*.grid, col, dep, z, src[i], amp);
            pushed = pushed + 1;
        }
        i = i + 1;
    }
    st.*.pipe_head_z = st.*.pipe_head_z + pushed;
    return pushed;
}

fn _flash_read_voxel(x: i32, y: i32, z: i32) u64 @io {
    let st: *PhotonicRtState = rt_state_mut();
    ensure_chamber(st);
    return chamber_read_word(st.*.grid, x, y, z);
}

// Sign-extend balanced-trit i8 wire for znc host printing (i8 casts as u8).
fn runtime_pol_wire(pol: i8) i32 {
    let x: i32 = pol as i32;
    if (x == 255) { return 0 - 1; }
    if (x > 127) { return x - 256; }
    return x;
}

// Test/diagnostic accessor for chamber voxel state.
fn runtime_voxel_at(x: i32, y: i32, z: i32) ?VoxelCell {
    let st: *PhotonicRtState = rt_state_mut();
    ensure_chamber(st);
    return chamber_get(st.*.grid, x, y, z);
}