// flash/compiler/flash_lex.zag — unified Flash lexer (full language + surface DSL).
//
//   lex()       — Zag-compatible full Flash lexer (flash_parse.zag)
//   flash_lex() — compact .flash.zag surface DSL (flashc / parse.zag)
//
// Replaces the former standalone lex.zag; both token streams live here.

@import("../toolchain/zag-poc/std/list.zag")

// ── token kinds ──────────────────────────────────────────────────────────────
enum Tk {
    Eof, Err, Ident, Annot, Op, Str, Int, Float, Type,
    TritLit,
    KwFn, KwExtern, KwLet, KwReturn, KwIf, KwElse, KwWhile,
    KwTrue, KwFalse, KwStruct, KwEnum, KwUnion, KwSwitch,
    KwError, KwTry, KwCatch, KwNull, KwOrelse, KwPub,
    KwRaw, KwWave, KwBeam, KwPhase, KwTrit, KwImport, KwChamber, KwLattice, KwStripe,
    Lp, Rp, Lbrace, Rbrace, Lbracket, Rbracket,
    Comma, Semi, Colon, Dot, Pipe, DotDot,
}

struct Token {
    kind:      Tk,
    val:       []u8,
    line:      i32,
    col:       i32,
    raw_depth: i32,   // nesting inside raw { } (0 = not in raw block)
}

fn tk_code(k: Tk) i32 {
    return switch (k) {
        .Eof => 0, .Err => 99, .Ident => 1, .Annot => 2, .Op => 3, .Str => 4,
        .Int => 5, .Float => 6, .Type => 7, .TritLit => 8,
        .KwFn => 10, .KwExtern => 11, .KwLet => 12, .KwReturn => 13,
        .KwIf => 14, .KwElse => 15, .KwWhile => 16, .KwTrue => 17,
        .KwFalse => 18, .KwStruct => 19, .KwEnum => 20, .KwUnion => 21,
        .KwSwitch => 22, .KwError => 23, .KwTry => 24, .KwCatch => 25,
        .KwNull => 26, .KwOrelse => 27, .KwPub => 28,
        .KwRaw => 70, .KwWave => 71, .KwBeam => 72, .KwPhase => 73,
        .KwTrit => 74, .KwImport => 75, .KwChamber => 76, .KwLattice => 77, .KwStripe => 78,
        .Lp => 40, .Rp => 41, .Lbrace => 42, .Rbrace => 43,
        .Lbracket => 44, .Rbracket => 45, .Comma => 46, .Semi => 47,
        .Colon => 48, .Dot => 49, .Pipe => 50, .DotDot => 51,
    };
}

fn ch(src: []u8, i: i32) i32 {
    return src[i] as i32;
}

fn is_digit(c: i32) bool {
    return c >= '0' && c <= '9';
}

fn is_alpha(c: i32) bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

fn is_alnum(c: i32) bool {
    return is_alpha(c) || is_digit(c);
}

fn is_space(c: i32) bool {
    return c == ' ' || c == '\t' || c == '\r' || c == '\n';
}

fn mk(kind: Tk, val: []u8, line: i32, col: i32) Token {
    return Token{ .kind = kind, .val = val, .line = line, .col = col, .raw_depth = 0 };
}

// Parse unsigned suffix digits; returns -1 if empty or non-digit.
fn parse_digits(w: []u8) i32 {
    if (w.len < 1) { return -1; }
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < w.len) {
        let c: i32 = ch(w, i);
        if (!is_digit(c)) { return -1; }
        n = n * 10 + (c - '0');
        i = i + 1;
    }
    return n;
}

fn type_eq(w: []u8, t: []u8) bool {
    return @strEq(w, t);
}

// Recognize Flash/Zag numeric type tokens (fixed + arbitrary i{N}/u{N}).
fn type_kind(w: []u8) Tk {
    if (type_eq(w, "i8") || type_eq(w, "i16") || type_eq(w, "i32") || type_eq(w, "i64")) {
        return Tk.Type;
    }
    if (type_eq(w, "u8") || type_eq(w, "u16") || type_eq(w, "u32") || type_eq(w, "u64")) {
        return Tk.Type;
    }
    if (type_eq(w, "f32") || type_eq(w, "f64")) { return Tk.Type; }
    if (type_eq(w, "p8") || type_eq(w, "p16") || type_eq(w, "p32") || type_eq(w, "p64")) {
        return Tk.Type;
    }
    if (type_eq(w, "sat_i16") || type_eq(w, "fixed_8_8") || type_eq(w, "u11")
        || type_eq(w, "u_any") || type_eq(w, "rns_3") || type_eq(w, "quire")) {
        return Tk.Type;
    }
    if (type_eq(w, "sat_i8") || type_eq(w, "sat_i32") || type_eq(w, "sat_i64")) {
        return Tk.Type;
    }
    if (type_eq(w, "sat_u8") || type_eq(w, "sat_u16") || type_eq(w, "sat_u32")
        || type_eq(w, "sat_u64")) {
        return Tk.Type;
    }
    if (type_eq(w, "i_any")) { return Tk.Type; }

    if (w.len >= 2) {
        let lead: i32 = ch(w, 0);
        if (lead == 'i' || lead == 'u') {
            let suffix: []u8 = w[1..w.len];
            let n: i32 = parse_digits(suffix);
            if (n >= 1 && n <= 127) { return Tk.Type; }
        }
    }
    return Tk.Ident;
}

fn zag_kw_kind(w: []u8) Tk {
    if (@strEq(w, "fn"))     { return Tk.KwFn; }
    if (@strEq(w, "extern")) { return Tk.KwExtern; }
    if (@strEq(w, "let"))    { return Tk.KwLet; }
    if (@strEq(w, "return")) { return Tk.KwReturn; }
    if (@strEq(w, "if"))     { return Tk.KwIf; }
    if (@strEq(w, "else"))   { return Tk.KwElse; }
    if (@strEq(w, "while"))  { return Tk.KwWhile; }
    if (@strEq(w, "true"))   { return Tk.KwTrue; }
    if (@strEq(w, "false"))  { return Tk.KwFalse; }
    if (@strEq(w, "struct")) { return Tk.KwStruct; }
    if (@strEq(w, "enum"))   { return Tk.KwEnum; }
    if (@strEq(w, "union"))  { return Tk.KwUnion; }
    if (@strEq(w, "switch")) { return Tk.KwSwitch; }
    if (@strEq(w, "error"))  { return Tk.KwError; }
    if (@strEq(w, "try"))    { return Tk.KwTry; }
    if (@strEq(w, "catch"))  { return Tk.KwCatch; }
    if (@strEq(w, "null"))   { return Tk.KwNull; }
    if (@strEq(w, "orelse")) { return Tk.KwOrelse; }
    if (@strEq(w, "pub"))    { return Tk.KwPub; }
    return Tk.Ident;
}

fn flash_kw_kind(w: []u8) Tk {
    if (@strEq(w, "raw"))     { return Tk.KwRaw; }
    if (@strEq(w, "wave"))    { return Tk.KwWave; }
    if (@strEq(w, "beam"))    { return Tk.KwBeam; }
    if (@strEq(w, "phase"))   { return Tk.KwPhase; }
    if (@strEq(w, "trit"))    { return Tk.KwTrit; }
    if (@strEq(w, "import"))  { return Tk.KwImport; }
    if (@strEq(w, "chamber")) { return Tk.KwChamber; }
    if (@strEq(w, "lattice")) { return Tk.KwLattice; }
    if (@strEq(w, "stripe"))  { return Tk.KwStripe; }
    return Tk.Ident;
}

fn word_kind(w: []u8) Tk {
    let z: Tk = zag_kw_kind(w);
    if (z != Tk.Ident) { return z; }
    let f: Tk = flash_kw_kind(w);
    if (f != Tk.Ident) { return f; }
    let t: Tk = type_kind(w);
    if (t != Tk.Ident) { return t; }
    if (@strEq(w, "T")) { return Tk.TritLit; }
    return Tk.Ident;
}

fn is_two_op(src: []u8, i: i32, n: i32) bool {
    if (i + 1 >= n) { return false; }
    let a: i32 = ch(src, i);
    let b: i32 = ch(src, i + 1);
    if (a == '=' && b == '=') { return true; }
    if (a == '!' && b == '=') { return true; }
    if (a == '<' && b == '=') { return true; }
    if (a == '>' && b == '=') { return true; }
    if (a == '&' && b == '&') { return true; }
    if (a == '|' && b == '|') { return true; }
    if (a == '<' && b == '<') { return true; }
    if (a == '>' && b == '>') { return true; }
    if (a == '=' && b == '>') { return true; }
    return false;
}

fn punct_kind(c: i32) Tk {
    if (c == '(') { return Tk.Lp; }
    if (c == ')') { return Tk.Rp; }
    if (c == '{') { return Tk.Lbrace; }
    if (c == '}') { return Tk.Rbrace; }
    if (c == '[') { return Tk.Lbracket; }
    if (c == ']') { return Tk.Rbracket; }
    if (c == ',') { return Tk.Comma; }
    if (c == ';') { return Tk.Semi; }
    if (c == ':') { return Tk.Colon; }
    if (c == '.') { return Tk.Dot; }
    if (c == '|') { return Tk.Pipe; }
    return Tk.Op;
}

fn is_single_op(c: i32) bool {
    if (c == '?') { return true; }
    if (c == '+') { return true; }
    if (c == '-') { return true; }
    if (c == '*') { return true; }
    if (c == '/') { return true; }
    if (c == '%') { return true; }
    if (c == '<') { return true; }
    if (c == '>') { return true; }
    if (c == '=') { return true; }
    if (c == '!') { return true; }
    if (c == '&') { return true; }
    if (c == '^') { return true; }
    return false;
}

fn is_trit_rhs_digit(val: []u8, in_trit_rhs: i32) bool {
    if (in_trit_rhs == 0) { return false; }
    if (val.len != 1) { return false; }
    let c: i32 = ch(val, 0);
    return c == '0' || c == '1';
}

fn lex(src: []u8) ArrayList[Token] {
    let toks: ArrayList[Token] = make[Token](128);
    let n: i32 = src.len;
    let i: i32 = 0;
    let line: i32 = 1;
    let line_start: i32 = 0;
    let expect_trit_type: i32 = 0;
    let in_trit_rhs: i32 = 0;

    while (i < n) {
        let c: i32 = ch(src, i);

        if (c == '\n') {
            line = line + 1;
            i = i + 1;
            line_start = i;
        } else if (is_space(c)) {
            i = i + 1;
        } else if (c == '/' && i + 1 < n && ch(src, i + 1) == '/') {
            while (i < n && ch(src, i) != '\n') { i = i + 1; }
        } else if (c == '/' && i + 1 < n && ch(src, i + 1) == '*') {
            i = i + 2;
            let cmt_done: bool = false;
            while (i + 1 < n && !cmt_done) {
                if (ch(src, i) == '*' && ch(src, i + 1) == '/') {
                    i = i + 2;
                    cmt_done = true;
                } else {
                    if (ch(src, i) == '\n') {
                        line = line + 1;
                        line_start = i + 1;
                    }
                    i = i + 1;
                }
            }
        } else if (c == '@') {
            let start: i32 = i;
            i = i + 1;
            while (i < n && is_alnum(ch(src, i))) { i = i + 1; }
            push[Token](&toks, mk(Tk.Annot, src[start..i], line, (start - line_start) + 1));
        } else if (is_alpha(c)) {
            let start: i32 = i;
            i = i + 1;
            while (i < n && is_alnum(ch(src, i))) { i = i + 1; }
            let word: []u8 = src[start..i];
            let k: Tk = word_kind(word);
            push[Token](&toks, mk(k, word, line, (start - line_start) + 1));
            if (expect_trit_type == 1 && k == Tk.KwTrit) {
                expect_trit_type = 2;
            } else {
                expect_trit_type = 0;
            }
        } else if (is_digit(c)) {
            let start: i32 = i;
            let is_float: bool = false;
            let done: bool = false;
            i = i + 1;
            while (i < n && !done) {
                let d: i32 = ch(src, i);
                if (is_digit(d)) {
                    i = i + 1;
                } else if (d == '.' && i + 1 < n && is_digit(ch(src, i + 1))) {
                    is_float = true;
                    i = i + 1;
                } else {
                    done = true;
                }
            }
            let slice: []u8 = src[start..i];
            let k: Tk = Tk.Int;
            if (is_float) {
                k = Tk.Float;
            } else if (is_trit_rhs_digit(slice, in_trit_rhs)) {
                k = Tk.TritLit;
                in_trit_rhs = 0;
            }
            push[Token](&toks, mk(k, slice, line, (start - line_start) + 1));
            expect_trit_type = 0;
        } else if (c == '"') {
            let start: i32 = i;
            i = i + 1;
            while (i < n && ch(src, i) != '"') {
                if (ch(src, i) == '\\' && i + 1 < n) { i = i + 2; }
                else { i = i + 1; }
            }
            i = i + 1;
            push[Token](&toks, mk(Tk.Str, src[start..i], line, (start - line_start) + 1));
            expect_trit_type = 0;
        } else if (c == 39) {
            let char_start: i32 = i;
            i = i + 1;
            let cv: i32 = 0;
            if (ch(src, i) == '\\' && i + 1 < n) {
                i = i + 1;
                let e: i32 = ch(src, i);
                if (e == 'n') { cv = 10; }
                else if (e == 't') { cv = 9; }
                else if (e == 'r') { cv = 13; }
                else if (e == '0') { cv = 0; }
                else { cv = e; }
                i = i + 1;
            } else {
                cv = ch(src, i);
                i = i + 1;
            }
            if (i < n && ch(src, i) == 39) { i = i + 1; }
            push[Token](&toks, mk(Tk.Int, _zag_i64_to_str(cv as i64), line, (char_start - line_start) + 1));
            expect_trit_type = 0;
        } else if (c == '.' && i + 1 < n && ch(src, i + 1) == '.') {
            push[Token](&toks, mk(Tk.DotDot, src[i..i + 2], line, (i - line_start) + 1));
            i = i + 2;
            expect_trit_type = 0;
        } else if (is_two_op(src, i, n)) {
            let op: []u8 = src[i..i + 2];
            push[Token](&toks, mk(Tk.Op, op, line, (i - line_start) + 1));
            in_trit_rhs = 0;
            expect_trit_type = 0;
            i = i + 2;
        } else {
            let pk: Tk = punct_kind(c);
            let one: []u8 = src[i..i + 1];
            let tok_kind: Tk = pk;
            if (pk == Tk.Op && !is_single_op(c)) {
                tok_kind = Tk.Err;
            }
            push[Token](&toks, mk(tok_kind, one, line, (i - line_start) + 1));
            if (pk == Tk.Colon) {
                expect_trit_type = 1;
            } else if (pk == Tk.Semi) {
                in_trit_rhs = 0;
                expect_trit_type = 0;
            } else if (pk == Tk.Op && c == '=') {
                if (expect_trit_type == 2) { in_trit_rhs = 1; }
                else { in_trit_rhs = 0; }
                expect_trit_type = 0;
            } else {
                expect_trit_type = 0;
            }
            i = i + 1;
        }
    }

    push[Token](&toks, mk(Tk.Eof, src[0..0], line, 0));
    return toks;
}

// ── surface DSL lexer (.flash.zag program format) ────────────────────────────
// Used by flashc for program/trit/wave/p32/sat_i16/raw blocks.  Full Flash
// sources use lex() above; flash_lex() below is the compact surface syntax.

enum Fk {
    Eof, Err, Ident, Int, Float, Str,
    KwProgram, KwTrit, KwWave, KwP32, KwSatI16, KwRaw, KwLet, KwOptical, KwDefault,
    Eq, Lbrace, Rbrace, Lp, Rp, Comma, Semi,
}

struct FToken {
    kind: Fk,
    val:  []u8,
    line: i32,
}

fn fk_ch(src: []u8, i: i32) i32 {
    return src[i] as i32;
}

fn fk_digit(c: i32) bool {
    return c >= '0' && c <= '9';
}

fn fk_alpha(c: i32) bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

fn fk_alnum(c: i32) bool {
    return fk_alpha(c) || fk_digit(c);
}

fn fk_space(c: i32) bool {
    return c == ' ' || c == '\t' || c == '\r' || c == '\n';
}

fn fk_kw(w: []u8) Fk {
    if (@strEq(w, "program"))  { return Fk.KwProgram; }
    if (@strEq(w, "trit"))     { return Fk.KwTrit; }
    if (@strEq(w, "wave"))     { return Fk.KwWave; }
    if (@strEq(w, "p32"))      { return Fk.KwP32; }
    if (@strEq(w, "sat_i16"))  { return Fk.KwSatI16; }
    if (@strEq(w, "raw"))      { return Fk.KwRaw; }
    if (@strEq(w, "let"))      { return Fk.KwLet; }
    if (@strEq(w, "optical"))  { return Fk.KwOptical; }
    if (@strEq(w, "default"))  { return Fk.KwDefault; }
    return Fk.Ident;
}

fn fk_mk(kind: Fk, val: []u8, line: i32) FToken {
    return FToken{ .kind = kind, .val = val, .line = line };
}

fn fk_slice(src: []u8, lo: i32, hi: i32) []u8 {
    return src[lo..hi];
}

fn flash_lex(src: []u8) ArrayList[FToken] {
    let out: ArrayList[FToken] = make[FToken](64);
    let n: i32 = src.len;
    let i: i32 = 0;
    let line: i32 = 1;
    while (i < n) {
        let c: i32 = fk_ch(src, i);
        if (fk_space(c)) {
            if (c == '\n') { line = line + 1; }
            i = i + 1;
        } else if (c == '/' && i + 1 < n && fk_ch(src, i + 1) == '/') {
            i = i + 2;
            while (i < n && fk_ch(src, i) != '\n') { i = i + 1; }
        } else if (c == '"') {
            let start: i32 = i + 1;
            i = i + 1;
            while (i < n && fk_ch(src, i) != '"') { i = i + 1; }
            push[FToken](&out, fk_mk(Fk.Str, fk_slice(src, start, i), line));
            i = i + 1;
        } else if (c == '+' || c == '-') {
            if (i + 1 < n && fk_digit(fk_ch(src, i + 1))) {
                let start: i32 = i;
                i = i + 1;
                while (i < n && fk_digit(fk_ch(src, i))) { i = i + 1; }
                push[FToken](&out, fk_mk(Fk.Int, fk_slice(src, start, i), line));
            } else if (c == '+') {
                push[FToken](&out, fk_mk(Fk.Int, "+1", line));
                i = i + 1;
            } else {
                push[FToken](&out, fk_mk(Fk.Ident, "T", line));
                i = i + 1;
            }
        } else if (fk_digit(c)) {
            let start: i32 = i;
            let is_float: i32 = 0;
            i = i + 1;
            while (i < n && fk_digit(fk_ch(src, i))) { i = i + 1; }
            if (i < n && fk_ch(src, i) == '.') {
                is_float = 1;
                i = i + 1;
                while (i < n && fk_digit(fk_ch(src, i))) { i = i + 1; }
            }
            if (is_float == 1) {
                push[FToken](&out, fk_mk(Fk.Float, fk_slice(src, start, i), line));
            } else {
                push[FToken](&out, fk_mk(Fk.Int, fk_slice(src, start, i), line));
            }
        } else if (fk_alpha(c)) {
            let start: i32 = i;
            i = i + 1;
            while (i < n && fk_alnum(fk_ch(src, i))) { i = i + 1; }
            let w: []u8 = fk_slice(src, start, i);
            push[FToken](&out, fk_mk(fk_kw(w), w, line));
        } else if (c == '=') {
            push[FToken](&out, fk_mk(Fk.Eq, "=", line));
            i = i + 1;
        } else if (c == '{') {
            push[FToken](&out, fk_mk(Fk.Lbrace, "{", line));
            i = i + 1;
        } else if (c == '}') {
            push[FToken](&out, fk_mk(Fk.Rbrace, "}", line));
            i = i + 1;
        } else if (c == '(') {
            push[FToken](&out, fk_mk(Fk.Lp, "(", line));
            i = i + 1;
        } else if (c == ')') {
            push[FToken](&out, fk_mk(Fk.Rp, ")", line));
            i = i + 1;
        } else if (c == ',') {
            push[FToken](&out, fk_mk(Fk.Comma, ",", line));
            i = i + 1;
        } else if (c == ';') {
            push[FToken](&out, fk_mk(Fk.Semi, ";", line));
            i = i + 1;
        } else {
            push[FToken](&out, fk_mk(Fk.Err, fk_slice(src, i, i + 1), line));
            i = i + 1;
        }
    }
    push[FToken](&out, fk_mk(Fk.Eof, "", line));
    return out;
}
