// flash/compiler/codegen.zag — Flash surface program → Zag shim + coordinate manifest.
//
// Single pipeline: FlashProgram → fss_prog_to_main_fn → codegen_flash_program
// (flash_codegen.zag). Spatial lowering stays on Zag libs in stage-0 because
// znc builds flashc; Flash spatial ports (selfhost/lib/*.flash) are linked by
// stage-1 scodegen.flash and by @import("*.flash") splicing in full-language
// sources. Generated shims pull flash/stdlib/flash_slim.zag so ports keep
// their real symbol names when user programs import them.

@import("../toolchain/zag-poc/std/list.zag")
@import("../toolchain/zag-poc/std/rt.zag")
@import("flash_ast.zag")
@import("flash_codegen.zag")
@import("flash_sema_surface.zag")
@import("manifest.zag")
@import("parse.zag")

fn cg_app(out: *ArrayList[u8], s: []u8) void {
    let i: i32 = 0;
    while (i < s.len) { push[u8](out, s[i]); i = i + 1; }
}

fn cg_dir_depth(dir: []u8) i32 {
    if (@strEq(dir, ".") == 1) { return 0; }
    let start: i32 = 0;
    if (dir.len >= 2 && dir[0] == '.' && dir[1] == '/') { start = 2; }
    let depth: i32 = 1;
    let i: i32 = start;
    while (i < dir.len) {
        if (dir[i] == '/') { depth = depth + 1; }
        i = i + 1;
    }
    return depth;
}

fn cg_rel_prefix(depth: i32, extra_up: i32) []u8 {
    let ups: i32 = depth + extra_up;
    let s: []u8 = "";
    let i: i32 = 0;
    while (i < ups) {
        s = _zag_str_concat(s, "../");
        i = i + 1;
    }
    return s;
}

fn cg_emit_shim_imports(out: *ArrayList[u8], shim_dir: []u8, has_raw: i32, has_mat3: i32) void {
    let depth: i32 = cg_dir_depth(shim_dir);
    let zag_pfx: []u8 = cg_rel_prefix(depth, 1);
    let flash_pfx: []u8 = cg_rel_prefix(depth, 0);

    cg_app(out, "// generated by flashc — do not edit\n");
    cg_app(out, "// balanced trit lowering: flash/ternary/arithmetic.zag (via trit_math at compile time)\n");
    cg_app(out, "@import(\"");
    cg_app(out, flash_pfx);
    cg_app(out, "flash/rt/rt.zag\")\n");
    cg_app(out, "@import(\"");
    cg_app(out, flash_pfx);
    cg_app(out, "flash/toolchain/zag-poc/std/list.zag\")\n");
    cg_app(out, "@import(\"");
    cg_app(out, flash_pfx);
    cg_app(out, "flash/stdlib/flash_slim.zag\")\n");
    if (has_raw == 1) {
        cg_app(out, "// FLASH_RT=sim (default) → photonic_rt.zag; FLASH_RT=hw → link RayOS HAL\n");
        cg_app(out, "@import(\"");
        cg_app(out, flash_pfx);
        cg_app(out, "flash/runtime/photonic_rt.zag\")\n");
    }
    if (has_mat3 == 1) {
        cg_app(out, "@import(\"");
        cg_app(out, flash_pfx);
        cg_app(out, "flash/runtime/matrix_shim.zag\")\n");
    }
    cg_app(out, "\n");
}

fn cg_append_zag_src(out: *ArrayList[u8], src: ArrayList[u8]) void {
    let i: i32 = 0;
    while (i < src.len) {
        push[u8](out, src.data[i]);
        i = i + 1;
    }
}

fn cg_has_raw(prog: *FlashProgram) i32 {
    let i: i32 = 0;
    while (i < len[FlashStmt](prog.*.stmts)) {
        if (get[FlashStmt](prog.*.stmts, i).kind == FlashStmtKind.RawBlock) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn cg_has_mat3(prog: *FlashProgram) i32 {
    let i: i32 = 0;
    while (i < len[FlashStmt](prog.*.stmts)) {
        if (get[FlashStmt](prog.*.stmts, i).kind == FlashStmtKind.Mat3Op) { return 1; }
        i = i + 1;
    }
    return 0;
}

struct FlashCodegenBundle {
    shim_buf: ArrayList[u8],
    manifest: CoordinateManifest,
}

fn cg_codegen_run(prog: *FlashProgram, skip_zag: i32) CodegenResult {
    let tf: TypedFn = fss_prog_to_main_fn(prog);
    let fns: ArrayList[TypedFn] = make[TypedFn](1);
    push[TypedFn](&fns, tf);
    return codegen_flash_program(prog.*.name, fns, skip_zag, 0);
}

fn cg_build_shim_buf(prog: *FlashProgram, shim_dir: []u8, res: *CodegenResult) ArrayList[u8] {
    let out: ArrayList[u8] = make[u8](4096);
    cg_emit_shim_imports(&out, shim_dir, cg_has_raw(prog), cg_has_mat3(prog));
    cg_append_zag_src(&out, res.*.zag_src);
    return out;
}

fn flash_codegen_all(prog: *FlashProgram, shim_dir: []u8) FlashCodegenBundle {
    let res: CodegenResult = cg_codegen_run(prog, 0);
    let shim_buf: ArrayList[u8] = cg_build_shim_buf(prog, shim_dir, &res);
    return FlashCodegenBundle{ .shim_buf = shim_buf, .manifest = res.manifest };
}

fn flash_codegen_manifest(prog: *FlashProgram) CoordinateManifest {
    let res: CodegenResult = cg_codegen_run(prog, 1);
    return res.manifest;
}