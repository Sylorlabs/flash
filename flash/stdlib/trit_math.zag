// flash/stdlib/trit_math.zag — canonical znc-safe i8 balanced-ternary math.
//
// Use this module in znc-linked tests and tools. Logic mirrors
// flash/ternary/arithmetic.zag and flash/ternary/truth_tables.zag without enum
// Trit or qualified imports from flash/ternary/trit.zag.

struct TritAddResult {
    sum: i8,
    carry: i8,
}

struct TritMulResult {
    product: i8,
}

fn i8_to_index(v: i8) i32 {
    if (v == 0 - 1) { return 0; }
    if (v == 0) { return 1; }
    return 2;
}

// ── balanced carry (from ternary/arithmetic.zag balance_sum) ─────────────────

fn balance_sum(raw: i32) TritAddResult {
    let result: i8 = 0;
    let carry: i8 = 0;
    if (raw > 1) {
        result = (raw - 3) as i8;
        carry = 1;
    } else if (raw < 0 - 1) {
        result = (raw + 3) as i8;
        carry = 0 - 1;
    } else {
        result = raw as i8;
        carry = 0;
    }
    return TritAddResult{ .sum = result, .carry = carry };
}

fn add(a: i8, b: i8, carry_in: i8) TritAddResult {
    let raw: i32 = (a as i32) + (b as i32) + (carry_in as i32);
    return balance_sum(raw);
}

fn mul(a: i8, b: i8) TritMulResult {
    let product: i8 = (a * b) as i8;
    return TritMulResult{ .product = product };
}

// ── truth tables (from ternary/truth_tables.zag) ─────────────────────────────

struct TruthTable9 {
    m00: i8,
    m01: i8,
    m02: i8,
    m10: i8,
    m11: i8,
    m12: i8,
    m20: i8,
    m21: i8,
    m22: i8,
}

// canonical lookup tables (rows/cols: Neg, Zero, Pos)
//
// ternary_and  (min):       T T T / T 0 0 / T 0 1
// ternary_or   (max):       T 0 1 / 0 0 1 / 1 1 1
// ternary_xor  (mod-3):     T 0 1 / 0 1 T / 1 T 0
// consensus    (eq→val):    T 0 0 / 0 0 0 / 0 0 1
// implication  (¬a ∨ b):  1 1 1 / 0 0 1 / T 0 1

fn table_and() TruthTable9 {
    return TruthTable9{
        .m00 = 0 - 1, .m01 = 0 - 1, .m02 = 0 - 1,
        .m10 = 0 - 1, .m11 = 0, .m12 = 0,
        .m20 = 0 - 1, .m21 = 0, .m22 = 1,
    };
}

fn table_or() TruthTable9 {
    return TruthTable9{
        .m00 = 0 - 1, .m01 = 0, .m02 = 1,
        .m10 = 0, .m11 = 0, .m12 = 1,
        .m20 = 1, .m21 = 1, .m22 = 1,
    };
}

fn table_xor() TruthTable9 {
    return TruthTable9{
        .m00 = 0 - 1, .m01 = 0, .m02 = 1,
        .m10 = 0, .m11 = 1, .m12 = 0 - 1,
        .m20 = 1, .m21 = 0 - 1, .m22 = 0,
    };
}

fn table_consensus() TruthTable9 {
    return TruthTable9{
        .m00 = 0 - 1, .m01 = 0, .m02 = 0,
        .m10 = 0, .m11 = 0, .m12 = 0,
        .m20 = 0, .m21 = 0, .m22 = 1,
    };
}

fn table_implication() TruthTable9 {
    return TruthTable9{
        .m00 = 1, .m01 = 1, .m02 = 1,
        .m10 = 0, .m11 = 0, .m12 = 1,
        .m20 = 0 - 1, .m21 = 0, .m22 = 1,
    };
}

fn lookup(t: TruthTable9, a: i8, b: i8) i8 {
    let ia: i32 = i8_to_index(a);
    let ib: i32 = i8_to_index(b);
    let idx: i32 = ia * 3 + ib;
    return switch (idx) {
        0 => t.m00,
        1 => t.m01,
        2 => t.m02,
        3 => t.m10,
        4 => t.m11,
        5 => t.m12,
        6 => t.m20,
        7 => t.m21,
        8 => t.m22,
        else => 0,
    };
}

fn ternary_and(a: i8, b: i8) i8 {
    return lookup(table_and(), a, b);
}

fn ternary_or(a: i8, b: i8) i8 {
    return lookup(table_or(), a, b);
}

fn ternary_xor(a: i8, b: i8) i8 {
    return lookup(table_xor(), a, b);
}

fn consensus(a: i8, b: i8) i8 {
    return lookup(table_consensus(), a, b);
}

fn implication(a: i8, b: i8) i8 {
    return lookup(table_implication(), a, b);
}

fn ternary_not(a: i8) i8 {
    if (a == 0 - 1) { return 1; }
    if (a == 0) { return 0; }
    if (a == 1) { return 0 - 1; }
    return 0;
}

// alternate mod-3 formulation (equivalent to ternary_xor table lookup)
// xor(a,b) = ((a+1) + (b+1)) % 3 - 1

fn xor_mod3_compute(a: i8, b: i8) i8 {
    let ua: i32 = (a as i32) + 1;
    let ub: i32 = (b as i32) + 1;
    let ur: i32 = (ua + ub) % 3;
    return (ur - 1) as i8;
}