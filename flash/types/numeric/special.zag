fn special_unit_count() i32 { return 11; }

fn special_descriptor_at(idx: i32) common.TypeDescriptor {
    if (idx == 0)  { return special_descriptor_u11(); }
    if (idx == 1)  { return special_descriptor_u_any(); }
    if (idx == 2)  { return special_descriptor_i_any(); }
    if (idx == 3)  { return special_descriptor_rns_3(); }
    if (idx == 4)  { return special_descriptor_l32(); }
    if (idx == 5)  { return special_descriptor_l16(); }
    if (idx == 6)  { return special_descriptor_bf16(); }
    if (idx == 7)  { return special_descriptor_mx_fp8(); }
    if (idx == 8)  { return special_descriptor_mx_fp4(); }
    if (idx == 9)  { return special_descriptor_vsa_b256(); }
    if (idx == 10) { return special_descriptor_vsa_b4096(); }
    return common.td_empty();
}

fn special_lookup(name: []u8) ?common.TypeDescriptor {
    if (@strEq(name, "u11"))          { return special_descriptor_u11(); }
    if (@strEq(name, "u_any"))        { return special_descriptor_u_any(); }
    if (@strEq(name, "i_any"))        { return special_descriptor_i_any(); }
    if (@strEq(name, "rns_3"))        { return special_descriptor_rns_3(); }
    if (@strEq(name, "l32"))          { return special_descriptor_l32(); }
    if (@strEq(name, "l16"))          { return special_descriptor_l16(); }
    if (@strEq(name, "bf16"))         { return special_descriptor_bf16(); }
    if (@strEq(name, "mx_fp8"))       { return special_descriptor_mx_fp8(); }
    if (@strEq(name, "mx_fp4"))       { return special_descriptor_mx_fp4(); }
    if (@strEq(name, "vsa_b<256>"))   { return special_descriptor_vsa_b256(); }
    if (@strEq(name, "vsa_b<4096>"))  { return special_descriptor_vsa_b4096(); }
    return null;
}