// flash/types/numeric/special.zag — ADC, bignum, RNS, LNS, VSA, microscaling types.

@import("numeric_common.zag") as common
@import("u_units.zag") as u_units

// u11 — 11-bit ADC lane (0..2047), alias of u11 with photonic ADC semantics.
fn special_descriptor_u11() common.TypeDescriptor {
    let d: common.TypeDescriptor = u_units.u_unit_descriptor_named("u11", 11);
    return common.TypeDescriptor{
        .name = "u11",
        .kind = d.kind,
        .width = d.width,
        .signed = d.signed,
        .min_val = d.min_val,
        .max_val = d.max_val,
        .trit_encoding_bits = d.trit_encoding_bits,
        .storage_bytes = d.storage_bytes,
        .es = 0,
        .useed = 0,
        .nbits = 11,
        .exponent_bits = 0,
        .mantissa_bits = 0,
        .ieee_binary = 0,
        .int_bits = 11,
        .frac_bits = 0,
        .moduli_count = 0,
    };
}

