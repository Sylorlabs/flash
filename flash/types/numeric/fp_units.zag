        .min_val = 0,
        .max_val = 0,
        .trit_encoding_bits = common.num_trit_encoding_bits(128),
        .storage_bytes = 16,
        .es = 0,
        .useed = 0,
        .nbits = 128,
        .exponent_bits = 15,
        .mantissa_bits = 112,
        .ieee_binary = 1,
        .int_bits = 0,
        .frac_bits = 0,
        .moduli_count = 0,
