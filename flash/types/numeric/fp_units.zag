// flash/types/numeric/fp_units.zag — IEEE floating-point unit metadata.

@import("numeric_common.zag") as common

fn fp_unit_count() i32 { return 5; }

fn fp_descriptor_f16() common.TypeDescriptor {
    return common.TypeDescriptor{
        .name = "f16",
        .kind = common.KIND_FLOAT(),
        .width = 16,
        .signed = 1,
        .min_val = 0,
        .max_val = 0,
        .trit_encoding_bits = common.num_trit_encoding_bits(16),
        .storage_bytes = 2,
        .es = 0,
        .useed = 0,
        .nbits = 16,
        .exponent_bits = 5,
        .mantissa_bits = 10,
        .ieee_binary = 1,
        .int_bits = 0,
        .frac_bits = 0,
        .moduli_count = 0,
    };
}

