fn fp_descriptor_at(idx: i32) common.TypeDescriptor {
    if (idx == 0) { return fp_descriptor_f16(); }
    if (idx == 1) { return fp_descriptor_f32(); }
    if (idx == 2) { return fp_descriptor_f64(); }
    if (idx == 3) { return fp_descriptor_f80(); }
    if (idx == 4) { return fp_descriptor_f128(); }
    return common.td_empty();
}

fn fp_lookup(name: []u8) ?common.TypeDescriptor {
    if (@strEq(name, "f16")) { return fp_descriptor_f16(); }
    if (@strEq(name, "f32")) { return fp_descriptor_f32(); }
    if (@strEq(name, "f64")) { return fp_descriptor_f64(); }
    if (@strEq(name, "f80")) { return fp_descriptor_f80(); }
    if (@strEq(name, "f128")) { return fp_descriptor_f128(); }
    return null;
}