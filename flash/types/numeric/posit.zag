    return common.TypeDescriptor{
        .name = "p64",
        .kind = common.KIND_POSIT(),
        .width = 64,
        .signed = 0,
        .min_val = 0,
        .max_val = 0,
        .trit_encoding_bits = common.num_trit_encoding_bits(64),
        .storage_bytes = 8,
        .es = 3,
        .useed = 256,
        .nbits = 64,
        .exponent_bits = 0,
        .mantissa_bits = 0,
        .ieee_binary = 0,
        .int_bits = 0,
        .frac_bits = 0,
        .moduli_count = 0,
    };
