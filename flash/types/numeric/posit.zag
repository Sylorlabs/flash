// flash/types/numeric/posit.zag — posit + quire metadata (p8/p16/p32/p64).

@import("numeric_common.zag") as common

fn posit_unit_count() i32 { return 5; }

fn posit_descriptor_p8() common.TypeDescriptor {
    return common.TypeDescriptor{
        .name = "p8",
        .kind = common.KIND_POSIT(),
        .width = 8,
        .signed = 1,
        .min_val = 0,
        .max_val = 0,
        .trit_encoding_bits = common.num_trit_encoding_bits(8),
        .storage_bytes = 1,
        .es = 0,
        .useed = 2,
        .nbits = 8,
        .exponent_bits = 0,
        .mantissa_bits = 0,
        .ieee_binary = 0,
        .int_bits = 0,
        .frac_bits = 0,
        .moduli_count = 0,
    };
}

fn posit_descriptor_p16() common.TypeDescriptor {
    return common.TypeDescriptor{
        .name = "p16",
        .kind = common.KIND_POSIT(),
        .width = 16,
        .signed = 1,
        .min_val = 0,
        .max_val = 0,
        .trit_encoding_bits = common.num_trit_encoding_bits(16),
        .storage_bytes = 2,
        .es = 1,
        .useed = 4,
        .nbits = 16,
        .exponent_bits = 0,
        .mantissa_bits = 0,
        .ieee_binary = 0,
        .int_bits = 0,
        .frac_bits = 0,
        .moduli_count = 0,
    };
}

