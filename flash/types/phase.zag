// phase.zag — primitive phase type for Flash photonic lattice cells
//
// Encodes optical phase in radians with balanced-ternary quantization at 2π/3 steps.
// Compiler maps Phase → PCM matrix phase-shift instruction.

fn pi_third() f32 { return 1.0471976; }
fn two_pi_third() f32 { return 2.0943952; }

enum PhaseQuant {
    Neg120,
    Zero,
    Pos120,
}

struct Phase {
    radians: f32,
    quantized: PhaseQuant,
    trit_wire: i8,
}

fn from_radians(r: f32) Phase {
    let q: PhaseQuant = PhaseQuant.Zero;
    let tw: i8 = 0;
    if (r < 0.0 - 0.5235988) {
        q = PhaseQuant.Neg120;
        tw = 0 - 1;
    } else if (r > 0.5235988) {
        q = PhaseQuant.Pos120;
        tw = 1;
    } else {
        q = PhaseQuant.Zero;
        tw = 0;
    }
    return Phase{ .radians = r, .quantized = q, .trit_wire = tw };
}

fn from_trit(t: i8) Phase {
    let r: f32 = 0.0;
    let q: PhaseQuant = PhaseQuant.Zero;
    if (t == 0 - 1) {
        r = 0.0 - pi_third();
        q = PhaseQuant.Neg120;
    } else if (t == 1) {
        r = pi_third();
        q = PhaseQuant.Pos120;
    } else {
        r = 0.0;
        q = PhaseQuant.Zero;
    }
    return Phase{ .radians = r, .quantized = q, .trit_wire = t };
}

fn quantize(r: f32) PhaseQuant {
    if (r < 0.0 - 0.5235988) { return PhaseQuant.Neg120; }
    if (r > 0.5235988) { return PhaseQuant.Pos120; }
    return PhaseQuant.Zero;
}

fn shift(base: Phase, delta_rad: f32) Phase {
    return from_radians(base.radians + delta_rad);
}

fn negate(p: Phase) Phase {
    return from_radians(0.0 - p.radians);
}

fn step_rad() f32 {
    return two_pi_third();
}