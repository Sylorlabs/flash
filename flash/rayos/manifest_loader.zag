// flash/rayos/manifest_loader.zag — FIMG v1 manifest loader stub (sim reference).
//
// RayOS firmware replaces this with silicon-backed flash_pcm_program().

@import("../toolchain/zag-poc/std/rt.zag")
@import("../toolchain/zag-poc/std/list.zag")
@import("../compiler/manifest.zag")

fn ml_contains(hay: []u8, needle: []u8) i32 {
    if (needle.len < 1 || hay.len < needle.len) { return 0; }
    let i: i32 = 0;
    while (i <= hay.len - needle.len) {
        let j: i32 = 0;
        let ok: i32 = 1;
        while (j < needle.len) {
            if (hay[i + j] != needle[j]) { ok = 0; }
            j = j + 1;
        }
        if (ok == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn ml_parse_i32_field(line: []u8, key: []u8) i32 {
    let needle: []u8 = _zag_str_concat(key, " = ");
    let at: i32 = 0;
    while (at <= line.len - needle.len) {
        let j: i32 = 0;
        let ok: i32 = 1;
        while (j < needle.len) {
            if (line[at + j] != needle[j]) { ok = 0; }
            j = j + 1;
        }
        if (ok == 1) {
            let start: i32 = at + needle.len;
            let end: i32 = start;
            while (end < line.len && line[end] != ' ' && line[end] != '}') {
                end = end + 1;
            }
            if (end > start) {
                return _zag_str_to_i64(line[start..end]) as i32;
            }
        }
        at = at + 1;
    }
    return 0;
}

fn ml_section_start(text: []u8, tag: []u8) i32 {
    let i: i32 = 0;
    while (i < text.len) {
        if (text[i] == '\n') {
            let line_start: i32 = i + 1;
            let line_end: i32 = line_start;
            while (line_end < text.len && text[line_end] != '\n') {
                line_end = line_end + 1;
            }
            if (line_start < text.len) {
                let line: []u8 = text[line_start..line_end];
                if (ml_contains(line, tag) == 1) { return line_start; }
            }
        }
        i = i + 1;
    }
    if (text.len > 0 && text[0] != '\n') {
        let line_end: i32 = 0;
        while (line_end < text.len && text[line_end] != '\n') {
            line_end = line_end + 1;
        }
        let line: []u8 = text[0..line_end];
        if (ml_contains(line, tag) == 1) { return 0; }
    }
    return 0 - 1;
}

fn ml_parse_engine_field(text: []u8, key: []u8) i32 {
    let start: i32 = ml_section_start(text, "[engine]");
    if (start < 0) { return 0; }
    let i: i32 = start;
    let done: i32 = 0;
    while (i < text.len && done == 0) {
        if (text[i] == '\n') {
            let line_start: i32 = i + 1;
            let line_end: i32 = line_start;
            while (line_end < text.len && text[line_end] != '\n') {
                line_end = line_end + 1;
            }
            if (line_start >= text.len) {
                done = 1;
            } else {
                let line: []u8 = text[line_start..line_end];
                if (ml_contains(line, "[") == 1 && ml_contains(line, "]") == 1) {
                    if (ml_contains(line, "[engine]") == 0) { done = 1; }
                } else {
                    let needle: []u8 = _zag_str_concat(key, " = ");
                    if (ml_contains(line, needle) == 1) {
                        return ml_parse_i32_field(line, key);
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn ml_parse_engine_gpu(text: []u8) i32 {
    return ml_parse_engine_field(text, "gpu");
}

fn ml_parse_engine_route(text: []u8) i32 {
    return ml_parse_engine_field(text, "compute_route");
}

fn ml_has_engine_section(text: []u8) i32 {
    if (ml_contains(text, "FLASH_PLATFORM=engine") == 1) { return 1; }
    if (ml_contains(text, "[engine]") == 1) { return 1; }
    return 0;
}

fn ml_count_pcm_segments(text: []u8) i32 {
    let count: i32 = 0;
    let i: i32 = 0;
    while (i < text.len) {
        if (text[i] == '\n') {
            let line_start: i32 = i + 1;
            let line_end: i32 = line_start;
            while (line_end < text.len && text[line_end] != '\n') {
                line_end = line_end + 1;
            }
            if (line_start < text.len) {
                let line: []u8 = text[line_start..line_end];
                if (ml_contains(line, "lattice_op = ") == 1) {
                    let op: i32 = ml_parse_i32_field(line, "lattice_op");
                    if (op != 0) { count = count + 1; }
                }
            }
        }
        i = i + 1;
    }
    return count;
}

fn ml_load_fimg(path: []u8) i32 {
    let text: []u8 = _zag_read_file(path);
    if (text.len < 0) { return 0 - 1; }
    if (ml_contains(text, "# flash image v1") == 0
        && ml_contains(text, "# flash engine image v1") == 0) {
        return 0 - 1;
    }
    if (ml_contains(text, "[manifest]") == 0 && ml_contains(text, "[fimg]") == 0) {
        return 0 - 1;
    }
    let pcm_ops: i32 = ml_count_pcm_segments(text);
    _zag_print("manifest_loader: fimg ok, pcm_ops=");
    _zag_println(_zag_i64_to_str(pcm_ops as i64));
    if (ml_has_engine_section(text) == 1) {
        let gpu: i32 = ml_parse_engine_gpu(text);
        let route: i32 = ml_parse_engine_route(text);
        _zag_print("manifest_loader: engine platform, gpu=");
        _zag_print(_zag_i64_to_str(gpu as i64));
        _zag_print(" compute_route=");
        _zag_println(_zag_i64_to_str(route as i64));
    }
    return pcm_ops;
}

fn main() i32 {
    let path: []u8 = "examples/ternary_logic.fimg";
    if (_zag_file_exists(path) == 0) { path = "ternary_logic.fimg"; }
    if (ml_load_fimg(path) < 0) {
        _zag_println("manifest_loader: skip (no .fimg yet)");
        return 0;
    }
    _zag_println("manifest_loader: ok");
    return 0;
}