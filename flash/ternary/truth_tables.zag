// truth_tables.zag — native balanced-ternary logic with 3×3 lookup tables
//
// Index layout: idx = row(a) * 3 + col(b), where row/col map {-1,0,+1} → {0,1,2}.
// All binary ops are table-driven for deterministic PCM phase-mask lowering.
//
//   @import("ternary/truth_tables.zag") as tt
//   let r: i8 = tt.ternary_and(-1, 1);   // -1  (min)
//   let x: i8 = tt.lookup_xor(0, 1);     // -1  (mod-3 add)

@import("trit.zag")

// ── 3×3 truth table container ───────────────────────────────────────────────

struct TruthTable9 {
    m00: i8,
    m01: i8,
    m02: i8,
    m10: i8,
    m11: i8,
    m12: i8,
    m20: i8,
    m21: i8,
    m22: i8,
}

// ── canonical lookup tables (rows/cols: Neg, Zero, Pos) ──────────────────────
//
// ternary_and  (min):       T T T / T 0 0 / T 0 1
// ternary_or   (max):       T 0 1 / 0 0 1 / 1 1 1
// ternary_xor  (mod-3):     T 0 1 / 0 1 T / 1 T 0
// consensus    (eq→val):    T 0 0 / 0 0 0 / 0 0 1
// implication  (¬a ∨ b):  1 1 1 / 0 0 1 / T 0 1

fn table_and() TruthTable9 {
    return TruthTable9{
        .m00 = 0 - 1, .m01 = 0 - 1, .m02 = 0 - 1,
        .m10 = 0 - 1, .m11 = 0, .m12 = 0,
        .m20 = 0 - 1, .m21 = 0, .m22 = 1,
    };
}

fn table_or() TruthTable9 {
    return TruthTable9{
        .m00 = 0 - 1, .m01 = 0, .m02 = 1,
        .m10 = 0, .m11 = 0, .m12 = 1,
        .m20 = 1, .m21 = 1, .m22 = 1,
    };
}

fn table_xor() TruthTable9 {
    return TruthTable9{
        .m00 = 0 - 1, .m01 = 0, .m02 = 1,
        .m10 = 0, .m11 = 1, .m12 = 0 - 1,
        .m20 = 1, .m21 = 0 - 1, .m22 = 0,
    };
}

fn table_consensus() TruthTable9 {
    return TruthTable9{
        .m00 = 0 - 1, .m01 = 0, .m02 = 0,
        .m10 = 0, .m11 = 0, .m12 = 0,
        .m20 = 0, .m21 = 0, .m22 = 1,
    };
}

fn table_implication() TruthTable9 {
    return TruthTable9{
        .m00 = 1, .m01 = 1, .m02 = 1,
        .m10 = 0, .m11 = 0, .m12 = 1,
        .m20 = 0 - 1, .m21 = 0, .m22 = 1,
    };
}

// unary NOT: [-1, 0, +1] → [+1, 0, -1]

// ── generic table lookup ──────────────────────────────────────────────────────

fn lookup(t: TruthTable9, a: i8, b: i8) i8 {
    let ia: i32 = trit.i8_to_index(a);
    let ib: i32 = trit.i8_to_index(b);
    let idx: i32 = ia * 3 + ib;
    return switch (idx) {
        0 => t.m00,
        1 => t.m01,
        2 => t.m02,
        3 => t.m10,
        4 => t.m11,
        5 => t.m12,
        6 => t.m20,
        7 => t.m21,
        8 => t.m22,
        else => 0,
    };
}

fn lookup_not(a: i8) i8 {
    return switch (a) {
        0 - 1 => 1,
        0 => 0,
        1 => 0 - 1,
        else => 0,
    };
}

// ── named logic primitives (@pure — no IO, suitable for compile-time eval) ────

fn ternary_and(a: i8, b: i8) i8 @pure {
    return lookup(table_and(), a, b);
}

fn ternary_or(a: i8, b: i8) i8 @pure {
    return lookup(table_or(), a, b);
}

fn ternary_xor(a: i8, b: i8) i8 @pure {
    return lookup(table_xor(), a, b);
}

fn ternary_not(a: i8) i8 @pure {
    return lookup_not(a);
}

fn consensus(a: i8, b: i8) i8 @pure {
    return lookup(table_consensus(), a, b);
}

fn implication(a: i8, b: i8) i8 @pure {
    return lookup(table_implication(), a, b);
}

// ── enum-facing wrappers ─────────────────────────────────────────────────────

fn and_trit(a: trit.Trit, b: trit.Trit) trit.Trit {
    let ra: i8 = ternary_and(trit.to_i8(a), trit.to_i8(b));
    return trit.from_i8(ra) catch trit.zero();
}

fn or_trit(a: trit.Trit, b: trit.Trit) trit.Trit {
    let ra: i8 = ternary_or(trit.to_i8(a), trit.to_i8(b));
    return trit.from_i8(ra) catch trit.zero();
}

fn xor_trit(a: trit.Trit, b: trit.Trit) trit.Trit {
    let ra: i8 = ternary_xor(trit.to_i8(a), trit.to_i8(b));
    return trit.from_i8(ra) catch trit.zero();
}

fn not_trit(a: trit.Trit) trit.Trit {
    let ra: i8 = ternary_not(trit.to_i8(a));
    return trit.from_i8(ra) catch trit.zero();
}

// ── alternate mod-3 formulation (documented equivalence) ─────────────────────
// xor(a,b) = ((a+1) + (b+1)) % 3 - 1

fn xor_mod3_compute(a: i8, b: i8) i8 @pure {
    let ua: i32 = (a as i32) + 1;
    let ub: i32 = (b as i32) + 1;
    let ur: i32 = (ua + ub) % 3;
    return (ur - 1) as i8;
}

// ── per-entry accessors (for compiler constant folding / test harnesses) ─────

fn lookup_and(a: i8, b: i8) i8 @pure { return ternary_and(a, b); }
fn lookup_or(a: i8, b: i8) i8 @pure { return ternary_or(a, b); }
fn lookup_xor(a: i8, b: i8) i8 @pure { return ternary_xor(a, b); }
fn lookup_consensus(a: i8, b: i8) i8 @pure { return consensus(a, b); }
fn lookup_implication(a: i8, b: i8) i8 @pure { return implication(a, b); }