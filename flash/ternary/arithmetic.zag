// arithmetic.zag — balanced-ternary arithmetic + PCM phase-shift emission metadata
//
// Single-trit ops with balanced carry {-1, 0, +1}. Multi-trit vectors use
// least-significant-trit-first (LSF) ordering. Each op can emit PhaseShiftEmit
// records for the Active Lattice PCM matrix compiler backend.
//
//   @import("ternary/arithmetic.zag") as arith
//   let sum: arith.TritAddResult = arith.add(1, 1, 0);

@import("trit.zag")

// ── PCM lattice operation tags (no binary gates) ─────────────────────────────

enum LatticeOp {
    PhaseIdle,
    PhaseCouple,
    PhaseInvert,
    PhaseSum,
    PhaseDiff,
    PhaseMul,
    CarryShift,
    ConsensusGate,
}

// ── physical phase metadata for compiler lowering ────────────────────────────
// Balanced trits map to 120° lattice phases: −1 → −π/3, 0 → 0, +1 → +π/3.

fn phase_neg_rad() f32 { return 0.0 - 1.0471976; }
fn phase_zero_rad() f32 { return 0.0; }
fn phase_pos_rad() f32 { return 1.0471976; }
fn phase_step_rad() f32 { return 2.0943952; }

struct PhaseShiftEmit {
    op: LatticeOp,
    operand_a: i8,
    operand_b: i8,
    carry_in: i8,
    result: i8,
    carry_out: i8,
    phase_a_rad: f32,
    phase_b_rad: f32,
    phase_carry_in_rad: f32,
    phase_result_rad: f32,
    phase_carry_out_rad: f32,
    pcm_row: i32,
    pcm_col: i32,
    trit_position: i32,
}

struct TritAddResult {
    sum: i8,
    carry: i8,
    emit: PhaseShiftEmit,
}

struct TritSubResult {
    diff: i8,
    borrow: i8,
    emit: PhaseShiftEmit,
}

struct TritMulResult {
    product: i8,
    emit: PhaseShiftEmit,
}

// ── phase helpers ─────────────────────────────────────────────────────────────

fn trit_to_phase_rad(t: i8) f32 @pure {
    return switch (t) {
        0 - 1 => phase_neg_rad(),
        1 => phase_pos_rad(),
        else => phase_zero_rad(),
    };
}

fn carry_to_phase_rad(c: i8) f32 @pure {
    if (c == 0 - 1) { return 0.0 - phase_step_rad(); }
    if (c == 1) { return phase_step_rad(); }
    return phase_zero_rad();
}

fn make_emit(
    op: LatticeOp,
    a: i8,
    b: i8,
    cin: i8,
    result: i8,
    cout: i8,
    row: i32,
    col: i32,
    pos: i32,
) PhaseShiftEmit {
    return PhaseShiftEmit{
        .op = op,
        .operand_a = a,
        .operand_b = b,
        .carry_in = cin,
        .result = result,
        .carry_out = cout,
        .phase_a_rad = trit_to_phase_rad(a),
        .phase_b_rad = trit_to_phase_rad(b),
        .phase_carry_in_rad = carry_to_phase_rad(cin),
        .phase_result_rad = trit_to_phase_rad(result),
        .phase_carry_out_rad = carry_to_phase_rad(cout),
        .pcm_row = row,
        .pcm_col = col,
        .trit_position = pos,
    };
}

// ── balanced carry normalization ──────────────────────────────────────────
// raw ∈ ℤ; map to (result trit, carry trit) with carry ∈ {-1,0,+1}.

fn balance_sum(raw: i32) TritAddResult @pure {
    let result: i8 = 0;
    let carry: i8 = 0;
    if (raw > 1) {
        result = (raw - 3) as i8;
        carry = 1;
    } else if (raw < 0 - 1) {
        result = (raw + 3) as i8;
        carry = 0 - 1;
    } else {
        result = raw as i8;
        carry = 0;
    }
    let emit: PhaseShiftEmit = make_emit(
        LatticeOp.PhaseSum,
        0,
        0,
        0,
        result,
        carry,
        0,
        0,
        0,
    );
    return TritAddResult{ .sum = result, .carry = carry, .emit = emit };
}

// ── single-trit arithmetic ───────────────────────────────────────────────────

fn add(a: i8, b: i8, carry_in: i8) TritAddResult @pure {
    let raw: i32 = (a as i32) + (b as i32) + (carry_in as i32);
    let bal: TritAddResult = balance_sum(raw);
    let emit: PhaseShiftEmit = make_emit(
        LatticeOp.PhaseSum,
        a,
        b,
        carry_in,
        bal.sum,
        bal.carry,
        0,
        0,
        0,
    );
    return TritAddResult{ .sum = bal.sum, .carry = bal.carry, .emit = emit };
}

fn sub(a: i8, b: i8, borrow_in: i8) TritSubResult @pure {
    let raw: i32 = (a as i32) - (b as i32) - (borrow_in as i32);
    let bal: TritAddResult = balance_sum(raw);
    let emit: PhaseShiftEmit = make_emit(
        LatticeOp.PhaseDiff,
        a,
        b,
        borrow_in,
        bal.sum,
        bal.carry,
        0,
        0,
        0,
    );
    return TritSubResult{ .diff = bal.sum, .borrow = bal.carry, .emit = emit };
}

fn mul(a: i8, b: i8) TritMulResult @pure {
    let product: i8 = (a * b) as i8;
    let emit: PhaseShiftEmit = make_emit(
        LatticeOp.PhaseMul,
        a,
        b,
        0,
        product,
        0,
        0,
        0,
        0,
    );
    return TritMulResult{ .product = product, .emit = emit };
}

fn mul_lookup(a: i8, b: i8) i8 @pure {
    let ia: i32 = trit.i8_to_index(a);
    let ib: i32 = trit.i8_to_index(b);
    let idx: i32 = ia * 3 + ib;
    return switch (idx) {
        0 => 1,
        1 => 0,
        2 => 0 - 1,
        3 => 0,
        4 => 0,
        5 => 0,
        6 => 0 - 1,
        7 => 0,
        8 => 1,
        else => 0,
    };
}

// ── multi-trit ripple (LSF: index 0 = least significant trit) ───────────────

struct RippleResult {
    digits: []i8,
    final_carry: i8,
    emit_count: i32,
}

fn add_ripple(a: []i8, b: []i8, carry_in: i8) RippleResult {
    let n: i32 = a.len;
    if (b.len < n) { n = b.len; }
    let carry: i8 = carry_in;
    let i: i32 = 0;
    while (i < n) {
        let step: TritAddResult = add(a[i], b[i], carry);
        a[i] = step.sum;
        carry = step.carry;
        i = i + 1;
    }
    return RippleResult{ .digits = a, .final_carry = carry, .emit_count = n };
}

fn sub_ripple(a: []i8, b: []i8, borrow_in: i8) RippleResult {
    let n: i32 = a.len;
    if (b.len < n) { n = b.len; }
    let borrow: i8 = borrow_in;
    let i: i32 = 0;
    while (i < n) {
        let step: TritSubResult = sub(a[i], b[i], borrow);
        a[i] = step.diff;
        borrow = step.borrow;
        i = i + 1;
    }
    return RippleResult{ .digits = a, .final_carry = borrow, .emit_count = n };
}

fn emit_at(
    op: LatticeOp,
    a: i8,
    b: i8,
    cin: i8,
    result: i8,
    cout: i8,
    row: i32,
    col: i32,
    pos: i32,
) PhaseShiftEmit @pure {
    return make_emit(op, a, b, cin, result, cout, row, col, pos);
}