// flasht/ref_interp.zag — independent PPU32 reference interpreter (P1).
//
// Deliberately dumb: a second implementation of docs/PPU32_ISA_V1.md used
// for differential testing against qemu_ppu32. It shares NO logic with the
// emulator — trits are stored as explicit digit arrays (not packed ints),
// routes step axis-wise (not DDA), and output is byte-identical to
// `qemu_ppu32 --dump` so `diff` decides equivalence.
//
// Usage: ref_interp <file.ppu32>   (prints qemu-style dump lines)

@import("../flash/toolchain/zag-poc/std/rt.zag")

fn R_EDGE() i32 { return 8; }
fn R_LAT() i32 { return 128; }

// state kept in flat i64 arrays (znc indexes i64 with an 8-byte stride)
struct RState {
    treg: *i64,      // 64
    pcm: *i64,       // 262144
    vpol: *i64,      // 512
    vphase: *i64,
    vamp: *i64,
    vocc: *i64,
    lat: *i64,       // 2097152
    laser: *i64,     // 4
    couple: *i64,    // 64
    raw: i32,
    fault: i32,
    finsn: i32,
    tgt: *i64,       // 3
}

fn rs_new() *RState {
    let st: *RState = _zag_malloc(@sizeOf[RState]()) as *RState;
    st.*.treg = _zag_malloc(64 * 8) as *i64;
    st.*.pcm = _zag_malloc(262144 * 8) as *i64;
    st.*.vpol = _zag_malloc(512 * 8) as *i64;
    st.*.vphase = _zag_malloc(512 * 8) as *i64;
    st.*.vamp = _zag_malloc(512 * 8) as *i64;
    st.*.vocc = _zag_malloc(512 * 8) as *i64;
    st.*.lat = _zag_malloc(2097152 * 8) as *i64;
    st.*.laser = _zag_malloc(32) as *i64;
    st.*.couple = _zag_malloc(64 * 8) as *i64;
    st.*.tgt = _zag_malloc(24) as *i64;
    st.*.raw = 0; st.*.fault = 0; st.*.finsn = -1;
    let i: i32 = 0;
    while (i < 64) { st.*.treg[i] = 0; st.*.couple[i] = 0; i = i + 1; }
    i = 0;
    while (i < 262144) { st.*.pcm[i] = 0; i = i + 1; }
    i = 0;
    while (i < 512) {
        st.*.vpol[i] = 0; st.*.vphase[i] = 0;
        st.*.vamp[i] = 0; st.*.vocc[i] = 0; i = i + 1;
    }
    i = 0;
    while (i < 2097152) { st.*.lat[i] = 0; i = i + 1; }
    i = 0;
    while (i < 4) { st.*.laser[i] = 0; i = i + 1; }
    st.*.tgt[0] = 0; st.*.tgt[1] = 0; st.*.tgt[2] = 0;
    return st;
}

// ── trits as digit arrays (different representation than qemu) ────────────────

fn t3pow(k: i32) i64 {
    let p: i64 = 1; let i: i32 = 0;
    while (i < k) { p = p * 3; i = i + 1; }
    return p;
}

// value → 9 digits into out (least significant first)
fn rt_digits(v: i64, out: *i64) void {
    let r: i64 = v; let i: i32 = 0;
    // normalize into [−9841, 9841]
    while (r > 9841) { r = r - 19683; }
    while (r < 0 - 9841) { r = r + 19683; }
    while (i < 9) {
        let m: i64 = r % 3;
        if (m == 2) { out[i] = -1; r = (r + 1) / 3; }
        else if (m == 0 - 2) { out[i] = 1; r = (r - 1) / 3; }
        else { out[i] = m; r = r / 3; }
        i = i + 1;
    }
}

fn rt_value(d: *i64) i64 {
    let v: i64 = 0; let i: i32 = 8;
    while (i >= 0) {
        v = v * 3 + d[i];
        i = i - 1;
    }
    return v;
}

fn rt_cons(x: i64, y: i64) i64 {
    if (x == y) { return x; }
    if (x == 0) { return y; }
    if (y == 0) { return x; }
    return 0;
}

fn rt_min(x: i64, y: i64) i64 {
    if (x < y) { return x; }
    return y;
}

// apply a per-digit op: op 0=cons 1=mul 2=nand 3=neg(b ignored)
fn rt_wordop(st: *RState, ai: i64, bi: i64, di: i64, op: i32) void {
    let ad: *i64 = _zag_malloc(72) as *i64;
    let bd: *i64 = _zag_malloc(72) as *i64;
    let dd: *i64 = _zag_malloc(72) as *i64;
    rt_digits(st.*.treg[ai], ad);
    rt_digits(st.*.treg[bi], bd);
    let i: i32 = 0;
    while (i < 9) {
        if (op == 0) { dd[i] = rt_cons(ad[i], bd[i]); }
        if (op == 1) { dd[i] = ad[i] * bd[i]; }          // digit mul ≠ word mul
        if (op == 2) { dd[i] = 0 - rt_min(ad[i], bd[i]); }
        if (op == 3) { dd[i] = 0 - ad[i]; }
        i = i + 1;
    }
    let v: i64 = rt_value(dd);
    if (op == 1) {
        // word multiply uses numeric multiply mod 3^9, not digit mul
        let r: i64 = st.*.treg[ai] * st.*.treg[bi];
        let r2: i64 = r;
        while (r2 > 9841) { r2 = r2 - 19683; }
        while (r2 < 0 - 9841) { r2 = r2 + 19683; }
        st.*.treg[di] = r2;
    } else {
        st.*.treg[di] = v;
    }
    // couple steering
    if (st.*.couple[di] != 0) {
        let s: i64 = 0;
        if (st.*.couple[di] > 0) { s = 1; }
        if (st.*.couple[di] < 0) { s = -1; }
        rt_digits(st.*.treg[di], dd);
        dd[0] = rt_cons(dd[0], s);
        st.*.treg[di] = rt_value(dd);
        st.*.couple[di] = 0;
    }
    _zag_free(ad as *i8); _zag_free(bd as *i8); _zag_free(dd as *i8);
}

// ── parser (shared text format; independent scan) ────────────────────────────

fn rp_contains(hay: []u8, needle: []u8) i32 {
    if (needle.len < 1 || hay.len < needle.len) { return 0; }
    let i: i32 = 0;
    while (i <= hay.len - needle.len) {
        let j: i32 = 0; let ok: i32 = 1;
        while (j < needle.len) {
            if (hay[i + j] != needle[j]) { ok = 0; }
            j = j + 1;
        }
        if (ok == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn rp_kv(line: []u8, key: []u8) i64 {
    let at: i32 = 0;
    while (at <= line.len - key.len - 1) {
        let j: i32 = 0; let ok: i32 = 1;
        while (j < key.len) {
            if (line[at + j] != key[j]) { ok = 0; }
            j = j + 1;
        }
        if (ok == 1 && line[at + key.len] == '=') {
            let cur: i32 = at + key.len + 1;
            let neg: i32 = 0;
            if (cur < line.len && line[cur] == '-') { neg = 1; cur = cur + 1; }
            if (cur + 1 < line.len && line[cur] == '0' && line[cur + 1] == 't') {
                cur = cur + 2;
                let digs: *i64 = _zag_malloc(512) as *i64;
                let n: i32 = 0;
                while (cur < line.len && n < 64) {
                    let ch: u8 = line[cur];
                    if (ch == '+') { digs[n] = 1; n = n + 1; }
                    if (ch == '-') { digs[n] = -1; n = n + 1; }
                    if (ch == '0') { digs[n] = 0; n = n + 1; }
                    cur = cur + 1;
                }
                let v: i64 = 0; let k: i32 = 0;
                while (k < n) { v = v * 3 + digs[k]; k = k + 1; }
                _zag_free(digs as *i8);
                return v;
            }
            let v: i64 = 0;
            while (cur < line.len) {
                let c: i32 = line[cur] as i32;
                if (c < '0' || c > '9') { cur = line.len; }
                if (cur < line.len && c >= '0' && c <= '9') {
                    v = v * 10 + (c - '0') as i64;
                    cur = cur + 1;
                }
            }
            if (neg == 1) { return 0 - v; }
            return v;
        }
        at = at + 1;
    }
    return 0;
}

fn rp_class(line: []u8) i32 {
    if (rp_contains(line, "RawReadVoxel") == 1) { return 13; }
    if (rp_contains(line, "RawModeExit") == 1) { return 12; }
    if (rp_contains(line, "RawModeEnter") == 1) { return 11; }
    if (rp_contains(line, "RawSetPolarity") == 1) { return 10; }
    if (rp_contains(line, "RawTargetVoxel") == 1) { return 9; }
    if (rp_contains(line, "RawSetLaserMw") == 1) { return 8; }
    if (rp_contains(line, "RawInjectPhase") == 1) { return 7; }
    if (rp_contains(line, "RawFireShield") == 1) { return 6; }
    if (rp_contains(line, "TritAlu") == 1) { return 5; }
    if (rp_contains(line, "TritRegLoad") == 1) { return 4; }
    if (rp_contains(line, "LatticeRoute") == 1) { return 3; }
    if (rp_contains(line, "PcmCouple") == 1) { return 2; }
    if (rp_contains(line, "PcmPhaseShift") == 1) { return 1; }
    if (rp_contains(line, "Nop") == 1) { return 0; }
    return -1;
}

fn rp_idx(line: []u8) i32 {
    let sp: i32 = _zag_str_index_of_byte(line, ' ');
    if (sp < 0) { return 0; }
    return _zag_str_to_i64(line[sp + 1..line.len]) as i32;
}

fn v_ok(x: i64, y: i64, z: i64) i32 {
    if (x < 0 || y < 0 || z < 0) { return 0; }
    if (x >= R_EDGE() || y >= R_EDGE() || z >= R_EDGE()) { return 0; }
    return 1;
}
fn l_ok(x: i64, y: i64, z: i64) i32 {
    if (x < 0 || y < 0 || z < 0) { return 0; }
    if (x >= R_LAT() || y >= R_LAT() || z >= R_LAT()) { return 0; }
    return 1;
}
fn r_fault(st: *RState, c: i32, i: i32) void {
    if (st.*.fault == 0) { st.*.fault = c; st.*.finsn = i; }
}

fn r_exec(st: *RState, cls: i32, line: []u8, idx: i32) void {
    if (cls < 0) { r_fault(st, 1, idx); return; }
    if (cls == 0) { return; }
    if (cls == 1) {
        let row: i64 = rp_kv(line, "row");
        let col: i64 = rp_kv(line, "col");
        if (row < 0 || row > 4095 || col < 0 || col > 63) { r_fault(st, 2, idx); return; }
        let cell: i64 = row * 64 + col;
        st.*.pcm[cell] = st.*.pcm[cell] + rp_kv(line, "phase_a") + rp_kv(line, "phase_b");
        return;
    }
    if (cls == 2) {
        let row: i64 = rp_kv(line, "row");
        let col: i64 = rp_kv(line, "col");
        let d: i64 = rp_kv(line, "dst");
        if (row < 0 || row > 4095 || col < 0 || col > 63 || d < 0 || d > 63) {
            r_fault(st, 2, idx); return;
        }
        st.*.couple[d] = st.*.couple[d] + st.*.pcm[row * 64 + col];
        return;
    }
    if (cls == 3) {
        let fx: i64 = rp_kv(line, "from_x") / 1000;
        let fy: i64 = rp_kv(line, "from_y") / 1000;
        let fz: i64 = rp_kv(line, "from_z") / 1000;
        let tx: i64 = rp_kv(line, "to_x") / 1000;
        let ty: i64 = rp_kv(line, "to_y") / 1000;
        let tz: i64 = rp_kv(line, "to_z") / 1000;
        let pw: i64 = rp_kv(line, "power");
        let pl: i64 = rp_kv(line, "pol");
        if (pw < 0 || pl < -1 || pl > 1) { r_fault(st, 1, idx); return; }
        if (l_ok(fx, fy, fz) == 0 || l_ok(tx, ty, tz) == 0) { r_fault(st, 2, idx); return; }
        // axis-wise walk (deliberately different from qemu's DDA but same set:
        // straight axis-aligned segments are what the emitter produces).
        let x: i64 = fx; let y: i64 = fy; let z: i64 = fz;
        while (x != tx || y != ty || z != tz) {
            st.*.lat[(z * R_LAT() + y) * R_LAT() + x] = 1;
            if (v_ok(x, y, z) == 1) {
                let ci: i64 = (z * R_EDGE() + y) * R_EDGE() + x;
                st.*.vocc[ci] = 1; st.*.vamp[ci] = st.*.vamp[ci] + pw;
            }
            if (x < tx) { x = x + 1; } else if (x > tx) { x = x - 1; }
            else if (y < ty) { y = y + 1; } else if (y > ty) { y = y - 1; }
            else if (z < tz) { z = z + 1; } else if (z > tz) { z = z - 1; }
        }
        st.*.lat[(tz * R_LAT() + ty) * R_LAT() + tx] = 1;
        if (v_ok(tx, ty, tz) == 1) {
            let ci: i64 = (tz * R_EDGE() + ty) * R_EDGE() + tx;
            st.*.vocc[ci] = 1; st.*.vamp[ci] = st.*.vamp[ci] + pw;
        }
        st.*.tgt[0] = tx; st.*.tgt[1] = ty; st.*.tgt[2] = tz;
        return;
    }
    if (cls == 4) {
        let d: i64 = rp_kv(line, "dst");
        if (d < 0 || d > 63) { r_fault(st, 2, idx); return; }
        let v: i64 = rp_kv(line, "imm");
        while (v > 9841) { v = v - 19683; }
        while (v < 0 - 9841) { v = v + 19683; }
        st.*.treg[d] = v;
        return;
    }
    if (cls == 5) {
        let a: i64 = rp_kv(line, "a");
        let b: i64 = rp_kv(line, "b");
        let d: i64 = rp_kv(line, "dst");
        if (a < 0 || a > 63 || b < 0 || b > 63 || d < 0 || d > 63) {
            r_fault(st, 2, idx); return;
        }
        if (rp_contains(line, "op=add") == 1) {
            let r: i64 = st.*.treg[a] + st.*.treg[b];
            while (r > 9841) { r = r - 19683; }
            while (r < 0 - 9841) { r = r + 19683; }
            st.*.treg[d] = r;
        } else if (rp_contains(line, "op=mul") == 1) {
            rt_wordop(st, a, b, d, 1);
        } else if (rp_contains(line, "op=nand") == 1) {
            rt_wordop(st, a, b, d, 2);
        } else if (rp_contains(line, "op=neg") == 1) {
            rt_wordop(st, a, b, d, 3);
        } else if (rp_contains(line, "op=cons") == 1) {
            rt_wordop(st, a, b, d, 0);
        } else {
            r_fault(st, 1, idx); return;
        }
        // add path also applies couple
        if (rp_contains(line, "op=add") == 1 && st.*.couple[d] != 0) {
            let dd: *i64 = _zag_malloc(72) as *i64;
            rt_digits(st.*.treg[d], dd);
            let s: i64 = 0;
            if (st.*.couple[d] > 0) { s = 1; }
            if (st.*.couple[d] < 0) { s = -1; }
            dd[0] = rt_cons(dd[0], s);
            st.*.treg[d] = rt_value(dd);
            st.*.couple[d] = 0;
            _zag_free(dd as *i8);
        }
        return;
    }
    if (cls == 11) {
        if (st.*.raw == 1) { r_fault(st, 3, idx); return; }
        st.*.raw = 1; return;
    }
    if (cls == 12) { st.*.raw = 0; return; }
    // raw classes need mode
    if (st.*.raw == 0) { r_fault(st, 3, idx); return; }
    if (cls == 6) {
        let x: i64 = rp_kv(line, "x");
        let y: i64 = rp_kv(line, "y");
        let z: i64 = rp_kv(line, "z");
        let pw: i64 = rp_kv(line, "power");
        if (pw < 0) { r_fault(st, 1, idx); return; }
        if (v_ok(x, y, z) == 0) {
            x = st.*.tgt[0]; y = st.*.tgt[1]; z = st.*.tgt[2];
        }
        if (v_ok(x, y, z) == 0) { r_fault(st, 2, idx); return; }
        let ci: i64 = (z * R_EDGE() + y) * R_EDGE() + x;
        st.*.vocc[ci] = 1; st.*.vamp[ci] = st.*.vamp[ci] + pw;
        return;
    }
    if (cls == 7) {
        let x: i64 = rp_kv(line, "x");
        let y: i64 = rp_kv(line, "y");
        let z: i64 = rp_kv(line, "z");
        if (v_ok(x, y, z) == 0) { r_fault(st, 2, idx); return; }
        st.*.vphase[(z * R_EDGE() + y) * R_EDGE() + x] = rp_kv(line, "phase_micro_rad");
        return;
    }
    if (cls == 8) {
        let w: i64 = rp_kv(line, "wall");
        let sl: i64 = rp_kv(line, "slot");
        let pw: i64 = rp_kv(line, "power");
        if (w < 0 || w > 3 || sl != 0) { r_fault(st, 2, idx); return; }
        if (pw < 0) { r_fault(st, 1, idx); return; }
        st.*.laser[w] = pw;
        return;
    }
    if (cls == 9) {
        let x: i64 = rp_kv(line, "x");
        let y: i64 = rp_kv(line, "y");
        let z: i64 = rp_kv(line, "z");
        if (v_ok(x, y, z) == 0) { r_fault(st, 2, idx); return; }
        st.*.tgt[0] = x; st.*.tgt[1] = y; st.*.tgt[2] = z;
        return;
    }
    if (cls == 10) {
        let x: i64 = rp_kv(line, "x");
        let y: i64 = rp_kv(line, "y");
        let z: i64 = rp_kv(line, "z");
        let pl: i64 = rp_kv(line, "pol");
        if (pl < -1 || pl > 1) { r_fault(st, 1, idx); return; }
        if (v_ok(x, y, z) == 0) { r_fault(st, 2, idx); return; }
        st.*.vpol[(z * R_EDGE() + y) * R_EDGE() + x] = pl;
        return;
    }
    if (cls == 13) {
        let x: i64 = rp_kv(line, "x");
        let y: i64 = rp_kv(line, "y");
        let z: i64 = rp_kv(line, "z");
        let d: i64 = rp_kv(line, "dst");
        if (d < 0 || d > 63) { r_fault(st, 2, idx); return; }
        if (v_ok(x, y, z) == 0) { r_fault(st, 2, idx); return; }
        let ci: i64 = (z * R_EDGE() + y) * R_EDGE() + x;
        let w: i64 = 0;
        let pl: i64 = st.*.vpol[ci];
        if (pl < 0) { pl = 2; }
        w = w + pl;
        w = w + st.*.vphase[ci] * 4;
        w = w + st.*.vamp[ci] * 16777216;
        w = w + st.*.vocc[ci] * 1125899906842624;
        st.*.treg[d] = w;
        return;
    }
}

fn r_dump(st: *RState) void {
    let i: i32 = 0;
    while (i < 64) {
        if (st.*.treg[i] != 0) {
            _zag_print("treg["); _zag_print(_zag_i64_to_str(i as i64));
            _zag_print("]="); _zag_println(_zag_i64_to_str(st.*.treg[i]));
        }
        i = i + 1;
    }
    i = 0;
    while (i < 262144) {
        if (st.*.pcm[i] != 0) {
            _zag_print("pcm["); _zag_print(_zag_i64_to_str((i / 64) as i64));
            _zag_print(","); _zag_print(_zag_i64_to_str((i % 64) as i64));
            _zag_print("]="); _zag_println(_zag_i64_to_str(st.*.pcm[i]));
        }
        i = i + 1;
    }
    i = 0;
    while (i < 512) {
        if (st.*.vocc[i] != 0 || st.*.vphase[i] != 0 || st.*.vpol[i] != 0 || st.*.vamp[i] != 0) {
            let x: i64 = (i % R_EDGE()) as i64;
            let y: i64 = ((i / R_EDGE()) % R_EDGE()) as i64;
            let z: i64 = (i / 64) as i64;
            _zag_print("voxel["); _zag_print(_zag_i64_to_str(x));
            _zag_print(","); _zag_print(_zag_i64_to_str(y));
            _zag_print(","); _zag_print(_zag_i64_to_str(z));
            _zag_print("] pol="); _zag_print(_zag_i64_to_str(st.*.vpol[i]));
            _zag_print(" phase="); _zag_print(_zag_i64_to_str(st.*.vphase[i]));
            _zag_print(" amp="); _zag_print(_zag_i64_to_str(st.*.vamp[i]));
            _zag_print(" occ="); _zag_println(_zag_i64_to_str(st.*.vocc[i]));
        }
        i = i + 1;
    }
    i = 0;
    while (i < 2097152) {
        if (st.*.lat[i] != 0) {
            let x: i64 = (i % R_LAT()) as i64;
            let y: i64 = ((i / R_LAT()) % R_LAT()) as i64;
            let z: i64 = (i / (R_LAT() * R_LAT())) as i64;
            _zag_print("lattice["); _zag_print(_zag_i64_to_str(x));
            _zag_print(","); _zag_print(_zag_i64_to_str(y));
            _zag_print(","); _zag_print(_zag_i64_to_str(z));
            _zag_println("] occ=1");
        }
        i = i + 1;
    }
    i = 0;
    while (i < 4) {
        if (st.*.laser[i] != 0) {
            _zag_print("laser["); _zag_print(_zag_i64_to_str(i as i64));
            _zag_print("]="); _zag_println(_zag_i64_to_str(st.*.laser[i]));
        }
        i = i + 1;
    }
    _zag_print("fault="); _zag_print(_zag_i64_to_str(st.*.fault as i64));
    _zag_print(" at="); _zag_println(_zag_i64_to_str(st.*.finsn as i64));
}

fn main() i32 {
    if (_zag_argc() < 2) {
        _zag_println("usage: ref_interp <file.ppu32>");
        return 1;
    }
    let text: []u8 = _zag_read_file(_zag_arg(1));
    let st: *RState = rs_new();
    let i: i32 = 0;
    let ran: i32 = 0;
    while (i < text.len && st.*.fault == 0) {
        while (i < text.len && (text[i] == ' ' || text[i] == '\t' || text[i] == '\r')) { i = i + 1; }
        let s: i32 = i;
        while (i < text.len && text[i] != '\n') { i = i + 1; }
        if (i > s) {
            let line: []u8 = text[s..i];
            if (line.len > 0 && line[0] != '#' && rp_contains(line, "insn ") == 1) {
                r_exec(st, rp_class(line), line, rp_idx(line));
                ran = ran + 1;
            }
        }
        if (i < text.len) { i = i + 1; }
    }
    r_dump(st);
    if (ran < 1) { return 1; }
    if (st.*.fault != 0) { return 2; }
    return 0;
}
