// flasht/qemu_ppu32.zag — minimal PPU32 bring-up interpreter (qemu runtime).
//
// Executes LatticeRoute + PcmPhaseShift ops from a .ppu32 text assembly file.
// Usage: qemu_ppu32 <file.ppu32>

@import("../flash/toolchain/zag-poc/std/rt.zag")

struct QIns {
    kind: i32,   // 1 = PcmPhaseShift, 3 = LatticeRoute
    row: i32,
    col: i32,
    phase_a: i32,
    phase_b: i32,
    result: i32,
    from_x: i32,
    from_y: i32,
    from_z: i32,
    to_x: i32,
    to_y: i32,
    to_z: i32,
    power: i32,
    pol: i32,
}

fn qp_contains(hay: []u8, needle: []u8) i32 {
    if (needle.len < 1 || hay.len < needle.len) { return 0; }
    let i: i32 = 0;
    while (i <= hay.len - needle.len) {
        let j: i32 = 0;
        let ok: i32 = 1;
        while (j < needle.len) {
            if (hay[i + j] != needle[j]) { ok = 0; }
            j = j + 1;
        }
        if (ok == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn qp_parse_i32(line: []u8, key: []u8) i32 {
    let pat: []u8 = _zag_str_concat(key, "=");
    let at: i32 = 0;
    while (at <= line.len - pat.len) {
        let j: i32 = 0;
        let ok: i32 = 1;
        while (j < pat.len) {
            if (line[at + j] != pat[j]) { ok = 0; }
            j = j + 1;
        }
        if (ok == 1) {
            let start: i32 = at + pat.len;
            let neg: i32 = 0;
            let cur: i32 = start;
            if (cur < line.len && line[cur] == '-') {
                neg = 1;
                cur = cur + 1;
            }
            let val: i32 = 0;
            while (cur < line.len) {
                let c: i32 = line[cur] as i32;
                if (c < '0' || c > '9') {
                    cur = line.len;
                } else {
                    val = val * 10 + (c - '0');
                    cur = cur + 1;
                }
            }
            if (neg == 1) { return 0 - val; }
            return val;
        }
        at = at + 1;
    }
    return 0;
}

fn qp_exec_pcm(ins: QIns) void {
    // Bring-up model: record PCM cell phase state (no hardware).
    let _phase: i32 = ins.phase_a + ins.phase_b;
    let _cell: i32 = ins.row * 64 + ins.col;
    if (_cell < 0) { return; }
}

fn qp_exec_route(ins: QIns) void {
    // Bring-up model: accept coordinate route without collision checks.
    let _dx: i32 = ins.to_x - ins.from_x;
    let _dy: i32 = ins.to_y - ins.from_y;
    let _dz: i32 = ins.to_z - ins.from_z;
    let _mw: i32 = ins.power;
    if (_mw < 0) { return; }
    if (ins.pol < -1 || ins.pol > 1) { return; }
}

fn qp_parse_line(line: []u8) QIns {
    let ins: QIns = QIns{
        .kind = 0,
        .row = 0,
        .col = 0,
        .phase_a = 0,
        .phase_b = 0,
        .result = 0,
        .from_x = 0,
        .from_y = 0,
        .from_z = 0,
        .to_x = 0,
        .to_y = 0,
        .to_z = 0,
        .power = 0,
        .pol = 0,
    };
    if (qp_contains(line, "PcmPhaseShift") == 1) {
        ins.kind = 1;
        ins.row = qp_parse_i32(line, "row");
        ins.col = qp_parse_i32(line, "col");
        ins.phase_a = qp_parse_i32(line, "phase_a");
        ins.phase_b = qp_parse_i32(line, "phase_b");
        ins.result = qp_parse_i32(line, "result");
        return ins;
    }
    if (qp_contains(line, "LatticeRoute") == 1) {
        ins.kind = 3;
        ins.from_x = qp_parse_i32(line, "from_x");
        ins.from_y = qp_parse_i32(line, "from_y");
        ins.from_z = qp_parse_i32(line, "from_z");
        ins.to_x = qp_parse_i32(line, "to_x");
        ins.to_y = qp_parse_i32(line, "to_y");
        ins.to_z = qp_parse_i32(line, "to_z");
        ins.power = qp_parse_i32(line, "power");
        ins.pol = qp_parse_i32(line, "pol");
        return ins;
    }
    return ins;
}

fn qp_run_text(text: []u8) i32 {
    let pcm_count: i32 = 0;
    let route_count: i32 = 0;
    let i: i32 = 0;
    while (i < text.len) {
        while (i < text.len && (text[i] == ' ' || text[i] == '\t' || text[i] == '\r')) {
            i = i + 1;
        }
        let start: i32 = i;
        while (i < text.len && text[i] != '\n') { i = i + 1; }
        if (i > start) {
            let line: []u8 = text[start..i];
            if (qp_contains(line, "insn ") == 1) {
                let ins: QIns = qp_parse_line(line);
                if (ins.kind == 1) {
                    qp_exec_pcm(ins);
                    pcm_count = pcm_count + 1;
                } else if (ins.kind == 3) {
                    qp_exec_route(ins);
                    route_count = route_count + 1;
                }
            }
        }
        if (i < text.len) { i = i + 1; }
    }
    if (pcm_count < 1 && route_count < 1) { return 1; }
    return 0;
}

fn main() i32 {
    if (_zag_argc() < 2) {
        _zag_println("usage: qemu_ppu32 <file.ppu32>");
        return 1;
    }
    let path: []u8 = _zag_arg(1);
    let text: []u8 = _zag_read_file(path);
    if (text.len < 0) {
        _zag_print("qemu_ppu32: cannot read ");
        _zag_println(path);
        return 1;
    }
    if (qp_run_text(text) != 0) {
        _zag_println("qemu_ppu32: no executable insns");
        return 1;
    }
    _zag_println("qemu_ppu32: ok");
    return 0;
}