# ppu32 assembly v1
target = "ppu32"
name = "ternary_logic"
format = "ppu32-v1"
[insns]
insn 0 LatticeRoute from_x=0 from_y=0 from_z=0 to_x=0 to_y=0 to_z=0 power=1250 pol=1 tag="trit_lit"
insn 1 LatticeRoute from_x=0 from_y=0 from_z=0 to_x=0 to_y=0 to_z=0 power=1250 pol=-1 tag="trit_lit"
insn 2 LatticeRoute from_x=30000 from_y=21000 from_z=0 to_x=30000 to_y=21000 to_z=0 power=1000 pol=0 tag="trit_lit"
insn 3 LatticeRoute from_x=30000 from_y=21000 from_z=0 to_x=30000 to_y=21000 to_z=0 power=1250 pol=1 tag="trit_var"
insn 4 LatticeRoute from_x=60000 from_y=0 from_z=0 to_x=60000 to_y=0 to_z=0 power=1250 pol=-1 tag="trit_var"
insn 5 PcmPhaseShift row=10 col=0 phase_a=1047197 phase_b=-1047197 result=0 lattice_op=3 tag="trit_add"
insn 6 LatticeRoute from_x=60000 from_y=0 from_z=0 to_x=60000 to_y=0 to_z=0 power=1500 pol=0 tag="trit_add"
insn 7 LatticeRoute from_x=90000 from_y=21000 from_z=0 to_x=90000 to_y=21000 to_z=0 power=1250 pol=1 tag="trit_var"
insn 8 LatticeRoute from_x=90000 from_y=21000 from_z=0 to_x=90000 to_y=21000 to_z=0 power=1000 pol=0 tag="trit_var"
insn 9 PcmPhaseShift row=16 col=0 phase_a=1047197 phase_b=0 result=0 lattice_op=5 tag="trit_mul"
insn 10 LatticeRoute from_x=0 from_y=30000 from_z=0 to_x=0 to_y=30000 to_z=0 power=1250 pol=0 tag="trit_mul"
insn 11 LatticeRoute from_x=0 from_y=30000 from_z=0 to_x=0 to_y=30000 to_z=0 power=1000 pol=0 tag="trit_var"
insn 12 LatticeRoute from_x=30000 from_y=51000 from_z=0 to_x=30000 to_y=51000 to_z=0 power=1000 pol=0 tag="trit_var"
insn 13 PcmPhaseShift row=22 col=0 phase_a=0 phase_b=0 result=0 lattice_op=7 tag="trit_nand"
insn 14 LatticeRoute from_x=30000 from_y=51000 from_z=0 to_x=30000 to_y=51000 to_z=0 power=1000 pol=0 tag="trit_nand"
insn 15 LatticeRoute from_x=60000 from_y=30000 from_z=0 to_x=60000 to_y=30000 to_z=0 power=1000 pol=0 tag="trit_var"
insn 16 PcmPhaseShift row=26 col=0 phase_a=0 phase_b=0 result=0 lattice_op=2 tag="trit_neg"
insn 17 LatticeRoute from_x=60000 from_y=30000 from_z=0 to_x=60000 to_y=30000 to_z=0 power=1000 pol=0 tag="trit_neg"
