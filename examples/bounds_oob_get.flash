// examples/bounds_oob_get.flash — must panic at runtime (OOB get).

extern fn _zag_print(s: []u8) void;
extern fn _zag_println(s: []u8) void;
extern fn _zag_i64_to_str(v: i64) []u8;

@import("std/list.flash")

fn main() i32 {
    let xs: ArrayList[i32] = make[i32](4);
    push[i32](&xs, 1);
    // Valid read first to prove the list works.
    _zag_println(_zag_i64_to_str(get[i32](xs, 0) as i64));
    // Deliberate OOB: index 10 on a len-1 list.
    let bad: i32 = get[i32](xs, 10);
    _zag_println(_zag_i64_to_str(bad as i64));
    free[i32](&xs);
    return 0;
}
