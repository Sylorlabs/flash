let trit_mul(v49, positive) = v50
let trit_nand(v50, zero) = v51
let trit_neg(v51, zero) = v52
let trit_add(v52, negative) = v53
let trit_mul(v53, positive) = v54
let trit_nand(v54, zero) = v55
let trit_neg(v55, zero) = v56
let trit_add(v56, negative) = v57
let trit_mul(v57, positive) = v58
let trit_nand(v58, zero) = v59
let trit_neg(v59, zero) = v60
let trit_add(v60, negative) = v61
let trit_mul(v61, positive) = v62
let trit_nand(v62, zero) = v63
let trit_neg(v63, zero) = v64

