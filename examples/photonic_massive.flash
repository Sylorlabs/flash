// Large balanced-ternary photonic workload used by Flash and Triton integration gates.
program photonic_massive

trit positive = +1
trit negative = T
trit zero = 0

let trit_add(positive, negative) = v1
let trit_mul(v1, positive) = v2
let trit_nand(v2, zero) = v3
let trit_neg(v3, zero) = v4
let trit_add(v4, negative) = v5
let trit_mul(v5, positive) = v6
let trit_nand(v6, zero) = v7
let trit_neg(v7, zero) = v8
let trit_add(v8, negative) = v9
let trit_mul(v9, positive) = v10
let trit_nand(v10, zero) = v11
let trit_neg(v11, zero) = v12
let trit_add(v12, negative) = v13
let trit_mul(v13, positive) = v14
let trit_nand(v14, zero) = v15
let trit_neg(v15, zero) = v16
let trit_add(v16, negative) = v17
let trit_mul(v17, positive) = v18
let trit_nand(v18, zero) = v19
let trit_neg(v19, zero) = v20
let trit_add(v20, negative) = v21
let trit_mul(v21, positive) = v22
let trit_nand(v22, zero) = v23
let trit_neg(v23, zero) = v24
