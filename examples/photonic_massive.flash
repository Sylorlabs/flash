let trit_mul(v25, positive) = v26
let trit_nand(v26, zero) = v27
let trit_neg(v27, zero) = v28
let trit_add(v28, negative) = v29
let trit_mul(v29, positive) = v30
let trit_nand(v30, zero) = v31
let trit_neg(v31, zero) = v32
let trit_add(v32, negative) = v33
let trit_mul(v33, positive) = v34
let trit_nand(v34, zero) = v35
let trit_neg(v35, zero) = v36
let trit_add(v36, negative) = v37
let trit_mul(v37, positive) = v38
let trit_nand(v38, zero) = v39
let trit_neg(v39, zero) = v40
let trit_add(v40, negative) = v41
let trit_mul(v41, positive) = v42
let trit_nand(v42, zero) = v43
let trit_neg(v43, zero) = v44
let trit_add(v44, negative) = v45
let trit_mul(v45, positive) = v46
