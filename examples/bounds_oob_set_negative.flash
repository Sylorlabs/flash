// examples/bounds_oob_set_negative.flash — must panic at runtime (set negative index).

extern fn _zag_print(s: []u8) void;
extern fn _zag_println(s: []u8) void;
extern fn _zag_i64_to_str(v: i64) []u8;

@import("std/list.flash")

fn main() i32 {
    let xs: ArrayList[i32] = make[i32](4);
    push[i32](&xs, 1);
    // Deliberate OOB: set index -1 on a len-1 list.
    set[i32](&xs, -1, 99);
    free[i32](&xs);
    return 0;
}
