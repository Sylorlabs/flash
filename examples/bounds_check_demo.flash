// examples/bounds_check_demo.flash — ArrayList bounds checks (valid path).

extern fn _zag_print(s: []u8) void;
extern fn _zag_println(s: []u8) void;
extern fn _zag_i64_to_str(v: i64) []u8;

@import("std/list.flash")

fn main() i32 {
    let xs: ArrayList[i32] = make[i32](2);
    push[i32](&xs, 10);
    push[i32](&xs, 20);
    push[i32](&xs, 30);

    let a: i32 = get[i32](xs, 0);
    let b: i32 = get[i32](xs, 1);
    let c: i32 = get[i32](xs, 2);

    _zag_print("a=");
    _zag_println(_zag_i64_to_str(a as i64));
    _zag_print("b=");
    _zag_println(_zag_i64_to_str(b as i64));
    _zag_print("c=");
    _zag_println(_zag_i64_to_str(c as i64));

    let p: i32 = pop[i32](&xs);
    _zag_print("pop=");
    _zag_println(_zag_i64_to_str(p as i64));
    _zag_print("len=");
    _zag_println(_zag_i64_to_str(len[i32](xs) as i64));

    set[i32](&xs, 0, 99);
    _zag_print("set0=");
    _zag_println(_zag_i64_to_str(get[i32](xs, 0) as i64));

    free[i32](&xs);
    _zag_println("bounds_check_demo: ok");
    return 0;
}
