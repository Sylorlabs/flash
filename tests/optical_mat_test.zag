// tests/optical_mat_test.zag — flashc optical matrix manifest regression.
//
// Compiles examples/optical_mat.flash via flashc and verifies the emitted
// coordinate manifest contains nine mat3_route PathSegments (mat3_r0c0..r2c2).

@import("../flash/toolchain/zag-poc/std/rt.zag")
@import("../flash/toolchain/zag-poc/selfhost/std/process.zag")

fn omt_fail(msg: []u8) void {
    _zag_print("optical_mat_test FAIL: ");
    _zag_println(msg);
    process_exit(1);
}

fn omt_run(cmd: []u8) void {
    let rc: i32 = process_run_shell(cmd);
    if (rc != 0) {
        _zag_print("optical_mat_test FAIL cmd: ");
        _zag_println(cmd);
        process_exit(1);
    }
}

fn omt_count_substr(hay: []u8, needle: []u8) i32 {
    if (needle.len < 1 || hay.len < needle.len) { return 0; }
    let count: i32 = 0;
    let i: i32 = 0;
    while (i <= hay.len - needle.len) {
        let j: i32 = 0;
        let ok: i32 = 1;
        while (j < needle.len) {
            if (hay[i + j] != needle[j]) { ok = 0; }
            j = j + 1;
        }
        if (ok == 1) {
            count = count + 1;
            i = i + needle.len;
        } else {
            i = i + 1;
        }
    }
    return count;
}

fn main() i32 {
    _zag_println("optical_mat_test: start");

    let root: []u8 = ".";
    if (_zag_file_exists("flash.mod") == 0) {
        if (_zag_file_exists("../flash.mod") == 1) { root = ".."; }
    }

    if (_zag_file_exists(_zag_str_concat(root, "/flashc")) == 0) {
        omt_fail("flashc binary not found — run build.sh first");
    }

    let src: []u8 = _zag_str_concat(root, "/examples/optical_mat.flash");
    let manifest_path: []u8 = _zag_str_concat(root, "/examples/flash.manifest");

    let check_cmd: []u8 = _zag_str_concat(_zag_str_concat(root, "/flashc "), src);
    check_cmd = _zag_str_concat(check_cmd, " --check");
    omt_run(check_cmd);

    let emit_cmd: []u8 = _zag_str_concat(_zag_str_concat(root, "/flashc "), src);
    emit_cmd = _zag_str_concat(emit_cmd, " --emit-manifest --emit-zag");
    omt_run(emit_cmd);

    let text: []u8 = _zag_read_file(manifest_path);
    if (text.len < 0) {
        omt_fail("manifest not emitted");
    }

    let mat3_hits: i32 = omt_count_substr(text, "op = \"mat3_r");
    print_i32(mat3_hits);

    if (mat3_hits != 9) {
        omt_fail("expected 9 mat3_route segments");
    }

    _zag_println("optical_mat_test: ok");
    return 0;
}