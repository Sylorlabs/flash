// tests/trit/literals.flash — W4: balanced-ternary digit literals (0t prefix).

@import("std/flash_std.flash")

fn main() i32 {
    // Single trit: 0t+ = +1 = 1
    let a: t9 = 0t+;
    if (a != 1) { return 1; }

    // 0t0 = 0
    let b: t9 = 0t0;
    if (b != 0) { return 2; }

    // 0t- = -1
    let c: t9 = 0t-;
    if (c != -1) { return 3; }

    // 0tT = -1 (T is alternative for -1)
    let d: t9 = 0tT;
    if (d != -1) { return 4; }

    // 0t++ = +1*3 + +1 = 4
    let e: t9 = 0t++;
    if (e != 4) { return 5; }

    // 0t+0 = +1*3 + 0 = 3
    let f: t9 = 0t+0;
    if (f != 3) { return 6; }

    // 0t0+ = 0*3 + +1 = 1
    let g: t9 = 0t0+;
    if (g != 1) { return 7; }

    // 0t+- = +1*3 + -1 = 2
    let h: t9 = 0t+-;
    if (h != 2) { return 8; }

    // 0t-+ = -1*3 + +1 = -2
    let i_val: t9 = 0t-+;
    if (i_val != -2) { return 9; }

    // 0t-- = -1*3 + -1 = -4
    let j: t9 = 0t--;
    if (j != -4) { return 10; }

    // 9 trits: 0t+++++++++ = (3^9 - 1)/2 = 9841
    let max: t9 = 0t+++++++++;
    if (max != 9841) { return 11; }

    // 9 trits: 0tTTTTTTTTT = -(3^9 - 1)/2 = -9841
    let min: t9 = 0tTTTTTTTTT;
    if (min != -9841) { return 12; }

    // 9 trits: 0t000000000 = 0
    let zero: t9 = 0t000000000;
    if (zero != 0) { return 13; }

    // Mixed: 0t+0-+0+0+ = 8 trits
    // = 1*3^7 + 0*3^6 + (-1)*3^5 + 1*3^4 + 0*3^3 + 1*3^2 + 0*3^1 + 1*3^0
    // = 2187 - 243 + 81 + 9 + 1 = 2035
    let mix: t9 = 0t+0-+0+0+;
    if (mix != 2035) { return 14; }

    // Uppercase 0T prefix (W4 fix)
    let up: t9 = 0T++;
    if (up != 4) { return 15; }

    // Lowercase t in digits: 0t+t = +1*3 + -1 = 2
    let lt: t9 = 0t+t;
    if (lt != 2) { return 16; }

    // 27 trits: 0t+++++++++++++++++++++++++++ = (3^27-1)/2 = 3812798742493
    let big: t27 = 0t+++++++++++++++++++++++++++;
    if (big != 3812798742493) { return 17; }

    flash_println("trit_literals: ok");
    return 0;
}
