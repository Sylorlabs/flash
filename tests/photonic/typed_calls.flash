// tests/photonic/typed_calls.flash — W6: typed photonic API.
//
// This test verifies that the typed photonic API works correctly:
// - FlashVoxel, FlashBeam, FlashPhase, FlashPower, FlashPolarity constructors
// - Typed API functions (fire_shield, inject_phase, set_laser, etc.)
// - Unit types prevent mixing radians and milliwatts

program typed_calls

@import("photonic_stubs.flash")
@import("std/photonic.flash")
@import("std/flash_std.flash")

fn main() i32 {
    // Typed constructors
    let v: FlashVoxel = voxel(2, 1, 0);
    if (v.x != 2) { return 1; }
    if (v.y != 1) { return 2; }
    if (v.z != 0) { return 3; }

    let b: FlashBeam = beam(wall_n(), 0);
    if (b.wall != 0) { return 4; }
    if (b.slot != 0) { return 5; }

    let p: FlashPhase = rad(0.785);
    // Can't compare f32 directly easily, just check it's stored
    let pw: FlashPower = mw(1.5);
    let pol: FlashPolarity = polarity(axis_vert(), 0);

    if (pol.axis != 1) { return 6; }
    if (pol.value != 0) { return 7; }

    // Wall constants
    if (wall_n() != 0) { return 8; }
    if (wall_e() != 1) { return 9; }
    if (wall_s() != 2) { return 10; }
    if (wall_w() != 3) { return 11; }

    // Axis constants
    if (axis_off() != 0) { return 12; }
    if (axis_vert() != 1) { return 13; }
    if (axis_horz() != 2) { return 14; }

    // Typed API calls (these call externs which return 0 in test env)
    // We just verify they compile and call without crashing
    let _r1: i32 = fire_shield(v, pw);
    let _r2: i32 = inject_phase(v, p);
    let _r3: i32 = set_laser(b, pw);
    let _r4: i32 = target_voxel(v);
    let _r5: i32 = manual_polarity(v, pol);

    // Raw session guard
    let _enter: i32 = raw_enter();
    let _exit: i32 = raw_exit();

    flash_println("typed_calls: ok");
    return 0;
}
