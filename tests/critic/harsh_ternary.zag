// harsh_ternary.zag — exhaustive 3×3 truth-table adversarial sweep.
//
// Truth tables from flash/stdlib/trit_math.zag (znc-safe mirror of ternary/truth_tables.zag).

@import("../../flash/toolchain/zag-poc/std/rt.zag")
@import("../../flash/stdlib/trit_math.zag") as tm

fn wire_at(idx: i32) i8 {
    if (idx == 0) { return 0 - 1; }
    if (idx == 1) { return 0; }
    return 1;
}

fn table_cell(t: tm.TruthTable9, row: i32, col: i32) i8 {
    return tm.lookup(t, wire_at(row), wire_at(col));
}

fn sweep_and(t: tm.TruthTable9, name: []u8) void {
    let row: i32 = 0;
    while (row < 3) {
        let col: i32 = 0;
        while (col < 3) {
            let a: i8 = wire_at(row);
            let b: i8 = wire_at(col);
            if (tm.ternary_and(a, b) != table_cell(t, row, col)) {
                _zag_print("FAIL ");
                _zag_println(name);
                _zag_exit(1);
            }
            col = col + 1;
        }
        row = row + 1;
    }
    _zag_print("PASS ");
    _zag_println(name);
}

fn sweep_or(t: tm.TruthTable9, name: []u8) void {
    let row: i32 = 0;
    while (row < 3) {
        let col: i32 = 0;
        while (col < 3) {
            let a: i8 = wire_at(row);
            let b: i8 = wire_at(col);
            if (tm.ternary_or(a, b) != table_cell(t, row, col)) {
                _zag_print("FAIL ");
                _zag_println(name);
                _zag_exit(1);
            }
            col = col + 1;
        }
        row = row + 1;
    }
    _zag_print("PASS ");
    _zag_println(name);
}

fn sweep_xor(t: tm.TruthTable9, name: []u8) void {
    let row: i32 = 0;
    while (row < 3) {
        let col: i32 = 0;
        while (col < 3) {
            let a: i8 = wire_at(row);
