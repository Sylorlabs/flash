fn sweep_consensus(t: tm.TruthTable9, name: []u8) void {
    let row: i32 = 0;
    while (row < 3) {
        let col: i32 = 0;
        while (col < 3) {
            let a: i8 = wire_at(row);
            let b: i8 = wire_at(col);
            if (tm.consensus(a, b) != table_cell(t, row, col)) {
                _zag_print("FAIL ");
                _zag_println(name);
                _zag_exit(1);
            }
            col = col + 1;
        }
        row = row + 1;
    }
    _zag_print("PASS ");
    _zag_println(name);
