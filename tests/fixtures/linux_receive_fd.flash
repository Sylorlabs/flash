        failures = failures + receive_fd_expect(parsed.invalid == 1
            && parsed.fd_count == 1 && parsed.retained_fd_count == 0
            && len[i64](parsed.fds) == 0 && parsed.fds.cap == 3
            && parsed.close_attempt_count == 1 && parsed.closed_fd_count == 1
            && parsed.close_error_code == 0
            && parsed.last_closed_fd == many_malformed_pair.first
            && linux_fd_flags(many_malformed_pair.first) == (0 - 9),
            "malformed control closes every ordered descriptor parsed before the fault");
        free[i64](&parsed.fds); linux_buffer_free(&control);
        let _close_many_malformed_second: i64 = linux_close(many_malformed_pair.second);
    }

    let malformed_record_pair: LinuxFdPair = linux_socketpair_stream();
    failures = failures + receive_fd_expect(malformed_record_pair.ok == 1,
        "malformed rights-record fixture resources");
    if (malformed_record_pair.ok == 1) {
        let control: LinuxByteBuffer = linux_buffer_new(21);
        linux_buffer_set_u64(&control, 0, 21);
        linux_buffer_set_u32(&control, 8, 1);
        linux_buffer_set_u32(&control, 12, 1);
        linux_buffer_set_u32(&control, 16, malformed_record_pair.first);
        linux_buffer_set_byte(&control, 20, 127);
        control.len = 21;
        let parsed: LinuxControlFdsResult = linux_parse_scm_rights_many(
            &control, 21, 3, 0);
        failures = failures + receive_fd_expect(parsed.invalid == 1
            && parsed.fd_count == 1 && parsed.retained_fd_count == 0
            && parsed.close_attempt_count == 1 && parsed.closed_fd_count == 1
            && parsed.close_error_code == 0
            && parsed.last_closed_fd == malformed_record_pair.first
            && linux_fd_flags(malformed_record_pair.first) == (0 - 9),
            "malformed SCM_RIGHTS data closes each complete installed FD slot");
        free[i64](&parsed.fds); linux_buffer_free(&control);
        let _close_malformed_record_second: i64 = linux_close(
            malformed_record_pair.second);
    }

    // Poison the exact native size class reused by the 56-byte msghdr. Freeing
    // replaces word zero with the allocator link but leaves msg_namelen=1 in
    // word one; before explicit zeroing that stale ABI state made sendmsg fail
    // and the following blocking recv hung forever.
    let poisoned_msghdr_reuse: LinuxByteBuffer = linux_buffer_new(40);
    linux_buffer_set_u64(&poisoned_msghdr_reuse, 0, 20);
    linux_buffer_set_u32(&poisoned_msghdr_reuse, 8, 1);
    linux_buffer_set_u32(&poisoned_msghdr_reuse, 12, 1);
    linux_buffer_free(&poisoned_msghdr_reuse);

    let close_error_pair: LinuxFdPair = linux_socketpair_stream();
    let close_error_pipe: LinuxFdPair = linux_pipe_cloexec();
    failures = failures + receive_fd_expect(close_error_pair.ok == 1
        && close_error_pipe.ok == 1, "multi-FD close-error fixture resources");
    if (close_error_pair.ok == 1 && close_error_pipe.ok == 1) {
        let outgoing: LinuxByteBuffer = linux_buffer_new(1);
        linux_buffer_set_byte(&outgoing, 0, 101);
        let sent: i64 = linux_send_buffer_fd(
            close_error_pair.first, &outgoing, close_error_pipe.first);
        failures = failures + receive_fd_expect(sent == 1,
            "zeroed syscall ABI storage survives poisoned native allocator reuse");
        let received: LinuxReceiveFdsResult = receive_fds_after(sent == 1,
            close_error_pair.second, 1, 1);
        let received_fd: i64 = 0 - 1;
        if (len[i64](received.fds) == 1) { received_fd = received.fds.data[0]; }
        let caller_closed: i64 = linux_close(received_fd);
        let released: i32 = linux_receive_fds_result_free(&received);
        let released_again: i32 = linux_receive_fds_result_free(&received);
        failures = failures + receive_fd_expect(sent == 1 && caller_closed == 0
            && released == 0 && released_again == 0 && received.released == 1
            && received.close_attempt_count == 1 && received.closed_fd_count == 0
            && received.last_closed_fd == received_fd
            && received.close_error_code == (0 - 9)
            && linux_fd_flags(received_fd) == (0 - 9)
            && linux_fd_flags(close_error_pipe.first) >= 0,
            "cleanup exposes exact close failure once and remains idempotent");
        linux_buffer_free(&outgoing);
        let _close_error_pipe_read: i64 = linux_close(close_error_pipe.first);
        let _close_error_pipe_write: i64 = linux_close(close_error_pipe.second);
        let _close_error_pair_first: i64 = linux_close(close_error_pair.first);
        let _close_error_pair_second: i64 = linux_close(close_error_pair.second);
    } else {
        if (close_error_pipe.ok == 1) {
            let _close_error_pipe_read: i64 = linux_close(close_error_pipe.first);
            let _close_error_pipe_write: i64 = linux_close(close_error_pipe.second);
        }
        if (close_error_pair.ok == 1) {
            let _close_error_pair_first: i64 = linux_close(close_error_pair.first);
            let _close_error_pair_second: i64 = linux_close(close_error_pair.second);
        }
    }

    if (failures != 0) { return 1; }
    _zag_println("linux_receive_fd: ok");
    return 0;
}
