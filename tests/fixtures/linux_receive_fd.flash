@import("../../flash/runtime/linux.flash")

fn receive_fd_expect(ok: i32, message: []u8) i32 {
    if (ok == 0) { _zag_print("FAIL "); _zag_println(message); return 1; }
    return 0;
}

fn receive_fd_socketpair(kind: i64) LinuxFdPair {
    let fds: ArrayList[i64] = make[i64](1);
    let rc: i64 = _zag_raw_syscall(linux_sys_socketpair(), linux_af_unix(), kind,
        0, fds.data as i64, 0, 0);
    let pair: LinuxFdPair = LinuxFdPair{ .first = 0 - 1, .second = 0 - 1, .ok = 0 };
    if (rc == 0) {
        let packed: i64 = fds.data[0];
        pair.first = packed - (packed / 4294967296) * 4294967296;
        pair.second = packed / 4294967296;
        pair.ok = 1;
    }
    free[i64](&fds);
    return pair;
}

// Every fixture receive is preceded by a bounded readiness check. A failed
// sender therefore becomes an immediate test failure instead of an unbounded
// blocking recv/read that hides the original errno.
fn receive_fd_ready_after(send_ok: i32, fd: i64) i64 {
    if (send_ok == 0) { return 0 - 5; }
    let ready: i64 = linux_poll_event_status(fd, 1, 1000);
    if (ready == 0) { return 0 - 110; }
    return ready;
}

fn receive_fd_read_after(send_ok: i32, fd: i64,
    out: *LinuxByteBuffer) i64 {
    let ready: i64 = receive_fd_ready_after(send_ok, fd);
    if (ready != 1) { return ready; }
    return linux_read_into(fd, out);
}

fn receive_fd_one_after(send_ok: i32, fd: i64,
    capacity: i32) LinuxReceiveFdResult {
    let ready: i64 = receive_fd_ready_after(send_ok, fd);
    if (ready == 1) { return linux_receive_buffer_fd(fd, capacity); }
    let result: LinuxReceiveFdResult = linux_receive_buffer_fd(0 - 1, capacity);
    result.error_code = ready;
    return result;
}

fn receive_fds_after(send_ok: i32, fd: i64, capacity: i32,
    accepted_fd_cap: t27) LinuxReceiveFdsResult {
    let ready: i64 = receive_fd_ready_after(send_ok, fd);
    if (ready == 1) {
        return linux_receive_buffer_fds(fd, capacity, accepted_fd_cap);
    }
    let result: LinuxReceiveFdsResult = linux_receive_buffer_fds(
        0 - 1, capacity, accepted_fd_cap);
    result.error_code = ready;
    return result;
}

fn receive_fds_fallback_after(send_ok: i32, fd: i64, capacity: i32,
    accepted_fd_cap: t27) LinuxReceiveFdsResult {
    let ready: i64 = receive_fd_ready_after(send_ok, fd);
    if (ready == 1) {
        return linux_receive_buffer_fds_with_cloexec_mode(
            fd, capacity, accepted_fd_cap, 0);
    }
    let result: LinuxReceiveFdsResult = linux_receive_buffer_fds(
        0 - 1, capacity, accepted_fd_cap);
    result.error_code = ready;
    return result;
}

// Test-only multi-descriptor sender. The production single-FD sender remains
// intentionally narrow; this fixture exercises excess and truncated control
// ownership with a real kernel SCM_RIGHTS message.
fn receive_fd_send_many(socket_fd: i64, data: *LinuxByteBuffer, fds: *ArrayList[i64]) i64 {
    let count: i32 = len[i64](fds.*);
    if (socket_fd < 0 || data.*.len < 1 || count < 1 || count > 16) { return 0 - 22; }
    let fd_i: i32 = 0;
    while (fd_i < count) {
        if (get[i64](fds.*, fd_i) < 0) { return 0 - 22; }
        fd_i = fd_i + 1;
    }
    let iovec: LinuxByteBuffer = linux_buffer_new(16);
    linux_buffer_set_u64(&iovec, 0, data.*.words.data as i64);
    linux_buffer_set_u64(&iovec, 8, data.*.len as i64);
    let cmsg_len: i64 = 16 + (count as i64) * 4;
    let control_len: i32 = linux_cmsg_align(cmsg_len) as i32;
    let control: LinuxByteBuffer = linux_buffer_new(control_len);
    linux_buffer_set_u64(&control, 0, cmsg_len);
    linux_buffer_set_u32(&control, 8, 1);
    linux_buffer_set_u32(&control, 12, 1);
    fd_i = 0;
    while (fd_i < count) {
        linux_buffer_set_u32(&control, 16 + fd_i * 4, get[i64](fds.*, fd_i));
        fd_i = fd_i + 1;
    }
    control.len = control_len;
    let message: LinuxByteBuffer = linux_buffer_new(56);
    linux_buffer_zero_storage(&message);
    linux_buffer_set_u64(&message, 16, iovec.words.data as i64);
    linux_buffer_set_u64(&message, 24, 1);
    linux_buffer_set_u64(&message, 32, control.words.data as i64);
    linux_buffer_set_u64(&message, 40, control_len as i64);
    message.len = 56;
    let sent: i64 = _zag_raw_syscall(linux_sys_sendmsg(), socket_fd,
        message.words.data as i64, 0, 0, 0, 0);
    linux_buffer_free(&message); linux_buffer_free(&control); linux_buffer_free(&iovec);
    return sent;
}

fn main() i32 {
    let failures: i32 = 0;

    let exact_capacity: LinuxByteBuffer = linux_buffer_new(2);
    linux_buffer_set_byte(&exact_capacity, 0, 97);
    linux_buffer_set_byte(&exact_capacity, 1, 98);
    linux_buffer_set_byte(&exact_capacity, 2, 120);
    failures = failures + receive_fd_expect(exact_capacity.capacity_bytes == 2
        && exact_capacity.len == 2 && linux_buffer_byte(&exact_capacity, 0) == 97
        && linux_buffer_byte(&exact_capacity, 1) == 98,
        "packed storage preserves the caller's exact logical byte capacity");
    linux_buffer_free(&exact_capacity);

    let write_pair: LinuxFdPair = linux_socketpair_stream();
    failures = failures + receive_fd_expect(write_pair.ok == 1,
        "exact-write socketpair");
    if (write_pair.ok == 1) {
        let outgoing: LinuxByteBuffer = linux_buffer_new(11);
        linux_buffer_set_byte(&outgoing, 0, 102); linux_buffer_set_byte(&outgoing, 1, 108);
        linux_buffer_set_byte(&outgoing, 2, 97); linux_buffer_set_byte(&outgoing, 3, 115);
        linux_buffer_set_byte(&outgoing, 4, 104); linux_buffer_set_byte(&outgoing, 5, 45);
        linux_buffer_set_byte(&outgoing, 6, 119); linux_buffer_set_byte(&outgoing, 7, 114);
        linux_buffer_set_byte(&outgoing, 8, 105); linux_buffer_set_byte(&outgoing, 9, 116);
        linux_buffer_set_byte(&outgoing, 10, 101);
        let written: LinuxWriteAllResult = linux_write_buffer_all_chunked(
            write_pair.first, &outgoing, 3);
        let incoming: LinuxByteBuffer = linux_buffer_new(11);
        let got: i64 = receive_fd_read_after(written.complete == 1
            && written.written == 11, write_pair.second, &incoming);
        failures = failures + receive_fd_expect(written.complete == 1
            && written.written == 11 && written.error_code == 0 && got == 11
            && linux_buffer_byte(&incoming, 0) == 102
            && linux_buffer_byte(&incoming, 5) == 45
            && linux_buffer_byte(&incoming, 10) == 101,
            "exact write retains progress and offsets across bounded chunks");
        let socket_written: LinuxWriteAllResult = linux_send_buffer_all_chunked(
            write_pair.first, &outgoing, 3);
        let socket_incoming: LinuxByteBuffer = linux_buffer_new(11);
        let socket_got: i64 = receive_fd_read_after(
            socket_written.complete == 1 && socket_written.written == 11,
            write_pair.second, &socket_incoming);
        failures = failures + receive_fd_expect(socket_written.complete == 1
            && socket_written.written == 11 && socket_written.error_code == 0
            && socket_got == 11 && linux_buffer_byte(&socket_incoming, 0) == 102
            && linux_buffer_byte(&socket_incoming, 10) == 101,
            "bounded nonblocking socket send completes exact chunked payloads");
        let aliased_fd: i64 = write_pair.first + 4294967296;
        let aliased_write: LinuxWriteAllResult = linux_write_buffer_all(
            aliased_fd, &outgoing);
        failures = failures + receive_fd_expect(linux_close(aliased_fd) == (0 - 9)
            && linux_fd_flags(aliased_fd) == (0 - 9)
            && linux_write_buffer(aliased_fd, &outgoing) == (0 - 9)
            && aliased_write.complete == 0 && aliased_write.written == 0
            && aliased_write.error_code == (0 - 22)
            && linux_fd_flags(write_pair.first) >= 0,
            "out-of-range descriptor carriers cannot alias or close a live kernel FD");
        let timed: LinuxWriteAllResult = linux_send_buffer_all_timeout_chunked(
            write_pair.first, &outgoing, 1, 0);
        let timed_incoming: LinuxByteBuffer = linux_buffer_new(1);
        let timed_got: i64 = receive_fd_read_after(timed.written == 1,
            write_pair.second, &timed_incoming);
        failures = failures + receive_fd_expect(timed.complete == 0
            && timed.written == 1 && timed.error_code == (0 - 110)
            && timed_got == 1 && linux_buffer_byte(&timed_incoming, 0) == 102,
            "positive send progress cannot extend work beyond a zero deadline");
        let invalid: LinuxByteBuffer = linux_buffer_new(1);
        invalid.len = invalid.capacity_bytes + 1;
        let rejected: LinuxWriteAllResult = linux_write_buffer_all(
            write_pair.first, &invalid);
        failures = failures + receive_fd_expect(rejected.complete == 0
            && rejected.written == 0 && rejected.error_code == (0 - 22),
            "exact write rejects an invalid packed-buffer extent before syscall");
        linux_buffer_free(&timed_incoming); linux_buffer_free(&socket_incoming);
        linux_buffer_free(&invalid);
        linux_buffer_free(&incoming); linux_buffer_free(&outgoing);
        let _close_write_first: i64 = linux_close(write_pair.first);
        let _close_write_second: i64 = linux_close(write_pair.second);
    }

    let closed_send_pair: LinuxFdPair = linux_socketpair_stream();
    failures = failures + receive_fd_expect(closed_send_pair.ok == 1,
        "no-SIGPIPE socketpair");
    if (closed_send_pair.ok == 1) {
        let outgoing: LinuxByteBuffer = linux_buffer_new(1);
        linux_buffer_set_byte(&outgoing, 0, 120);
        let _close_send_peer: i64 = linux_close(closed_send_pair.second);
        let rejected: LinuxWriteAllResult = linux_send_buffer_all(
            closed_send_pair.first, &outgoing);
        failures = failures + receive_fd_expect(rejected.complete == 0
            && rejected.written == 0 && rejected.error_code == (0 - 32),
            "socket exact send reports EPIPE without terminating the process");
        linux_buffer_free(&outgoing);
        let _close_send_first: i64 = linux_close(closed_send_pair.first);
    }

    let stalled_pair: LinuxFdPair = linux_socketpair_stream();
    failures = failures + receive_fd_expect(stalled_pair.ok == 1,
        "bounded stalled-send socketpair");
    if (stalled_pair.ok == 1) {
        let outgoing: LinuxByteBuffer = linux_buffer_new(1048576);
        outgoing.len = outgoing.capacity_bytes;
        let stalled: LinuxWriteAllResult = linux_send_buffer_all_timeout(
            stalled_pair.first, &outgoing, 0);
        failures = failures + receive_fd_expect(stalled.complete == 0
            && stalled.written >= 0 && stalled.written < outgoing.len as i64
            && stalled.error_code == (0 - 110),
            "non-reading socket peer returns a bounded timeout with exact progress");
        linux_buffer_free(&outgoing);
        let _close_stalled_first: i64 = linux_close(stalled_pair.first);
        let _close_stalled_second: i64 = linux_close(stalled_pair.second);
    }

    let split_memory: LinuxSharedMemory = linux_shared_memory_create(1);
    let split_pair: LinuxFdPair = linux_socketpair_stream();
    failures = failures + receive_fd_expect(split_memory.valid == 1
        && split_pair.ok == 1, "split exact-FD fixture resources");
    if (split_memory.valid == 1 && split_pair.ok == 1) {
        let outgoing: LinuxByteBuffer = linux_buffer_new(5);
        linux_buffer_set_byte(&outgoing, 0, 102); linux_buffer_set_byte(&outgoing, 1, 114);
        linux_buffer_set_byte(&outgoing, 2, 97); linux_buffer_set_byte(&outgoing, 3, 109);
        linux_buffer_set_byte(&outgoing, 4, 101);
        let sent: LinuxWriteAllResult = linux_send_buffer_fd_all_chunked(
            split_pair.first, &outgoing, split_memory.fd, 1);
        let first: LinuxReceiveFdResult = receive_fd_one_after(
            sent.complete == 1 && sent.written == 5, split_pair.second, 1);
        let tail: LinuxByteBuffer = linux_buffer_new(4);
        let tail_got: i64 = receive_fd_read_after(first.ok == 1,
            split_pair.second, &tail);
        failures = failures + receive_fd_expect(sent.complete == 1 && sent.written == 5
            && sent.error_code == 0 && first.ok == 1 && first.has_fd == 1
            && first.fd_count == 1 && linux_buffer_byte(&first.data, 0) == 102
            && tail_got == 4 && linux_buffer_byte(&tail, 0) == 114
            && linux_buffer_byte(&tail, 3) == 101,
            "partial descriptor send attaches authority once and completes with ordinary writes");
        let rejected_fd: LinuxWriteAllResult = linux_send_buffer_fd_all(
            split_pair.first, &outgoing, 4294967296);
        failures = failures + receive_fd_expect(rejected_fd.complete == 0
            && rejected_fd.written == 0 && rejected_fd.error_code == (0 - 22),
            "SCM_RIGHTS rejects descriptors outside the signed kernel FD range");
        if (first.received_fd >= 0) { let _close_split_received: i64 = linux_close(first.received_fd); }
        linux_buffer_free(&tail); linux_buffer_free(&first.data); linux_buffer_free(&outgoing);
    }
    if (split_pair.ok == 1) {
        let _close_split_first: i64 = linux_close(split_pair.first);
        let _close_split_second: i64 = linux_close(split_pair.second);
    }
    if (split_memory.valid == 1) { linux_shared_memory_free(&split_memory); }

    let closed_fd_memory: LinuxSharedMemory = linux_shared_memory_create(1);
    let closed_fd_pair: LinuxFdPair = linux_socketpair_stream();
    failures = failures + receive_fd_expect(closed_fd_memory.valid == 1
        && closed_fd_pair.ok == 1, "no-SIGPIPE descriptor fixture resources");
    if (closed_fd_memory.valid == 1 && closed_fd_pair.ok == 1) {
        let outgoing: LinuxByteBuffer = linux_buffer_new(1);
        linux_buffer_set_byte(&outgoing, 0, 102);
        let _close_fd_peer: i64 = linux_close(closed_fd_pair.second);
        let rejected: LinuxWriteAllResult = linux_send_buffer_fd_all(
            closed_fd_pair.first, &outgoing, closed_fd_memory.fd);
        failures = failures + receive_fd_expect(rejected.complete == 0
            && rejected.written == 0 && rejected.error_code == (0 - 32),
            "descriptor send reports EPIPE without SIGPIPE termination");
        linux_buffer_free(&outgoing);
        let _close_fd_first: i64 = linux_close(closed_fd_pair.first);
    }
    if (closed_fd_memory.valid == 1) { linux_shared_memory_free(&closed_fd_memory); }

    let data_pair: LinuxFdPair = linux_socketpair_stream();
    failures = failures + receive_fd_expect(data_pair.ok == 1, "data-only socketpair");
    if (data_pair.ok == 1) {
        let outgoing: LinuxByteBuffer = linux_buffer_new(1);
        linux_buffer_set_byte(&outgoing, 0, 100);
        let sent: i64 = linux_write_buffer(data_pair.first, &outgoing);
        let received: LinuxReceiveFdResult = receive_fd_one_after(sent == 1,
            data_pair.second, 1);
        failures = failures + receive_fd_expect(sent == 1 && received.ok == 1
            && received.payload_received == 1 && received.has_fd == 0
            && received.received_fd < 0 && received.fd_count == 0
            && received.message_truncated == 0 && received.control_truncated == 0
            && received.control_invalid == 0 && linux_buffer_byte(&received.data, 0) == 100,
            "data-only recvmsg is successful without inventing an FD");
        linux_buffer_free(&received.data); linux_buffer_free(&outgoing);
        let _close_data_first: i64 = linux_close(data_pair.first);
        let _close_data_second: i64 = linux_close(data_pair.second);
    }

    let invalid: LinuxReceiveFdResult = linux_receive_buffer_fd(0 - 1,
        linux_receive_fd_max_payload() + 1);
    failures = failures + receive_fd_expect(invalid.ok == 0 && invalid.payload_received == 0
        && invalid.has_fd == 0 && invalid.error_code == (0 - 22),
        "invalid and oversized receives fail before allocating or reading");
    linux_buffer_free(&invalid.data);

    let one_memory: LinuxSharedMemory = linux_shared_memory_create(9);
    let one_pair: LinuxFdPair = linux_socketpair_stream();
    failures = failures + receive_fd_expect(one_memory.valid == 1 && one_pair.ok == 1,
        "single-FD fixture resources");
    if (one_memory.valid == 1 && one_pair.ok == 1) {
        let outgoing: LinuxByteBuffer = linux_buffer_new(1);
        linux_buffer_set_byte(&outgoing, 0, 102);
        let sent: i64 = linux_send_buffer_fd(one_pair.first, &outgoing, one_memory.fd);
        let received: LinuxReceiveFdResult = receive_fd_one_after(sent == 1,
            one_pair.second, 1);
        let received_flags: i64 = linux_fd_flags(received.received_fd);
        failures = failures + receive_fd_expect(sent == 1 && received.ok == 1
            && received.payload_received == 1 && received.has_fd == 1
            && received.fd_count == 1 && received.excess_fd_count == 0
            && received.closed_fd_count == 0 && received.cloexec_applied == 1
            && received_flags >= 0 && (received_flags % 2) == 1,
            "one SCM_RIGHTS descriptor is retained with close-on-exec");
        if (received.received_fd >= 0) { let _close_received: i64 = linux_close(received.received_fd); }
        linux_buffer_free(&received.data); linux_buffer_free(&outgoing);
    }
    if (one_pair.ok == 1) {
        let _close_one_first: i64 = linux_close(one_pair.first);
        let _close_one_second: i64 = linux_close(one_pair.second);
    }
    if (one_memory.valid == 1) { linux_shared_memory_free(&one_memory); }

    let mapping_memory: LinuxSharedMemory = linux_shared_memory_create(5);
    let mapping_pair: LinuxFdPair = linux_socketpair_stream();
    failures = failures + receive_fd_expect(mapping_memory.valid == 1
        && mapping_pair.ok == 1, "read-only mapping fixture resources");
    if (mapping_memory.valid == 1 && mapping_pair.ok == 1) {
        linux_shared_memory_set_byte(&mapping_memory, 0, 97);
        linux_shared_memory_set_byte(&mapping_memory, 1, 98);
        linux_shared_memory_set_byte(&mapping_memory, 2, 99);
        linux_shared_memory_set_byte(&mapping_memory, 3, 100);
        linux_shared_memory_set_byte(&mapping_memory, 4, 101);
        let outgoing: LinuxByteBuffer = linux_buffer_new(1);
        linux_buffer_set_byte(&outgoing, 0, 109);
        let sent: i64 = linux_send_buffer_fd(mapping_pair.first, &outgoing,
            mapping_memory.fd);
        let received: LinuxReceiveFdResult = receive_fd_one_after(sent == 1,
            mapping_pair.second, 1);
        let cursor: LinuxByteBuffer = linux_buffer_new(2);
        cursor.capacity_bytes = 2;
        let advanced: i64 = receive_fd_read_after(received.ok == 1
            && received.has_fd == 1, received.received_fd, &cursor);
        let mapped_fd: i64 = received.received_fd;
        let mapping: LinuxReadOnlyMapping = linux_readonly_map_fd_take(
            mapped_fd, 5, 5);
        failures = failures + receive_fd_expect(sent == 1 && received.ok == 1
            && received.has_fd == 1 && advanced == 2
            && linux_buffer_byte(&cursor, 0) == 97
            && linux_buffer_byte(&cursor, 1) == 98
            && mapping.valid == 1 && mapping.len == 5
            && linux_readonly_mapping_byte(&mapping, 0) == 97
            && linux_readonly_mapping_byte(&mapping, 2) == 99
            && linux_readonly_mapping_byte(&mapping, 4) == 101,
            "read-only mmap starts at offset zero despite a shared advanced FD cursor");
        let mapping_freed: i32 = linux_readonly_mapping_free(&mapping);
        failures = failures + receive_fd_expect(mapping_freed == 1
            && mapping.valid == 0 && mapping.fd < 0
            && linux_fd_flags(mapped_fd) == (0 - 9),
            "read-only mapping releases its map and owned descriptor exactly once");

        let short_sent: i64 = linux_send_buffer_fd(mapping_pair.first, &outgoing,
            mapping_memory.fd);
        let short_received: LinuxReceiveFdResult = receive_fd_one_after(
            short_sent == 1, mapping_pair.second, 1);
        let short_fd: i64 = short_received.received_fd;
        let short_mapping: LinuxReadOnlyMapping = linux_readonly_map_fd_take(
            short_fd, 7, 7);
        failures = failures + receive_fd_expect(short_sent == 1
            && short_received.ok == 1 && short_mapping.valid == 0
            && short_mapping.error_code == (0 - 22) && short_mapping.fd < 0
            && linux_fd_flags(short_fd) == (0 - 9),
            "same-page advertised length beyond st_size is rejected before mmap");

        let large_sent: i64 = linux_send_buffer_fd(mapping_pair.first, &outgoing,
            mapping_memory.fd);
        let large_received: LinuxReceiveFdResult = receive_fd_one_after(
            large_sent == 1, mapping_pair.second, 1);
        let large_fd: i64 = large_received.received_fd;
        let large_mapping: LinuxReadOnlyMapping = linux_readonly_map_fd_take(
            large_fd, 8192, 8192);
        failures = failures + receive_fd_expect(large_sent == 1
            && large_received.ok == 1 && large_mapping.valid == 0
            && large_mapping.error_code == (0 - 22) && large_mapping.fd < 0
            && linux_fd_flags(large_fd) == (0 - 9),
            "multi-page advertised length beyond st_size is rejected before SIGBUS is possible");

        linux_buffer_free(&large_received.data);
        linux_buffer_free(&short_received.data);
        linux_buffer_free(&cursor); linux_buffer_free(&received.data);
        linux_buffer_free(&outgoing);
    }
    if (mapping_pair.ok == 1) {
        let _close_mapping_first: i64 = linux_close(mapping_pair.first);
        let _close_mapping_second: i64 = linux_close(mapping_pair.second);
    }
    if (mapping_memory.valid == 1) { linux_shared_memory_free(&mapping_memory); }

    let nonmap_pair: LinuxFdPair = linux_socketpair_stream();
    failures = failures + receive_fd_expect(nonmap_pair.ok == 1,
        "non-mappable descriptor fixture");
    if (nonmap_pair.ok == 1) {
        let nonmap_fd: i64 = nonmap_pair.first;
        let rejected: LinuxReadOnlyMapping = linux_readonly_map_fd_take(
            nonmap_fd, 1, 1);
        failures = failures + receive_fd_expect(rejected.valid == 0
            && rejected.fd < 0 && rejected.error_code < 0
            && linux_fd_flags(nonmap_fd) == (0 - 9),
            "read-only mmap rejects a socket promptly and closes the taken descriptor");
        let _close_nonmap_second: i64 = linux_close(nonmap_pair.second);
    }

    let excess_first: LinuxSharedMemory = linux_shared_memory_create(3);
    let excess_second: LinuxSharedMemory = linux_shared_memory_create(3);
    let excess_pair: LinuxFdPair = linux_socketpair_stream();
    failures = failures + receive_fd_expect(excess_first.valid == 1 && excess_second.valid == 1
        && excess_pair.ok == 1, "excess-FD fixture resources");
    if (excess_first.valid == 1 && excess_second.valid == 1 && excess_pair.ok == 1) {
        let outgoing: LinuxByteBuffer = linux_buffer_new(1);
        linux_buffer_set_byte(&outgoing, 0, 101);
        let fds: ArrayList[i64] = make[i64](2);
        push[i64](&fds, excess_first.fd); push[i64](&fds, excess_second.fd);
        let sent: i64 = receive_fd_send_many(excess_pair.first, &outgoing, &fds);
        let received: LinuxReceiveFdResult = receive_fd_one_after(sent == 1,
            excess_pair.second, 1);
        let closed_flags: i64 = linux_fd_flags(received.last_closed_fd);
        failures = failures + receive_fd_expect(sent == 1 && received.ok == 1
            && received.has_fd == 1 && received.fd_count == 2
            && received.excess_fd_count == 1 && received.closed_fd_count == 1
            && received.last_closed_fd >= 0 && closed_flags == (0 - 9),
            "excess SCM_RIGHTS descriptors are closed before return");
        if (received.received_fd >= 0) { let _close_retained: i64 = linux_close(received.received_fd); }
        free[i64](&fds); linux_buffer_free(&received.data); linux_buffer_free(&outgoing);
    }
    if (excess_pair.ok == 1) {
        let _close_excess_first: i64 = linux_close(excess_pair.first);
        let _close_excess_second: i64 = linux_close(excess_pair.second);
    }
    if (excess_first.valid == 1) { linux_shared_memory_free(&excess_first); }
    if (excess_second.valid == 1) { linux_shared_memory_free(&excess_second); }

    let trunc_first: LinuxSharedMemory = linux_shared_memory_create(3);
    let trunc_second: LinuxSharedMemory = linux_shared_memory_create(3);
    let trunc_third: LinuxSharedMemory = linux_shared_memory_create(3);
    let trunc_pair: LinuxFdPair = linux_socketpair_stream();
    failures = failures + receive_fd_expect(trunc_first.valid == 1 && trunc_second.valid == 1
        && trunc_third.valid == 1 && trunc_pair.ok == 1, "truncated-control fixture resources");
